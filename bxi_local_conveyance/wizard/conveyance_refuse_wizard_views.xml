<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bxi_conveyance_refuse_wizard_form" model="ir.ui.view">
        <field name="name">bxi.conveyance.refuse.wizard.form</field>
        <field name="model">bxi.conveyance.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Conveyance Claim">
                <field name="expense_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Which rule of the Local Conveyance Policy is not met?"/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
