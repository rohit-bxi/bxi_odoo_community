<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Claim categories of the Local Conveyance Policy. Personal vehicles are reimbursed per km at
         the cost of the category (Table A rates, the same for every travel plan). -->
    <record id="product_conveyance_2w" model="product.product">
        <field name="name">Local Conveyance - Personal Two-Wheeler (per km)</field>
        <field name="description">Own two-wheeler used for official travel within the city, reimbursed per km (Table A).</field>
        <field name="standard_price">2.50</field>
        <field name="type">service</field>
        <field name="default_code">LC-2W</field>
        <field name="can_be_expensed" eval="True"/>
        <field name="conveyance_kind">vehicle_2w</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="categ_id" eval="ref('product.product_category_expenses', raise_if_not_found=False)"/>
    </record>

    <record id="product_conveyance_4w" model="product.product">
        <field name="name">Local Conveyance - Personal Four-Wheeler (per km)</field>
