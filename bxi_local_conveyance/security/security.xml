<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_conveyance">
        <field name="name">Local Conveyance</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Employees claim and Reporting Managers approve their team's claims: neither needs a dedicated group. -->
    <record id="group_conveyance_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_conveyance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_conveyance_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_conveyance"/>
        <field name="implied_ids" eval="[(4, ref('group_conveyance_hr'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Claims ────────────────────────────────────────────────────── -->
    <record id="hr_expense_rule_conveyance_approver" model="ir.rule">
        <field name="name">Conveyance: claims to approve</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">[('conveyance_approval_line_ids.approver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_expense_rule_conveyance_hr" model="ir.rule">
        <field name="name">Conveyance: all claims</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">[('conveyance_kind', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_conveyance_hr'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bxi_conveyance_approval_line_rule_own" model="ir.rule">
        <field name="name">Conveyance approval: own claims or to approve</field>
        <field name="model_id" ref="model_bxi_conveyance_approval_line"/>
        <field name="domain_force">['|', '|',
            ('expense_id.employee_id.user_id', '=', user.id),
            ('expense_id.employee_id.parent_id.user_id', '=', user.id),
            ('expense_id.conveyance_approval_line_ids.approver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_conveyance_approval_line_rule_all" model="ir.rule">
        <field name="name">Conveyance approval: all</field>
        <field name="model_id" ref="model_bxi_conveyance_approval_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_conveyance_hr')), (4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <!-- ── Domestic transfers ────────────────────────────────────────── -->
    <record id="bxi_conveyance_transfer_rule_own" model="ir.rule">
        <field name="name">Domestic transfer: own or of the team</field>
        <field name="model_id" ref="model_bxi_conveyance_transfer"/>
        <field name="domain_force">['|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_conveyance_transfer_rule_all" model="ir.rule">
        <field name="name">Domestic transfer: all</field>
        <field name="model_id" ref="model_bxi_conveyance_transfer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_conveyance_hr'))]"/>
    </record>

    <!-- ── Multi-company ─────────────────────────────────────────────── -->
    <record id="bxi_conveyance_office_assignment_comp_rule" model="ir.rule">
        <field name="name">Conveyance office assignment: multi-company</field>
        <field name="model_id" ref="model_bxi_conveyance_office_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_conveyance_transfer_comp_rule" model="ir.rule">
        <field name="name">Domestic transfer: multi-company</field>
        <field name="model_id" ref="model_bxi_conveyance_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
