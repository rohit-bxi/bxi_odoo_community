<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Sequence for Asset Reference -->
        <record id="sequence_asset_management" model="ir.sequence">
            <field name="name">Asset Management</field>
            <field name="code">asset.management</field>
            <field name="prefix">ASSET/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Asset Transfer -->
        <record id="sequence_asset_transfer" model="ir.sequence">
            <field name="name">Asset Transfer Entry</field>
            <field name="code">asset.transfer.entry</field>
            <field name="prefix">TRF/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Automated Depreciation Cron -->
        <record id="cron_generate_asset_depreciation" model="ir.cron">
            <field name="name">Asset Management: Generate Depreciation Entries</field>
            <field name="model_id" ref="model_asset_management"/>
            <field name="state">code</field>
            <field name="code">model.generate_depreciation_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
