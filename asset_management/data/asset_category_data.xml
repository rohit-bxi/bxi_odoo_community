<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════════════
         ASSET CATEGORIES
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="category_equity_funding" model="asset.category">
        <field name="name">Equity Funding</field>
        <field name="sequence">10</field>
        <field name="description">Equity financing sources including share capital, founder capital, and investor funding.</field>
    </record>

    <record id="category_debt_funding" model="asset.category">
        <field name="name">Debt Funding</field>
        <field name="sequence">20</field>
        <field name="description">Debt financing including bank loans, corporate loans, borrowings, and bonds/sukuk.</field>
    </record>

    <record id="category_banking_facilities" model="asset.category">
        <field name="name">Banking Facilities</field>
        <field name="sequence">30</field>
        <field name="description">Short-term and trade facilities provided by banks (OD, CC, LC, BG, Trade Finance).</field>
    </record>

    <record id="category_grants_contributions" model="asset.category">
        <field name="name">Grants &amp; Contributions</field>
        <field name="sequence">40</field>
        <field name="description">Non-repayable funding from grants, donations, endowments, foundations, and CSR initiatives.</field>
    </record>

