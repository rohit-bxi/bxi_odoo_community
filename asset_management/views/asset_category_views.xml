<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ASSET CATEGORY VIEWS
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- List View for Asset Category -->
    <record id="view_asset_category_tree" model="ir.ui.view">
        <field name="name">asset.category.tree</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="sequence" widget="handle"/>
                <field name="sequence" string="Sequence"/>
                <field name="name"/>
                <field name="asset_type_count" string="Asset Types"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View for Asset Category -->
    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">asset.category.form</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_asset_types"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bars">
                            <field name="asset_type_count" widget="statinfo" string="Asset Types"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Category Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Equity Funding, Debt Funding, Banking Facilities..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Status">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Description or guidance for this asset category..."/>
                    </group>
                    <notebook>
                        <page string="Asset Types" name="asset_types">
                            <field name="asset_type_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="depreciation_frequency"/>
                                    <field name="depreciation_method"/>
                                    <field name="depreciation_rate"/>
                                    <field name="fixed_asset_account_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Asset Category -->
    <record id="view_asset_category_search" model="ir.ui.view">
        <field name="name">asset.category.search</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action for Asset Category -->
    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Asset Category
            </p>
            <p>
                Define asset categories (such as Equity Funding, Debt Funding, Banking Facilities, Grants &amp; Contributions)
                to group and organize asset types.
            </p>
        </field>
    </record>

    <!-- Menu Item under Configuration (before Asset Types) -->
    <menuitem id="asset_category_menu"
              name="Asset Category"
              parent="asset_configuration"
              action="action_asset_category"
              groups="assets_admin_group,base.group_system"
              sequence="5"/>

</odoo>

