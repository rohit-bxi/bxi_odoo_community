<odoo>
    <template id="portal_my_payslips" name="My Payslips">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3 class="mb-3">My Payslips</h3>

                <t t-if="payslips">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Net Salary</th>
                                <th>Status</th>
                                <th class="text-end">Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="payslips" t-as="slip">
                                <tr>
                                    <td>
                                        <t t-esc="slip.date_from"/> →
                                        <t t-esc="slip.date_to"/>
                                    </td>
                                    <td>
                                        <t t-esc="slip.net_wage"/>
                                    </td>
                                    <td>
                                        <span class="badge bg-success"
                                              t-if="slip.state == 'done'">
                                            Done
                                        </span>
                                        <span class="badge bg-secondary"
                                              t-if="slip.state != 'done'">
                                            Draft
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a t-att-href="'/my/payslip/%s/download' % slip.id"
                                           class="btn btn-sm btn-primary">
                                            Download PDF
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-else="">
                    <div class="alert alert-info">
                        No payslips available.
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>