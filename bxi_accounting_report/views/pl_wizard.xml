<odoo>

    <record id="view_pl_report_wizard" model="ir.ui.view">
        <field name="name">pl.report.wizard.form</field>
        <field name="model">pl.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Filters">
                <group>
                    <field name="financial_year"/>
                    <field name="quarters"/>
                    <field name="company_ids" widget="many2many_tags"/>
                    <field name="currency_id"/>
                </group>
                <footer>
                    <button name="action_open_dashboard"
                            type="object"
                            string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pl_report_wizard" model="ir.actions.act_window">
        <field name="name">P&amp;L Report</field>
        <field name="res_model">pl.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_custom_pl_report"
              name="BXI P&amp;L Report"
              parent="account.account_reports_legal_statements_menu"
              action="bxi_accounting_report.action_pl_report_wizard"
              sequence="10"/>
</odoo>