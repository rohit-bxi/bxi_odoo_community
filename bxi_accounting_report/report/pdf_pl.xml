<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- REPORT TEMPLATE -->
    <template id="pl_report_pdf_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>P&amp;L Report</h2>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Project</th>
                                <th>Customer</th>
                                <th>Value</th>
                                <th>Revenue</th>
                                <th>Expense</th>
                                <th>GP</th>
                                <th>GM</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs.line_ids" t-as="l">
                                <tr>
                                    <td><t t-esc="l.employee_id.name"/></td>
                                    <td><t t-esc="l.project_id.name"/></td>
                                    <td><t t-esc="l.partner_id.name"/></td>
                                    <td><t t-esc="l.value"/></td>
                                    <td><t t-esc="l.revenue_actual"/></td>
                                    <td><t t-esc="l.expense_actual"/></td>
                                    <td><t t-esc="l.gp"/></td>
                                    <td><t t-esc="l.gm"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- REPORT ACTION -->
    <record id="pl_report_pdf_action" model="ir.actions.report">
        <field name="name">P&amp;L Report</field>
        <field name="model">custom.pl.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bxi_accounting_report.pl_report_pdf_template</field>
        <field name="report_file">bxi_accounting_report.pl_report_pdf_template</field>
    </record>

</odoo>