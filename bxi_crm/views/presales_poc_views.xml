<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list View -->
    <record id="view_presales_poc_list" model="ir.ui.view">
        <field name="name">presales.poc.list</field>
        <field name="model">presales.poc</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_presales_poc_form" model="ir.ui.view">
        <field name="name">presales.poc.form</field>
        <field name="model">presales.poc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_presales_poc" model="ir.actions.act_window">
        <field name="name">Presales POCs</field>
        <field name="res_model">presales.poc</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu under CRM Configuration -->
    <menuitem
        id="menu_presales_poc"
        name="Presales POCs"
        parent="crm.crm_menu_config"
        action="action_presales_poc"
        sequence="100"
    />

</odoo>