<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_inherit_employee_code" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.code</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="employee_code" />
                <field name="pa_name" />
                <field name="psa" />
                <field name="role_band" />
                <field name="disp" />
                <field name="aadhar_card" />
                <field name="probation_period" />
                <field name="trainee_category" />
                <field name="onsite_offshore" />
                <field name="emp_category" />
                <field name="emp_skill_category" />
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <label for="nps_contribution" />
                <div class="o_row">
                    <field name="nps_contribution" class="oe_inline" />
                    <span class="text-muted">/ month</span>
                </div>
                <button name="action_calculate_l10n_in_tds_new_regime"
                    type="object"
                    string="Calculate TDS"
                    class="btn btn-primary"
                    style="margin-left:10px;" />
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="manager_emp_code" />
            </xpath>
            <xpath expr="//field[@name='bank_account_ids']" position="after">
                <field name="medical_insurance_no" />
                <field name="bank_name" />
                <field name="bank_ifsc" />
                <field name="bank_account_number" />
                <field name="bank_document" />
            </xpath>

            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Payroll &amp; Statutory Info" name="payroll_statutory_info">
                    <group>
                        <group string="Statutory &amp; Government Identifiers">
                            <field name="l10n_in_pan"/>
                            <field name="l10n_in_uan"/>
                            <field name="epf_number"/>
                            <field name="l10n_in_esic_number"/>
                            <field name="emp_date_of_joining"/>
                        </group>
                        <group string="Standard Salary Breakdown (Monthly)">
                            <field name="l10n_in_basic_salary_amount"/>
                            <field name="l10n_in_hra"/>
                            <field name="l10n_in_fixed_allowance"/>
                            <field name="l10n_in_pf_employer_amount"/>
                            <field name="l10n_in_tds"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_employee_form_inherit_contract_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.contract.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Contract Payroll" invisible="employee_type != 'contractor'">
                    <group string="Contract Payment Details">
                        <group>
                            <field name="template_company_id"/>
                            <field name="month_year"/>
                            <field name="meeting_qty"/>
                            <field name="meeting_rate"/>
                            <field name="script_qty"/>
                            <field name="script_rate"/>
                            <field name="video_qty"/>
                            <field name="video_rate"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_download_contract_payslip"
                            string="Download Contract Payslip"
                            type="object"
                            class="btn-primary"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_employee_form_inherit_fnf" model="ir.ui.view">
        <field name="name">hr.employee.form.fnf</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <field name="active" invisible="1"/>
                <page string="Final Settlement" invisible="active">
                    <group>
                        <field name="is_fnf_done" string="Is FNF Done"/>
                        <field name="date_of_leaving" string="Date of Leaving"/>
                        <field name="re_hire" string="Re-Hire"/>
                        <field name="rehire_not_description" string="Rehire Remarks"/>
                    </group>
                    <group>
                    <button name="action_send_registration_link"
                            type="object"
                            string="Send Alumni Portal Access"
                            class="btn-primary"
                            style="margin-left:10px;"/>
                    </group>
                    <group string="Experience &amp; Relieving Letter">
                        <group>
                                <button name="action_generate_experience_letter"
                                string="Generate / Download Experience Letter"
                                type="object"
                                class="btn btn-primary"/>
                        </group>
                            <group>
                                <field name="signed_experience_letter"
                                string="Upload Signed Experience Letter"/>
                            </group>
                    </group>
                    <group string="Form 16 Document">
                            <field name="form_16"
                                filename="form_16_filename"
                                string="Form 16"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Restrict Contacts main app and all child menus to Show Hidden Menus group -->
    <menuitem id="contacts.menu_contacts" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.res_partner_menu_contacts" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.res_partner_menu_config" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_partner_category_form" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.res_partner_industry_menu" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_localisation" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_country_partner" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_country_group" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_country_state_partner" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_config_bank_accounts" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_action_res_bank_form" groups="bxi_hr_employee.group_show_hidden_menus"/>
    <menuitem id="contacts.menu_action_res_partner_bank_form" groups="bxi_hr_employee.group_show_hidden_menus"/>
</odoo>