<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Performance Review Period List -->
    <!-- ===================================================== -->
    <record id="view_performance_review_period_list" model="ir.ui.view">
        <field name="name">performance.review.period.list</field>
        <field name="model">performance.review.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Performance Review Period Form -->
    <!-- ===================================================== -->
    <record id="view_performance_review_period_form" model="ir.ui.view">
        <field name="name">performance.review.period.form</field>
        <field name="model">performance.review.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Performance Review Period Action -->
    <!-- ===================================================== -->
    <record id="action_performance_review_period" model="ir.actions.act_window">
        <field name="name">Review Periods</field>
        <field name="res_model">performance.review.period</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>