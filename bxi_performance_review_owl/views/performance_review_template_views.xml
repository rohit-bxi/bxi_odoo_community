<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Performance Review Template List -->
    <!-- ===================================================== -->
    <record id="view_performance_review_template_list" model="ir.ui.view">
        <field name="name">performance.review.template.list</field>
        <field name="model">performance.review.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Performance Review Template Form -->
    <!-- ===================================================== -->
    <record id="view_performance_review_template_form" model="ir.ui.view">
        <field name="name">performance.review.template.form</field>
        <field name="model">performance.review.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Performance Parameters">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category"/>
                                    <field name="weightage"/>
                                    <field name="target"/>
                                    <field name="description"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Performance Review Template Action -->
    <!-- ===================================================== -->
    <record id="action_performance_review_template" model="ir.actions.act_window">
        <field name="name">Review Templates</field>
        <field name="res_model">performance.review.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>