<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bxi_certification_refuse_wizard_form" model="ir.ui.view">
        <field name="name">bxi.certification.refuse.wizard.form</field>
        <field name="model">bxi.certification.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Explain why the request is refused"/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-danger"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
