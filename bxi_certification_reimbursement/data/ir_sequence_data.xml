<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_bxi_certification_request" model="ir.sequence">
        <field name="name">Certification Request</field>
        <field name="code">bxi.certification.request</field>
        <field name="prefix">CERT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_bxi_certification_inclusion" model="ir.sequence">
        <field name="name">Certification Inclusion Request</field>
        <field name="code">bxi.certification.inclusion</field>
        <field name="prefix">CERT-INC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_bxi_service_agreement" model="ir.sequence">
        <field name="name">Certification Service Agreement</field>
        <field name="code">bxi.service.agreement</field>
        <field name="prefix">CERT-SA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_bxi_certification_voucher" model="ir.sequence">
        <field name="name">Certification Voucher</field>
        <field name="code">bxi.certification.voucher</field>
        <field name="prefix">CERT-VOU/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
