<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_certification">
        <field name="name">Certification Reimbursement</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Every employee can raise requests; band heads approve through their
         approval lines, so no dedicated approver group is needed. -->
    <record id="group_certification_academy" model="res.groups">
        <field name="name">LoB Academy</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_certification"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_certification_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_certification"/>
        <field name="implied_ids" eval="[(4, ref('group_certification_academy'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Multi-company ─────────────────────────────────────────────── -->
    <record id="bxi_certification_comp_rule" model="ir.rule">
        <field name="name">Certification: multi-company</field>
        <field name="model_id" ref="model_bxi_certification"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_line_of_business_comp_rule" model="ir.rule">
        <field name="name">Line of Business: multi-company</field>
        <field name="model_id" ref="model_bxi_line_of_business"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_certification_request_comp_rule" model="ir.rule">
        <field name="name">Certification Request: multi-company</field>
        <field name="model_id" ref="model_bxi_certification_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_certification_inclusion_comp_rule" model="ir.rule">
        <field name="name">Certification Inclusion: multi-company</field>
        <field name="model_id" ref="model_bxi_certification_inclusion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_service_agreement_comp_rule" model="ir.rule">
        <field name="name">Service Agreement: multi-company</field>
        <field name="model_id" ref="model_bxi_service_agreement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_certification_voucher_comp_rule" model="ir.rule">
        <field name="name">Certification Voucher: multi-company</field>
        <field name="model_id" ref="model_bxi_certification_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ── Certification requests ────────────────────────────────────── -->
    <record id="bxi_certification_request_rule_user" model="ir.rule">
        <field name="name">Certification Request: own, managed or to approve</field>
        <field name="model_id" ref="model_bxi_certification_request"/>
        <field name="domain_force">[
            '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('manager_id.user_id', '=', user.id),
            ('approval_line_ids.approver_user_id', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_certification_request_rule_academy" model="ir.rule">
        <field name="name">Certification Request: academy of the LoB</field>
        <field name="model_id" ref="model_bxi_certification_request"/>
        <field name="domain_force">[
            '|',
            ('lob_id.academy_user_ids', 'in', user.id),
            ('lob_id.academy_head_id.user_id', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('group_certification_academy'))]"/>
    </record>

    <record id="bxi_certification_request_rule_manager" model="ir.rule">
        <field name="name">Certification Request: all</field>
        <field name="model_id" ref="model_bxi_certification_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certification_manager')), (4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <record id="bxi_certification_approval_line_rule_user" model="ir.rule">
        <field name="name">Certification Approval: of visible requests</field>
        <field name="model_id" ref="model_bxi_certification_approval_line"/>
        <field name="domain_force">[
            '|', '|',
            ('request_id.employee_id.user_id', '=', user.id),
            ('request_id.manager_id.user_id', '=', user.id),
            ('request_id.approval_line_ids.approver_user_id', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_certification_approval_line_rule_manager" model="ir.rule">
        <field name="name">Certification Approval: all</field>
        <field name="model_id" ref="model_bxi_certification_approval_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certification_academy')), (4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <!-- ── Inclusion requests ────────────────────────────────────────── -->
    <record id="bxi_certification_inclusion_rule_user" model="ir.rule">
        <field name="name">Certification Inclusion: own</field>
        <field name="model_id" ref="model_bxi_certification_inclusion"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_certification_inclusion_rule_academy" model="ir.rule">
        <field name="name">Certification Inclusion: all</field>
        <field name="model_id" ref="model_bxi_certification_inclusion"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certification_academy'))]"/>
    </record>

    <!-- ── Service agreements and vouchers ───────────────────────────── -->
    <record id="bxi_service_agreement_rule_user" model="ir.rule">
        <field name="name">Service Agreement: own</field>
        <field name="model_id" ref="model_bxi_service_agreement"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_service_agreement_rule_manager" model="ir.rule">
        <field name="name">Service Agreement: all</field>
        <field name="model_id" ref="model_bxi_service_agreement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certification_manager')), (4, ref('hr_expense.group_hr_expense_manager')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="bxi_certification_voucher_rule_user" model="ir.rule">
        <field name="name">Certification Voucher: own</field>
        <field name="model_id" ref="model_bxi_certification_voucher"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_certification_voucher_rule_academy" model="ir.rule">
        <field name="name">Certification Voucher: all</field>
        <field name="model_id" ref="model_bxi_certification_voucher"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certification_academy')), (4, ref('hr.group_hr_user'))]"/>
    </record>

</odoo>
