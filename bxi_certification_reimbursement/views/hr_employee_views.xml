<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_inherit_certification" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.certification</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="bxi_hr_employee.view_employee_form_inherit_employee_code"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role_band']" position="after">
                <field name="band_level" invisible="not is_band_set" groups="hr.group_hr_user"/>
                <field name="is_band_set" invisible="1" groups="hr.group_hr_user"/>
                <field name="lob_id" groups="hr.group_hr_user"/>
                <field name="cost_center_id" groups="hr.group_hr_user"/>
                <field name="is_india_payroll" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>

    <!-- ── Existing certificates (hr.employee "Any certificate(if any)") ── -->
    <record id="view_employee_existing_certificate_list" model="ir.ui.view">
        <field name="name">hr.employee.existing.certificate.list</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Existing Certificates" create="0" delete="0">
                <field name="employee_code" optional="show"/>
                <field name="name" string="Employee"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="parent_id" string="Manager" optional="hide"/>
                <field name="lob_id" optional="hide"/>
                <field name="role_band" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="any_certificate" string="Certificates" widget="many2many_binary" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_employee_existing_certificate_search" model="ir.ui.view">
        <field name="name">hr.employee.existing.certificate.search</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Existing Certificates">
                <field name="name" string="Employee"/>
                <field name="employee_code"/>
                <field name="work_email"/>
                <field name="any_certificate" string="Certificate"/>
                <field name="department_id" operator="child_of"/>
                <field name="job_id"/>
                <field name="parent_id" string="Manager"/>
                <field name="lob_id"/>
                <field name="role_band"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="my_team" string="My Team" domain="[('parent_id.user_id', '=', uid)]"/>
                <filter name="my_department" string="My Department" domain="[('department_id.member_ids.user_id', '=', uid)]"/>
                <separator/>
                <filter name="india_payroll" string="India Payroll" domain="[('is_india_payroll', '=', True)]"/>
                <filter name="no_lob" string="No Line of Business" domain="[('lob_id', '=', False)]"/>
                <separator/>
                <filter name="pdf_certificate" string="PDF Certificates" domain="[('any_certificate.mimetype', '=', 'application/pdf')]"/>
                <filter name="image_certificate" string="Image Certificates" domain="[('any_certificate.mimetype', '=like', 'image/%')]"/>
                <separator/>
                <filter name="uploaded_30_days" string="Uploaded in Last 30 Days"
                        domain="[('any_certificate.create_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="uploaded_this_year" string="Uploaded This Year"
                        domain="[('any_certificate.create_date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Job Position" context="{'group_by': 'job_id'}"/>
                    <filter name="group_manager" string="Manager" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_lob" string="Line of Business" context="{'group_by': 'lob_id'}"/>
                    <filter name="group_role_band" string="Role Band" context="{'group_by': 'role_band'}"/>
                    <filter name="group_employee_type" string="Employee Type" context="{'group_by': 'employee_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_existing_certificate" model="ir.actions.act_window">
        <field name="name">Existing Certificates</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('any_certificate', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_employee_existing_certificate_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_existing_certificate_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr.view_employee_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No existing certificates yet</p>
            <p>Certificates uploaded in the employee's "Any certificate(if any)" field are listed here, one row per employee.</p>
        </field>
    </record>

</odoo>
