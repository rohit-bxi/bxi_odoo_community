<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bxi_certification_inclusion_list" model="ir.ui.view">
        <field name="name">bxi.certification.inclusion.list</field>
        <field name="model">bxi.certification.inclusion</field>
        <field name="arch" type="xml">
            <list string="Inclusion Requests" decoration-danger="state == 'submitted' and deadline_date and deadline_date &lt; current_date">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="certification_name"/>
                <field name="certifying_body"/>
                <field name="lob_id"/>
                <field name="cost"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="deadline_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_certification_inclusion_form" model="ir.ui.view">
        <field name="name">bxi.certification.inclusion.form</field>
        <field name="model">bxi.certification.inclusion</field>
        <field name="arch" type="xml">
            <form string="Certification Inclusion Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Include in Approved List" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="bxi_certification_reimbursement.group_certification_academy"/>
                    <button name="action_reject" type="object" string="Do Not Include"
                            invisible="state != 'submitted'"
                            groups="bxi_certification_reimbursement.group_certification_academy"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Certification (Annexure B)">
                            <field name="certification_name" readonly="state != 'draft'"/>
                            <field name="version_exam_no" readonly="state != 'draft'"/>
                            <field name="certifying_body" readonly="state != 'draft'"/>
                            <field name="area" readonly="state != 'draft'"/>
                            <field name="cost" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="website" widget="url" readonly="state != 'draft'"/>
                            <field name="is_du_specific" readonly="state != 'draft'"/>
                        </group>
                        <group string="Request">
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="lob_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="submit_date"/>
                            <field name="deadline_date"/>
                            <field name="certification_id" invisible="not certification_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="information" readonly="state != 'draft'"/>
                        <field name="business_case" readonly="state != 'draft'"/>
                        <field name="response" readonly="state != 'submitted'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bxi_certification_inclusion_search" model="ir.ui.view">
        <field name="name">bxi.certification.inclusion.search</field>
        <field name="model">bxi.certification.inclusion</field>
        <field name="arch" type="xml">
            <search>
                <field name="certification_name"/>
                <field name="employee_id"/>
                <field name="lob_id"/>
                <filter name="submitted" string="To Review" domain="[('state', '=', 'submitted')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'submitted'), ('deadline_date', '&lt;', 'today')]"/>
                <group>
                    <filter name="group_lob" string="Line of Business" context="{'group_by': 'lob_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bxi_certification_inclusion" model="ir.actions.act_window">
        <field name="name">Inclusion Requests</field>
        <field name="res_model">bxi.certification.inclusion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request a certification to be added to the approved list</p>
            <p>Your LoB Academy will inform you within 10 working days.</p>
        </field>
    </record>

</odoo>
