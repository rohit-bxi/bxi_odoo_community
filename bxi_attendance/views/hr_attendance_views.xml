<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View to add Header, Stage Statusbar, and make Employee, Check In, Check Out readonly -->
    <record id="hr_attendance_view_form_inherit_geo" model="ir.ui.view">
        <field name="name">hr.attendance.view.form.inherit.geo</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/*[1]" position="before">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state == 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-secondary" invisible="state == 'rejected'"/>
                    <button name="action_set_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,level_1_late,level_2_late,approved,rejected"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_in']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="is_auto_checkout" readonly="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Approval Details" invisible="state == 'rejected' and not approved_by_id">
                    <group>
                        <field name="approved_by_id" readonly="1"/>
                        <field name="approved_emp_code" readonly="1"/>
                    </group>
                    <group>
                        <field name="approved_datetime" readonly="1"/>
                    </group>
                    <field name="approval_remark" placeholder="Enter approval remarks..." colspan="2"/>
                </group>
                <group string="Rejection Details" invisible="state == 'approved' and not rejected_by_id">
                    <group>
                        <field name="rejected_by_id" readonly="1"/>
                        <field name="rejected_emp_code" readonly="1"/>
                    </group>
                    <group>
                        <field name="rejected_datetime" readonly="1"/>
                    </group>
                    <field name="rejection_remark" placeholder="Enter rejection remarks..." colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit Tree / List View to add State badge and make Employee, Check In, Check Out readonly -->
    <record id="view_attendance_tree_inherit_geo" model="ir.ui.view">
        <field name="name">hr.attendance.view.tree.inherit.geo</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_in']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="is_auto_checkout" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('level_1_late', 'level_2_late')"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>

