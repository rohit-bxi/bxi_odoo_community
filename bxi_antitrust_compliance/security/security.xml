<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Legal & Compliance role is bxi_hr_policy.group_policy_cpo ("Compliance / CPO"). -->

    <!-- Queries and incidents are confidential: the employee and the CPO only. -->
    <record id="antitrust_query_rule_own" model="ir.rule">
        <field name="name">Compliance Query: own</field>
        <field name="model_id" ref="model_antitrust_query"/>
        <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="antitrust_query_rule_cpo" model="ir.rule">
        <field name="name">Compliance Query: CPO</field>
        <field name="model_id" ref="model_antitrust_query"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bxi_hr_policy.group_policy_cpo'))]"/>
    </record>

    <record id="antitrust_incident_rule_own" model="ir.rule">
        <field name="name">Antitrust Incident: own</field>
        <field name="model_id" ref="model_antitrust_incident"/>
        <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="antitrust_incident_rule_cpo" model="ir.rule">
        <field name="name">Antitrust Incident: CPO</field>
        <field name="model_id" ref="model_antitrust_incident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bxi_hr_policy.group_policy_cpo'))]"/>
    </record>

    <!-- Interactions: own, and managers can read their team's. -->
    <record id="antitrust_interaction_rule_own" model="ir.rule">
        <field name="name">Competitor Interaction: own</field>
        <field name="model_id" ref="model_antitrust_interaction"/>
        <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="antitrust_interaction_rule_team" model="ir.rule">
        <field name="name">Competitor Interaction: team (read)</field>
        <field name="model_id" ref="model_antitrust_interaction"/>
        <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="antitrust_interaction_rule_cpo" model="ir.rule">
        <field name="name">Competitor Interaction: CPO</field>
        <field name="model_id" ref="model_antitrust_interaction"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bxi_hr_policy.group_policy_cpo'))]"/>
    </record>

    <!-- Bid declarations: the bid owner and the opportunity's salesperson; sales managers read; CPO all. -->
    <record id="antitrust_bid_declaration_rule_own" model="ir.rule">
        <field name="name">Bid Declaration: own opportunities</field>
        <field name="model_id" ref="model_antitrust_bid_declaration"/>
        <field name="domain_force">['|', ('declared_by_id', '=', user.id), ('lead_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="antitrust_bid_declaration_rule_sale_manager" model="ir.rule">
        <field name="name">Bid Declaration: sales managers (read)</field>
        <field name="model_id" ref="model_antitrust_bid_declaration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="antitrust_bid_declaration_rule_cpo" model="ir.rule">
        <field name="name">Bid Declaration: CPO</field>
        <field name="model_id" ref="model_antitrust_bid_declaration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bxi_hr_policy.group_policy_cpo'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="antitrust_case_comp_rule" model="ir.rule">
        <field name="name">Compliance Case: multi-company</field>
        <field name="model_id" ref="model_antitrust_case"/>
        <field name="domain_force">['|', ('employee_ids', '=', False), ('employee_ids.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
