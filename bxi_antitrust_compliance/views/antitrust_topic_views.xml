<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_antitrust_topic_list" model="ir.ui.view">
        <field name="name">antitrust.topic.list</field>
        <field name="model">antitrust.topic</field>
        <field name="arch" type="xml">
            <list string="Prohibited Topics" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_antitrust_topic" model="ir.actions.act_window">
        <field name="name">Prohibited Topics</field>
        <field name="res_model">antitrust.topic</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
