<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_antitrust_incident_list" model="ir.ui.view">
        <field name="name">antitrust.incident.list</field>
        <field name="model">antitrust.incident</field>
        <field name="arch" type="xml">
            <list string="Meeting Incidents">
                <field name="name"/>
                <field name="incident_date"/>
                <field name="employee_id"/>
                <field name="meeting_title"/>
                <field name="meeting_type"/>
                <field name="outcome" optional="show"/>
                <field name="state" widget="badge" decoration-danger="state == 'reported'" decoration-info="state == 'under_review'"/>
            </list>
        </field>
    </record>

    <record id="view_antitrust_incident_form" model="ir.ui.view">
        <field name="name">antitrust.incident.form</field>
        <field name="model">antitrust.incident</field>
        <field name="arch" type="xml">
            <form string="Meeting Incident">
                <header>
                    <button name="action_report" type="object" string="Report to Compliance" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_review" type="object" string="Start Review"
                            invisible="state != 'reported'" groups="bxi_hr_policy.group_policy_cpo"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state not in ('reported', 'under_review')" groups="bxi_hr_policy.group_policy_cpo"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,under_review,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_case" type="object" class="oe_stat_button" icon="fa-gavel"
                                invisible="not case_id" groups="bxi_hr_policy.group_policy_cpo">
                            <span>Case</span>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'draft'">
                        If prohibited topics came up: state your reservation, leave the meeting if the discussion
                        continues, make sure your departure is recorded, and report it here immediately.
                    </div>
                    <group>
                        <group string="Meeting">
                            <field name="employee_id" readonly="1"/>
                            <field name="incident_date" readonly="state != 'draft'"/>
                            <field name="meeting_title" readonly="state != 'draft'"/>
                            <field name="meeting_type" readonly="state != 'draft'"/>
                            <field name="other_parties" readonly="state != 'draft'"/>
                            <field name="interaction_id" invisible="not interaction_id"/>
                        </group>
                        <group string="What you did">
                            <field name="reservation_stated" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="discussion_stopped" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="left_meeting" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="departure_recorded" widget="radio" options="{'horizontal': true}"
                                   invisible="left_meeting != 'yes'" readonly="state != 'draft'"/>
                            <field name="departure_record_note" invisible="departure_recorded != 'yes'" readonly="state != 'draft'"/>
                            <field name="explanation" invisible="discussion_stopped != 'no' or left_meeting != 'no'" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="topic_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                    </group>
                    <label for="description"/>
                    <field name="description" readonly="state != 'draft'"/>
                    <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                    <group string="Compliance Review" groups="bxi_hr_policy.group_policy_cpo" invisible="state == 'draft'">
                        <field name="outcome" readonly="state == 'closed'"/>
                        <field name="review_notes" readonly="state == 'closed'"/>
                        <field name="case_id" invisible="not case_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_antitrust_incident_search" model="ir.ui.view">
        <field name="name">antitrust.incident.search</field>
        <field name="model">antitrust.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="meeting_title"/>
                <field name="employee_id"/>
                <filter name="mine" string="My Reports" domain="[('employee_user_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('reported', 'under_review'))]"/>
            </search>
        </field>
    </record>

    <record id="action_antitrust_incident_mine" model="ir.actions.act_window">
        <field name="name">Report Incident</field>
        <field name="res_model">antitrust.incident</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_user_id', '=', uid)]</field>
    </record>

    <record id="action_antitrust_incident_all" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">antitrust.incident</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
