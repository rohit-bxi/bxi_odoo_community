<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_antitrust" model="ir.ui.view">
        <field name="name">hr.employee.form.antitrust</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_compliance_cases" type="object" class="oe_stat_button" icon="fa-gavel"
                        groups="bxi_hr_policy.group_policy_cpo" invisible="not compliance_case_count">
                    <field name="compliance_case_count" widget="statinfo" string="Compliance Cases"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
