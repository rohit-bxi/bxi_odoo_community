<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Privilege: Travel Management Dropdown (Non-debug mode)
    ═══════════════════════════════════════════════════════════════ -->
    <record model="res.groups.privilege" id="res_groups_privilege_travel_request">
        <field name="name">Travel Management</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ── Level 1: Base ─────────────────────────────────────────── -->
    <record id="group_travel_user" model="res.groups">
        <field name="name">Base</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_travel_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">The user can create and view their own travel requests.</field>
    </record>

    <!-- ── Level 2: Manager ──────────────────────────────────────── -->
    <record id="group_travel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_travel_request"/>
        <field name="implied_ids" eval="[(4, ref('bxi_travel_request.group_travel_user'))]"/>
        <field name="comment">The user can view, manage, and approve travel requests for their team.</field>
    </record>

    <!-- ── Level 3: Admin ────────────────────────────────────────── -->
    <record id="group_travel_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_travel_request"/>
        <field name="implied_ids" eval="[(4, ref('bxi_travel_request.group_travel_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative access to all travel requests and configurations.</field>
    </record>

</odoo>
