<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Record Rule: travel.request
         - Employee sees own requests
         - Manager sees own + direct reports
         - HR / Admin sees all
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Regular user: own requests + direct reports' requests -->
    <record id="travel_request_user_rule" model="ir.rule">
        <field name="name">Travel Request: User sees own and subordinates (company-scoped)</field>
        <field name="model_id" ref="model_travel_request"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- HR Officer: all records within allowed companies -->
    <record id="travel_request_hr_user_rule" model="ir.rule">
        <field name="name">Travel Request: HR User sees all (company-scoped)</field>
        <field name="model_id" ref="model_travel_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- HR Manager: all records within allowed companies -->
    <record id="travel_request_hr_manager_rule" model="ir.rule">
        <field name="name">Travel Request: HR Manager sees all (company-scoped)</field>
        <field name="model_id" ref="model_travel_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Record Rule: bxi.mybiz.config
         Admin only — no user-level record rule needed
    ═══════════════════════════════════════════════════════════════ -->

</odoo>