<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_travel_request_list" model="ir.ui.view">
        <field name="name">travel.request.list</field>
        <field name="model">travel.request</field>
        <field name="arch" type="xml">
            <list string="Travel Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="department_id"/>
                <field name="request_date"/>
                <field name="departure_date"/>
                <field name="return_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_travel_request_search" model="ir.ui.view">
        <field name="name">travel.request.search</field>
        <field name="model">travel.request</field>
        <field name="arch" type="xml">
            <search string="Search Travel Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="travel_purpose"/>

                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirm" string="Confirmed" domain="[('state', '=', 'confirm')]"/>
                <filter name="filter_approve" string="Approved" domain="[('state', '=', 'approve')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>

                <separator/>

                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_travel_request_form" model="ir.ui.view">
        <field name="name">travel.request.form</field>
        <field name="model">travel.request</field>
        <field name="arch" type="xml">
            <form string="Travel Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="manager_action_approve"
                            string="Approve"
                            type="object"
                            invisible="state != 'manager_approval' or not can_manager_approve"
                            class="btn-primary"/>

                    <button name="hr_action_approve"
                            string="Approve"
                            type="object"
                            invisible="state != 'hr_approval'"
                            class="btn-primary"
                            groups="base.group_system"/>

                    <button name="finance_action_approve"
                            string="Approve"
                            type="object"
                            invisible="state != 'finance_approval'"
                            class="btn-primary"
                            groups="account.group_account_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,manager_approval,hr_approval,finance_approval,approve,cancel"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="manager_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="department_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="request_by" readonly="1"/>
                            <field name="request_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Travel Request Info">
                            <group>
                                <field name="travel_purpose"/>
                                <field name="project_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="analytic_account_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </group>

                            <group string="Travel Details" col="2">
                                <group string="From">
                                    <field name="from_address"/>
                                    <field name="from_city"/>
                                    <field name="from_state" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="from_country" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </group>
                                <group string="To">
                                    <field name="to_address"/>
                                    <field name="to_city"/>
                                    <field name="to_state" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="to_country" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </group>
                            </group>

                            <group>
                                <group>
                                    <field name="departure_date"/>
                                    <field name="return_date"/>
                                    <field name="mode_of_travel"/>
                                    <field name="days" readonly="1"/>
                                </group>
                                <group>
                                    <field name="contact_number"/>
                                    <field name="email"/>
                                </group>
                            </group>
                        </page>

                        <page string="Other Info">
                            <field name="other_info" nolabel="1" placeholder="Add other information here..."/>
                        </page>

                        <page string="Advance Payment Request">
                            <group>
                                <field name="advance_required"/>
                                <field name="advance_amount" invisible="not advance_required"/>
                                <field name="advance_notes" invisible="not advance_required"/>
                            </group>
                        </page>
                        <!-- <page string="Expense Submission">
                            <group>
                                <group>
                                    <field name="expense_line_count" readonly="1"/>
                                    <field name="total_submitted_expense" readonly="1"/>
                                </group>
                            </group>
                            <field name="expense_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="expense_date"/>
                                    <field name="expense_type"/>
                                    <field name="description"/>
                                    <field name="payment_mode"/>
                                    <field name="remarks"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page> -->
                        <page string="Approvals">
                            <group col="3">

                                <!-- Manager Approval -->
                                <group string="Manager Approval">
                                    <field name="manager_approved_by" readonly="1"/>
                                    <field name="manager_approved_date" readonly="1"/>
                                </group>

                                <!-- HR Approval -->
                                <group string="HR Approval">
                                    <field name="hr_approved_by" readonly="1"/>
                                    <field name="hr_approved_date" readonly="1"/>
                                </group>

                                <!-- Finance Approval -->
                                <group string="Finance Approval">
                                    <field name="finance_approved_by" readonly="1"/>
                                    <field name="finance_approved_date" readonly="1"/>
                                </group>

                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_travel_request" model="ir.actions.act_window">
        <field name="name">Travel Requests</field>
        <field name="res_model">travel.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_travel_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first travel request
            </p>
        </field>
    </record>

</odoo>