<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         ROOT MENU — Travel Request App
    ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_travel_root"
              name="Travel"
              sequence="10"
              web_icon="bxi_travel_request,static/description/icon.png"
              groups="bxi_travel_request.group_travel_user,bxi_travel_request.group_travel_manager,bxi_travel_request.group_travel_admin"/>

    <!-- ── My Travel Requests ────────────────────────────────────── -->
    <menuitem id="menu_my_travel_request"
              name="My Requests"
              parent="menu_travel_root"
              action="action_travel_request_mine"
              sequence="10"
              groups="bxi_travel_request.group_travel_user,bxi_travel_request.group_travel_manager,bxi_travel_request.group_travel_admin"/>

    <!-- ── All Travel Requests (Manager / Admin / HR) ───────────── -->
    <menuitem id="menu_all_travel_request"
              name="All Requests"
              parent="menu_travel_root"
              action="action_travel_request"
              sequence="20"
              groups="bxi_travel_request.group_travel_manager,bxi_travel_request.group_travel_admin,hr.group_hr_user,hr.group_hr_manager"/>

    <!-- ── Pending Approvals (Manager / Admin) ───────────────────── -->
    <menuitem id="menu_travel_pending"
              name="Pending Approvals"
              parent="menu_travel_root"
              action="action_travel_pending_approvals"
              sequence="30"
              groups="bxi_travel_request.group_travel_manager,bxi_travel_request.group_travel_admin"/>

    <!-- ── myBiz Push Failures (Admin) ───────────────────────────── -->
    <menuitem id="menu_travel_mybiz_failed"
              name="myBiz Failures"
              parent="menu_travel_root"
              action="action_travel_mybiz_failed"
              sequence="40"
              groups="bxi_travel_request.group_travel_admin,base.group_erp_manager,base.group_system"/>

    <!-- ── Configuration (Admin) ─────────────────────────────────── -->
    <menuitem id="menu_travel_config_root"
              name="Configuration"
              parent="menu_travel_root"
              sequence="100"
              groups="bxi_travel_request.group_travel_admin,base.group_erp_manager,base.group_system"/>

    <menuitem id="menu_mybiz_config"
              name="myBiz API Configuration"
              parent="menu_travel_config_root"
              action="action_mybiz_config"
              sequence="10"
              groups="bxi_travel_request.group_travel_admin,base.group_erp_manager,base.group_system"/>

    <!-- ── Portal Template ───────────────────────────────────────── -->
    <template id="travel_request_link"
        inherit_id="portal.portal_my_home"
        name="Portal Home - Travel Request">
        <xpath expr="//div[@id='portal_common_category']/t[1]" position="after">
            <t t-if="(request.env.user.has_group('base.group_portal') or request.env.user.has_group('base.group_user'))
             and not request.env.user.sudo().vender_custmer_access">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'bxi_travel_request/static/src/img/icon-travel-services.svg'"/>
                    <t t-set="title">Submit Travel Request</t>
                    <t t-set="text">View and update your Travel Request</t>
                    <t t-set="url" t-value="'/my/travel-request'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

</odoo>