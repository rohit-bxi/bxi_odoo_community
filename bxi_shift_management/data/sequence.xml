<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Auto-increment sequence for Shift Requests -->
    <record id="seq_bxi_shift_request" model="ir.sequence">
        <field name="name">Shift Change Request</field>
        <field name="code">bxi.shift.request</field>
        <field name="prefix">BXI/SR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
