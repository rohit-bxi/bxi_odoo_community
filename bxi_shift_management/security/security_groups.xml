<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Privilege: acts as the "category" for the dropdown shown
         in the User form under Access Rights (non-debug mode).
         In Odoo 19: category_id → res.groups.privilege → res.groups
    ============================================================ -->
    <record model="res.groups.privilege" id="res_groups_privilege_shift_management">
        <field name="name">Shift Management</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- User group — base access, every employee who uses the module -->
    <record id="group_shift_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">The user can create and manage their own shift change requests.</field>
    </record>

    <!-- HR Officer — can approve at HR level and view all records -->
    <record id="group_shift_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('bxi_shift_management.group_shift_user'))]"/>
        <field name="comment">The user can view all shift requests, give HR-level approval, and manage working schedules.</field>
    </record>

    <!-- Administrator — full access -->
    <record id="group_shift_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('bxi_shift_management.group_shift_hr'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative access to shift management.</field>
    </record>

</odoo>
