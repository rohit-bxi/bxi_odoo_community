<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_exception_form" model="ir.ui.view">
        <field name="name">bxi.shift.exception.form</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <form string="Exception Working Request">
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <field name="is_request_manager" invisible="1"/>
                    <field name="can_hr_approve" invisible="1"/>
                    <field name="is_regularization" invisible="1"/>
                    <button
                        name="action_manager_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="state != 'manager_approval' or not is_request_manager"
                    />
                    <button
                        name="action_hr_approve"
                        type="object"
                        string="Approve (HR)"
                        class="btn-success"
                        invisible="state != 'hr_approval' or not can_hr_approve"
                    />
                    <button
                        name="action_refuse"
                        type="object"
                        string="Refuse"
                        class="btn-danger"
                        invisible="not (state in ('manager_approval', 'approved') and is_request_manager or state == 'hr_approval' and can_hr_approve)"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Set to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,manager_approval,approved,refused"
                        invisible="is_regularization"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,manager_approval,hr_approval,approved,refused"
                        invisible="not is_regularization"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                readonly="1"
                                class="oe_inline"
                            />
                        </h1>
                    </div>
                    <group string="Request Information">
                        <group>
                            <field
                                name="employee_id"
                                readonly="1"
                            />
                            <field
                                name="manager_id"
                                readonly="1"
                            />
                            <field
                                name="company_id"
                                readonly="1"
                            />
                        </group>
                        <group>
                            <field
                                name="category"
                                readonly="state != 'draft'"
                            />
                            <div class="o_td_label">
                                <label
                                    for="date_from"
                                    string="From Date"
                                    invisible="is_regularization"
                                />
                                <label
                                    for="date_from"
                                    string="Exception Date"
                                    invisible="not is_regularization"
                                />
                            </div>
                            <field
                                name="date_from"
                                nolabel="1"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="date_to"
                                readonly="state != 'draft'"
                                invisible="is_regularization"
                            />
                        </group>
                    </group>

                    <!-- ================================================= -->
                    <!-- ATTENDANCE REGULARIZATION -->
                    <!-- ================================================= -->

                    <!-- Missing Timesheet: no times. Late Checkout: check-out only. -->
                    <separator
                        string="Attendance Details"
                        invisible="category not in ('attendance_regularization', 'late_checkout')"
                    />

                    <group invisible="category not in ('attendance_regularization', 'late_checkout')">
                        <group>
                            <field
                                name="regularize_check_in"
                                widget="float_time"
                                readonly="state != 'draft'"
                                invisible="category != 'attendance_regularization'"
                                required="category == 'attendance_regularization'"
                            />
                            <field
                                name="regularize_check_out"
                                widget="float_time"
                                readonly="state != 'draft'"
                                required="category in ('attendance_regularization', 'late_checkout')"
                            />
                        </group>
                        <group invisible="state != 'approved'">
                            <field
                                name="regularized_shift_hours"
                                widget="float_time"
                            />
                            <field
                                name="attendance_id"
                                invisible="not attendance_id"
                            />
                        </group>
                    </group>

                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not is_regularization or state != 'draft'"
                    >
                        The request must be submitted and approved on or
                        before the <strong>25th</strong> of the attendance
                        cycle (26th of the previous month to the 25th).
                        Days without an approved request by then are marked
                        as <strong>Loss of Pay (LOP)</strong>.
                    </div>

                    <separator
                        string="Exception Details"
                        invisible="is_regularization"
                    />

                    <group invisible="is_regularization">

                        <group>

                            <field
                                name="mode"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="to_location_id"
                                string="Requested Work Location"
                                readonly="state != 'draft'"
                                required="not is_regularization"
                            />
                        </group>
                        <group>
                            <field
                                name="show_compensation_date"
                                invisible="1"
                            />
                            <field
                                name="compensation_date"
                                string="Compensation Date"
                                readonly="state != 'draft'"
                                invisible="not show_compensation_date"
                            />

                        </group>

                    </group>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="mode != 'home'"
                    >
                        <strong>Work From Home Policy:</strong>

                        <div>
                            Work From Home is allowed for
                            <strong>one day only</strong>
                            and only on
                            <strong>Tuesday, Wednesday or Thursday</strong>.
                        </div>

                        <div>
                            One compensation day is required and must be
                            <strong>Monday or Friday</strong>
                            within 7 calendar days before or after
                            the WFH date.
                        </div>

                    </div>

                    <!-- ================================================= -->
                    <!-- REASON -->
                    <!-- ================================================= -->

                    <separator string="Reason / Description"/>

                    <group>

                        <field
                            name="reason"
                            nolabel="1"
                            placeholder="Please provide the reason for this exception..."
                            readonly="state != 'draft'"
                            required="1"
                        />
                    </group>
                    <separator
                        string="Manager Approval"
                        invisible="state == 'draft'"
                    />

                    <group invisible="state == 'draft'">

                        <group>

                            <field
                                name="manager_approved_by"
                                readonly="1"
                            />

                            <field
                                name="manager_approved_date"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="manager_remark"
                                placeholder="Manager comments..."
                                readonly="state != 'manager_approval'"
                            />

                        </group>

                    </group>

                    <separator
                        string="HR Approval"
                        invisible="not is_regularization or state in ('draft', 'manager_approval')"
                    />

                    <group invisible="not is_regularization or state in ('draft', 'manager_approval')">

                        <group>

                            <field
                                name="hr_approved_by"
                                readonly="1"
                            />

                            <field
                                name="hr_approved_date"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="hr_remark"
                                placeholder="HR comments..."
                                readonly="state != 'hr_approval' or not can_hr_approve"
                            />

                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ============================================================= -->
    <!-- LIST VIEW -->
    <!-- ============================================================= -->

    <record id="view_shift_exception_tree" model="ir.ui.view">
        <field name="name">bxi.shift.exception.list</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">

            <list
                string="Exception Working Requests"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'refused'"
                decoration-warning="state in ('manager_approval', 'hr_approval')"
                decoration-muted="state == 'cancelled'"
            >

                <field
                    name="name"
                    string="Reference"
                />

                <field
                    name="employee_id"
                    string="Employee"
                />

                <field
                    name="manager_id"
                    string="Manager"
                />

                <field
                    name="category"
                    optional="show"
                />

                <field
                    name="date_from"
                    string="From"
                />

                <field
                    name="date_to"
                    string="To"
                />

                <field
                    name="to_location_id"
                    string="Work Location"
                />

                <field
                    name="mode"
                    string="Mode"
                />

                <field
                    name="compensation_date"
                    string="Compensation Date"
                    optional="hide"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                />

                <field
                    name="company_id"
                    optional="hide"
                />

            </list>

        </field>
    </record>


    <!-- ============================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ============================================================= -->

    <record id="view_shift_exception_search" model="ir.ui.view">
        <field name="name">bxi.shift.exception.search</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <search string="Exception Working Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="date_from"/>
                <filter
                    string="Exception"
                    name="category_exception"
                    domain="[('category', '=', 'exception')]"
                />
                <filter
                    string="Regularization"
                    name="category_regularization"
                    domain="[('is_regularization', '=', True)]"
                />
                <separator/>
                <filter
                    string="Manager Approval"
                    name="manager_approval"
                    domain="[('state', '=', 'manager_approval')]"
                />
                <filter
                    string="HR Approval"
                    name="hr_approval"
                    domain="[('state', '=', 'hr_approval')]"
                />
                <filter
                    string="Approved"
                    name="approved"
                    domain="[('state', '=', 'approved')]"
                />
                <group>
                    <filter
                        string="Category"
                        name="group_category"
                        context="{'group_by': 'category'}"
                    />
                    <filter
                        string="Employee"
                        name="group_employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- ALL EXCEPTION REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception"
        model="ir.actions.act_window"
    >
        <field name="name">Exception Working Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exception working request
            </p>

            <p>
                Employees can submit requests for temporary changes
                to their working location or working schedule.
            </p>
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- MY REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_my_request"
        model="ir.actions.act_window"
    >
        <field name="name">My Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="domain">
            [('employee_id.user_id', '=', uid)]
        </field>

    </record>


    <!-- ============================================================= -->
    <!-- TEAM REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_team_request"
        model="ir.actions.act_window"
    >
        <field name="name">Team Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="domain">
            [('manager_id.user_id', '=', uid)]
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- ALL REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_all"
        model="ir.actions.act_window"
    >
        <field name="name">All Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>