<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_exception_form" model="ir.ui.view">
        <field name="name">bxi.shift.exception.form</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <form string="Exception Working Request">
                <header>

                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_manager_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="state != 'manager_approval'"
                        groups="hr.group_hr_manager,base.group_system"
                    />
                    <button
                        name="action_refuse"
                        type="object"
                        string="Refuse"
                        class="btn-danger"
                        invisible="state != 'draft'"
                        groups="hr.group_hr_manager,base.group_system"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Set to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,manager_approval,approved,refused"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                readonly="1"
                                class="oe_inline"
                            />
                        </h1>
                    </div>
                    <group string="Request Information">
                        <group>
                            <field
                                name="employee_id"
                                readonly="1"
                            />
                            <field
                                name="manager_id"
                                readonly="1"
                            />
                            <field
                                name="company_id"
                                readonly="1"
                            />
                        </group>
                        <group>
                            <field
                                name="date_from"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="date_to"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <separator string="Exception Details"/>
                    <group>
                        <group>
                            <field
                                name="mode"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="to_location_id"
                                string="Requested Work Location"
                                readonly="state != 'draft'"
                            />

                        </group>
                        <group>

                            <field
                                name="compensation_date"
                                string="Compensation Date"
                                readonly="state != 'draft'"
                                invisible="mode != 'home'"
                            />

                        </group>

                    </group>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="mode != 'home'"
                    >
                        <strong>Work From Home Policy:</strong>
                        WFH is allowed only on Tuesday, Wednesday and
                        Thursday. Compensation must be taken on Monday
                        or Friday within 7 calendar days before or after
                        the WFH date.
                    </div>

                    <separator string="Reason / Description"/>
                    <group>

                        <field
                            name="reason"
                            nolabel="1"
                            placeholder="Please provide the reason for this exception..."
                            readonly="state != 'draft'"
                        />
                    </group>
                    <separator
                        string="Manager Approval"
                        invisible="state == 'draft'"
                    />

                    <group invisible="state == 'draft'">

                        <group>

                            <field
                                name="manager_approved_by"
                                readonly="1"
                            />

                            <field
                                name="manager_approved_date"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="manager_remark"
                                placeholder="Manager comments..."
                                readonly="state != 'manager_approval'"
                            />

                        </group>

                    </group>

                    <!-- ================================================= -->
                    <!-- REQUEST STATUS -->
                    <!-- ================================================= -->

                    <group string="Request Status">

                        <field
                            name="state"
                            readonly="1"
                        />

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ============================================================= -->
    <!-- LIST VIEW -->
    <!-- ============================================================= -->

    <record id="view_shift_exception_tree" model="ir.ui.view">
        <field name="name">bxi.shift.exception.list</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">

            <list
                string="Exception Working Requests"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'refused'"
                decoration-warning="state == 'manager_approval'"
                decoration-muted="state == 'cancelled'"
            >

                <field
                    name="name"
                    string="Reference"
                />

                <field
                    name="employee_id"
                    string="Employee"
                />

                <field
                    name="manager_id"
                    string="Manager"
                />

                <field
                    name="date_from"
                    string="From"
                />

                <field
                    name="date_to"
                    string="To"
                />

                <field
                    name="to_location_id"
                    string="Work Location"
                />

                <field
                    name="mode"
                    string="Mode"
                />

                <field
                    name="compensation_date"
                    string="Compensation Date"
                    optional="hide"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                />

                <field
                    name="company_id"
                    optional="hide"
                />

            </list>

        </field>
    </record>


    <!-- ============================================================= -->
    <!-- ALL EXCEPTION REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception"
        model="ir.actions.act_window"
    >
        <field name="name">Exception Working Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exception working request
            </p>

            <p>
                Employees can submit requests for temporary changes
                to their working location or working schedule.
            </p>
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- MY REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_my_request"
        model="ir.actions.act_window"
    >
        <field name="name">My Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="domain">
            [('employee_id.user_id', '=', uid)]
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- TEAM REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_team_request"
        model="ir.actions.act_window"
    >
        <field name="name">Team Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>

        <field name="domain">
            [('manager_id.user_id', '=', uid)]
        </field>
    </record>


    <!-- ============================================================= -->
    <!-- ALL REQUESTS -->
    <!-- ============================================================= -->

    <record
        id="action_bxi_shift_exception_all"
        model="ir.actions.act_window"
    >
        <field name="name">All Exception Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>