<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_exception_form" model="ir.ui.view">
        <field name="name">bxi.shift.exception.form</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <form string="Exception Working Request">
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_manager_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="state != 'manager_approval'"
                    />
                    <button
                        name="action_refuse"
                        type="object"
                        string="Refuse"
                        class="btn-danger"
                        invisible="state != 'manager_approval'"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Set to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,manager_approval,approved,refused"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                readonly="1"
                                class="oe_inline"
                            />
                        </h1>
                    </div>
                    <group string="Request Information">
                        <group>
                            <field
                                name="employee_id"
                                readonly="1"
                            />
                            <field
                                name="manager_id"
                                readonly="1"
                            />
                            <field
                                name="company_id"
                                readonly="1"
                            />
                        </group>
                        <group>
                            <field
                                name="date_from"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="date_to"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <separator string="Exception Details"/>
                    <group>
                        <group>
                            <field
                                name="to_location_id"
                                string="Requested Work Location"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="mode"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <field
                                name="allowed_weekdays"
                                placeholder="Example: 0,1,2"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="new_calendar_id"
                                string="Working Schedule"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <separator string="Reason / Description"/>
                    <group>
                        <field
                            name="reason"
                            nolabel="1"
                            placeholder="Please provide the reason for this exception..."
                            readonly="state != 'draft'"
                        />
                    </group>
                    <separator
                        string="Manager Approval"
                        invisible="state == 'draft'"
                    />
                    <group invisible="state == 'draft'">
                        <group>
                            <field
                                name="manager_approved_by"
                                readonly="1"
                            />
                            <field
                                name="manager_approved_date"
                                readonly="1"
                            />
                        </group>
                        <group>
                            <field
                                name="manager_remark"
                                placeholder="Manager comments..."
                                readonly="state != 'manager_approval'"
                            />
                        </group>
                    </group>
                    <group string="Request Status">
                        <field
                            name="state"
                            readonly="1"
                        />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shift_exception_tree" model="ir.ui.view">
        <field name="name">bxi.shift.exception.list</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <list
                string="Exception Working Requests"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'refused'"
                decoration-warning="state == 'manager_approval'"
                decoration-muted="state == 'cancelled'"
            >
                <field
                    name="name"
                    string="Reference"
                />
                <field
                    name="employee_id"
                    string="Employee"
                />
                <field
                    name="manager_id"
                    string="Manager"
                />

                <field
                    name="date_from"
                    string="From"
                />

                <field
                    name="date_to"
                    string="To"
                />

                <field
                    name="to_location_id"
                    string="Work Location"
                />

                <field
                    name="mode"
                    string="Mode"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                />

                <field
                    name="company_id"
                    optional="hide"
                />

            </list>

        </field>
    </record>

    <record id="action_bxi_shift_exception" model="ir.actions.act_window">
        <field name="name">Exception Working Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exception working request
            </p>
            <p>
                Employees can submit requests for temporary changes
                to their working location or working schedule.
            </p>
        </field>
    </record>
</odoo>