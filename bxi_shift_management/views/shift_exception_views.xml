<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_exception_form" model="ir.ui.view">
        <field name="name">bxi.shift.exception.form</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <form string="Exception Working Request">
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_manager_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="state != 'manager_approval'"
                    />
                    <button
                        name="action_refuse"
                        type="object"
                        string="Refuse"
                        class="btn-danger"
                        invisible="state != 'manager_approval'"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Set to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="manager_id" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="state" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="to_location_id"/>
                        <field name="mode"/>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="manager_remark"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shift_exception_tree" model="ir.ui.view">
        <field name="name">bxi.shift.exception.list</field>
        <field name="model">bxi.shift.exception</field>
        <field name="arch" type="xml">
            <list string="Exception Working Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="to_location_id"/>
                <field name="mode"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_bxi_shift_exception" model="ir.actions.act_window">
        <field name="name">Exception Working Requests</field>
        <field name="res_model">bxi.shift.exception</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>