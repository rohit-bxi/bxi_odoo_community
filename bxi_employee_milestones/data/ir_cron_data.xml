<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily at 03:30 UTC = 09:00 IST -->
        <record id="ir_cron_birthday_wishes" model="ir.cron">
            <field name="name">Employee Milestones: Happy Birthday Emails</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_birthday_wishes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_anniversary_wishes" model="ir.cron">
            <field name="name">Employee Milestones: Happy Job Anniversary Emails</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_anniversary_wishes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_probation_reviews" model="ir.cron">
            <field name="name">Employee Milestones: Start Probation Reviews</field>
            <field name="model_id" ref="model_hr_probation_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_start_probation_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
