<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_probation_review_company" model="ir.rule">
        <field name="name">Probation Review: multi-company</field>
        <field name="model_id" ref="model_hr_probation_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Reporting managers see the reviews of their direct reports -->
    <record id="rule_probation_review_manager" model="ir.rule">
        <field name="name">Probation Review: reporting manager</field>
        <field name="model_id" ref="model_hr_probation_review"/>
        <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_probation_review_hr" model="ir.rule">
        <field name="name">Probation Review: HR</field>
        <field name="model_id" ref="model_hr_probation_review"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
