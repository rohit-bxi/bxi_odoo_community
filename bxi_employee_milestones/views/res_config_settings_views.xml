<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_milestones" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.milestones</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="after">
                <block title="Employee Milestones" name="milestones_setting_container">
                    <setting string="HR Email" company_dependent="1"
                             help="Copied on Happy Job Anniversary emails and notified of probation reviews waiting for manager or HR.">
                        <field name="milestone_hr_email" placeholder="hrsupport@bxitech.com"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
