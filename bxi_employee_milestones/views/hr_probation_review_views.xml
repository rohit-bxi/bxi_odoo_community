<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_probation_review_view_list" model="ir.ui.view">
        <field name="name">hr.probation.review.list</field>
        <field name="model">hr.probation.review</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state in ('manager_review', 'hr_review')"
                  decoration-success="state == 'confirmed'" decoration-danger="state == 'refused'">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="manager_id"/>
                <field name="joining_date" optional="show"/>
                <field name="probation_end_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('manager_review', 'hr_review')"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="hr_probation_review_view_form" model="ir.ui.view">
        <field name="name">hr.probation.review.form</field>
        <field name="model">hr.probation.review</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_manager_confirm" type="object" string="Confirm Probation"
                            class="btn-primary" invisible="state != 'manager_review'"/>
                    <button name="action_hr_approve" type="object" string="HR Approve"
                            class="btn-primary" invisible="state != 'hr_review'"
                            groups="hr.group_hr_user"/>
                    <button name="action_refuse" type="object" string="Do Not Confirm"
                            invisible="state != 'manager_review'"
                            confirm="The probation will not be confirmed. Continue?"/>
                    <button name="action_refuse" type="object" string="Do Not Confirm"
                            invisible="state != 'hr_review'" groups="hr.group_hr_user"
                            confirm="The probation will not be confirmed. Continue?"/>
                    <button name="action_send_back_to_manager" type="object" string="Send Back to Manager"
                            invisible="state not in ('hr_review', 'refused')" groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="manager_review,hr_review,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="joining_date"/>
                            <field name="probation_end_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Manager Review">
                            <field name="manager_comments" readonly="state != 'manager_review'"
                                   placeholder="Performance, conduct, required for 'Do Not Confirm'"/>
                            <field name="manager_decision_by" invisible="not manager_decision_by"/>
                            <field name="manager_decision_on" invisible="not manager_decision_on"/>
                        </group>
                        <group string="HR Approval">
                            <field name="hr_comments" readonly="state != 'hr_review'"
                                   placeholder="Required for 'Do Not Confirm'"/>
                            <field name="hr_decision_by" invisible="not hr_decision_by"/>
                            <field name="hr_decision_on" invisible="not hr_decision_on"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_probation_review_view_search" model="ir.ui.view">
        <field name="name">hr.probation.review.search</field>
        <field name="model">hr.probation.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="department_id"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state', 'in', ('manager_review', 'hr_review'))]"/>
                <filter name="filter_manager_review" string="Waiting Manager"
                        domain="[('state', '=', 'manager_review')]"/>
                <filter name="filter_hr_review" string="Waiting HR"
                        domain="[('state', '=', 'hr_review')]"/>
                <separator/>
                <filter name="filter_my_team" string="My Team"
                        domain="[('manager_id.user_id', '=', uid)]"/>
                <filter name="filter_my_activities" string="My Activities"
                        domain="[('activity_user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_probation_review" model="ir.actions.act_window">
        <field name="name">Probation Reviews</field>
        <field name="res_model">hr.probation.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_probation_review_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No probation review to do</p>
            <p>
                A review starts automatically 10 days before the probation end date
                of employees whose Probation Period is set to Yes.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_probation_review"
              name="Probation Reviews"
              action="action_hr_probation_review"
              parent="hr.menu_hr_root"
              sequence="4"
              groups="base.group_user"/>
</odoo>
