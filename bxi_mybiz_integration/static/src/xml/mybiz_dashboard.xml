<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="bxi_mybiz_integration.DashboardTemplate" owl="1">
    <div class="o_mybiz_dashboard_container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 mybiz-dashboard-header">
            <h2 class="mybiz-dashboard-title">myBiz Integration Dashboard</h2>
            <div class="btn-group btn-group-sm rounded-pill shadow-sm bg-white p-1 border" role="group">
                <button type="button"
                        t-attf-class="btn rounded-pill px-3 py-1 border-0 #{state.days === 30 ? 'btn-primary text-white' : 'btn-light text-secondary'}"
                        t-on-click="() => this.setDays(30)">30 Days</button>
                <button type="button"
                        t-attf-class="btn rounded-pill px-3 py-1 border-0 #{state.days === 90 ? 'btn-primary text-white' : 'btn-light text-secondary'}"
                        t-on-click="() => this.setDays(90)">90 Days</button>
                <button type="button"
                        t-attf-class="btn rounded-pill px-3 py-1 border-0 #{state.days === 365 ? 'btn-primary text-white' : 'btn-light text-secondary'}"
                        t-on-click="() => this.setDays(365)">1 Year</button>
            </div>
        </div>

        <t t-if="!state.loaded">
            <div class="text-center text-muted py-5">Loading…</div>
        </t>

        <t t-if="state.loaded">

            <!-- KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="mybiz-kpi-card">
                        <div class="mybiz-kpi-value" t-esc="state.total_requests"/>
                        <div class="mybiz-kpi-label">Total Requests</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="mybiz-kpi-card">
                        <div class="mybiz-kpi-value text-success" t-esc="state.success_rate + '%'"/>
                        <div class="mybiz-kpi-label">myBiz Push Success Rate</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="mybiz-kpi-card">
                        <div class="mybiz-kpi-value text-danger" t-esc="state.failed_count"/>
                        <div class="mybiz-kpi-label">Push Failures</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="mybiz-kpi-card">
                        <div class="mybiz-kpi-value" t-esc="state.avg_turnaround_days"/>
                        <div class="mybiz-kpi-label">Avg. Approval Turnaround (days)</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="mybiz-kpi-card mybiz-kpi-card-sm">
                        <div class="mybiz-kpi-value" t-esc="state.pending_manager"/>
                        <div class="mybiz-kpi-label">Pending Manager Approval</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="mybiz-kpi-card mybiz-kpi-card-sm">
                        <div class="mybiz-kpi-value" t-esc="state.pending_hr"/>
                        <div class="mybiz-kpi-label">Pending HR Approval</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="mybiz-kpi-card mybiz-kpi-card-sm">
                        <div class="mybiz-kpi-value" t-esc="state.mybiz_pending"/>
                        <div class="mybiz-kpi-label">Awaiting myBiz Confirmation</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Status Funnel -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">Requests by Status</h5>
                        <t t-foreach="Object.keys(state.state_counts)" t-as="key" t-key="key">
                            <div class="mybiz-bar-row">
                                <div class="mybiz-bar-label" t-esc="state.state_labels[key]"/>
                                <div class="mybiz-bar-track">
                                    <div class="mybiz-bar-fill"
                                         t-attf-style="width: #{this.barWidth(state.state_counts[key], state.total_requests)}%; background-color: #{this.stateColor(key)};"/>
                                </div>
                                <div class="mybiz-bar-value" t-esc="state.state_counts[key]"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- myBiz Push Status -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">myBiz Push Status</h5>
                        <t t-foreach="Object.keys(state.mybiz_counts)" t-as="key" t-key="key">
                            <div class="mybiz-bar-row">
                                <div class="mybiz-bar-label" t-esc="state.mybiz_labels[key]"/>
                                <div class="mybiz-bar-track">
                                    <div class="mybiz-bar-fill"
                                         t-attf-style="width: #{this.barWidth(state.mybiz_counts[key], state.total_requests)}%; background-color: #{this.mybizColor(key)};"/>
                                </div>
                                <div class="mybiz-bar-value" t-esc="state.mybiz_counts[key]"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Monthly Trend -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">Requests — Last 6 Months</h5>
                        <div class="mybiz-trend-row">
                            <t t-foreach="state.monthly_trend" t-as="m" t-key="m.label">
                                <div class="mybiz-trend-col">
                                    <div class="mybiz-trend-bar-wrap">
                                        <div class="mybiz-trend-bar"
                                             t-attf-style="height: #{this.barWidth(m.count, state.max_month_count)}%;"/>
                                    </div>
                                    <div class="mybiz-trend-count" t-esc="m.count"/>
                                    <div class="mybiz-trend-label" t-esc="m.label"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Department Spend -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">Spend by Department</h5>
                        <t t-if="state.dept_spend.length === 0">
                            <div class="text-muted small">No expense/advance data in this period.</div>
                        </t>
                        <t t-foreach="state.dept_spend" t-as="d" t-key="d.department">
                            <div class="mybiz-bar-row">
                                <div class="mybiz-bar-label" t-esc="d.department"/>
                                <div class="mybiz-bar-track">
                                    <div class="mybiz-bar-fill bg-primary"
                                         t-attf-style="width: #{this.barWidth(d.amount, state.max_dept_amount)}%;"/>
                                </div>
                                <div class="mybiz-bar-value" t-esc="state.currency_symbol + ' ' + d.amount"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Upcoming Travel -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">Upcoming Approved Travel</h5>
                        <t t-if="state.upcoming.length === 0">
                            <div class="text-muted small">No upcoming approved travel.</div>
                        </t>
                        <table class="table table-sm mybiz-table" t-if="state.upcoming.length > 0">
                            <thead>
                                <tr><th>Reference</th><th>Employee</th><th>Route</th><th>Departure</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.upcoming" t-as="u" t-key="u.id"
                                    class="mybiz-clickable-row" t-on-click="() => this.openRequest(u.id)">
                                    <td t-esc="u.name"/>
                                    <td t-esc="u.employee"/>
                                    <td t-esc="u.from_city + ' → ' + u.to_city"/>
                                    <td t-esc="u.departure_date"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Recent myBiz Failures -->
                <div class="col-md-6">
                    <div class="mybiz-panel">
                        <h5 class="mybiz-panel-title">Recent myBiz Push Failures</h5>
                        <t t-if="state.recent_failures.length === 0">
                            <div class="text-muted small">No recent failures 🎉</div>
                        </t>
                        <table class="table table-sm mybiz-table" t-if="state.recent_failures.length > 0">
                            <thead>
                                <tr><th>Reference</th><th>Employee</th><th>Error</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.recent_failures" t-as="f" t-key="f.id"
                                    class="mybiz-clickable-row" t-on-click="() => this.openRequest(f.id)">
                                    <td t-esc="f.name"/>
                                    <td t-esc="f.employee"/>
                                    <td class="text-danger small" t-esc="f.error"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </t>
    </div>
</t>

</templates>
