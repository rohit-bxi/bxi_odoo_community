<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fbook_report_wizard_form" model="ir.ui.view">
        <field name="name">fbook.report.wizard.form</field>
        <field name="model">fbook.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Fbook Report Filter">
                <group>
                    <field name="company_ids" widget="many2many_tags" domain="[('id', 'in', allowed_company_ids)]" options="{'no_open': True, 'no_create': True}"/>

                    <field name="start_financial_year"/>
                    <field name="currency_id" options="{'no_open': True, 'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fbook_report_wizard" model="ir.actions.act_window">
        <field name="name">Fbook Report Filter</field>
        <field name="res_model">fbook.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
