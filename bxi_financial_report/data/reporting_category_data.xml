        <record id="category_grants_endowments" model="reporting.category">
            <field name="name">Grants &amp; Endowments</field>
            <field name="category_type">investment_received</field>
            <field name="sequence">40</field>
        </record>

        <!-- Investments Made Categories -->
        <record id="category_deposits_treasury" model="reporting.category">
            <field name="name">Deposits &amp; Treasury Investments</field>
