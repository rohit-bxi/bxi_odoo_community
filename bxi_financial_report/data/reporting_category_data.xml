             1. REPORTING CATEGORIES
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Investments Received Categories -->
        <record id="category_equity_capital" model="reporting.category">
            <field name="name">Equity Capital</field>
            <field name="category_type">investment_received</field>
            <field name="sequence">10</field>
        </record>

        <record id="category_debt_capital" model="reporting.category">
            <field name="name">Debt Capital</field>
            <field name="category_type">investment_received</field>
            <field name="sequence">20</field>
        </record>

        <record id="category_banking_facilities" model="reporting.category">
            <field name="name">Banking Facilities</field>
