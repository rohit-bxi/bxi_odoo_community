<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_training">
        <field name="name">Specialized Training</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Employees sign and claim, Department Heads nominate their department and Reporting
         Managers approve their team's claims: none of them needs a dedicated group. -->
    <record id="group_training_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_es" model="res.groups">
        <field name="name">Employee Services</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_hr'))]"/>
    </record>

    <record id="group_training_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_es')), (4, ref('group_training_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Training requests ─────────────────────────────────────────── -->
    <record id="bxi_training_request_rule_own" model="ir.rule">
        <field name="name">Training: own, nominated, department, team or to approve</field>
        <field name="model_id" ref="model_bxi_training_request"/>
        <field name="domain_force">['|', '|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('nominated_by_user_id', '=', user.id),
            ('department_id.manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('approval_line_ids.approver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_request_rule_all" model="ir.rule">
        <field name="name">Training: all</field>
        <field name="model_id" ref="model_bxi_training_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance')), (4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <record id="bxi_training_cost_line_rule_own" model="ir.rule">
        <field name="name">Training cost: of visible trainings</field>
        <field name="model_id" ref="model_bxi_training_cost_line"/>
        <field name="domain_force">['|', '|', '|',
            ('request_id.employee_id.user_id', '=', user.id),
            ('request_id.nominated_by_user_id', '=', user.id),
            ('request_id.department_id.manager_id.user_id', '=', user.id),
            ('request_id.employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_cost_line_rule_all" model="ir.rule">
        <field name="name">Training cost: all</field>
        <field name="model_id" ref="model_bxi_training_cost_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance'))]"/>
    </record>

    <record id="bxi_training_approval_line_rule_own" model="ir.rule">
        <field name="name">Training approval: of visible trainings</field>
        <field name="model_id" ref="model_bxi_training_approval_line"/>
        <field name="domain_force">['|', '|', '|',
            ('request_id.employee_id.user_id', '=', user.id),
            ('request_id.employee_id.parent_id.user_id', '=', user.id),
            ('request_id.department_id.manager_id.user_id', '=', user.id),
            ('request_id.approval_line_ids.approver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_approval_line_rule_all" model="ir.rule">
        <field name="name">Training approval: all</field>
        <field name="model_id" ref="model_bxi_training_approval_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance'))]"/>
    </record>

    <!-- ── Service agreements and recoveries ─────────────────────────── -->
    <record id="bxi_training_agreement_rule_own" model="ir.rule">
        <field name="name">Training agreement: own</field>
        <field name="model_id" ref="model_bxi_training_agreement"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_agreement_rule_all" model="ir.rule">
        <field name="name">Training agreement: all</field>
        <field name="model_id" ref="model_bxi_training_agreement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance'))]"/>
    </record>

    <record id="bxi_training_recovery_rule_own" model="ir.rule">
        <field name="name">Training recovery: own</field>
        <field name="model_id" ref="model_bxi_training_recovery"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_recovery_rule_all" model="ir.rule">
        <field name="name">Training recovery: all</field>
        <field name="model_id" ref="model_bxi_training_recovery"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance'))]"/>
    </record>

    <record id="bxi_training_recovery_line_rule_own" model="ir.rule">
        <field name="name">Training recovery line: own</field>
        <field name="model_id" ref="model_bxi_training_recovery_line"/>
        <field name="domain_force">[('recovery_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_training_recovery_line_rule_all" model="ir.rule">
        <field name="name">Training recovery line: all</field>
        <field name="model_id" ref="model_bxi_training_recovery_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_training_hr')), (4, ref('group_training_finance'))]"/>
    </record>

    <!-- ── Multi-company ─────────────────────────────────────────────── -->
    <record id="bxi_training_request_comp_rule" model="ir.rule">
        <field name="name">Training: multi-company</field>
        <field name="model_id" ref="model_bxi_training_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_training_agreement_comp_rule" model="ir.rule">
        <field name="name">Training agreement: multi-company</field>
        <field name="model_id" ref="model_bxi_training_agreement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_training_recovery_comp_rule" model="ir.rule">
        <field name="name">Training recovery: multi-company</field>
        <field name="model_id" ref="model_bxi_training_recovery"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_training_agreement_tier_comp_rule" model="ir.rule">
        <field name="name">Training agreement tier: multi-company</field>
        <field name="model_id" ref="model_bxi_training_agreement_tier"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
