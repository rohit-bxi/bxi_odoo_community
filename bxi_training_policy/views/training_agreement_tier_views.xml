<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bxi_training_agreement_tier_list" model="ir.ui.view">
        <field name="name">bxi.training.agreement.tier.list</field>
        <field name="model">bxi.training.agreement.tier</field>
        <field name="arch" type="xml">
            <list string="Service Agreement Tiers" editable="bottom">
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="months"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="note"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_bxi_training_agreement_tier" model="ir.actions.act_window">
        <field name="name">Service Agreement Tiers</field>
        <field name="res_model">bxi.training.agreement.tier</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the service period by consolidated cost</p>
            <p>Training Policy: Rs 50,000 - Rs 99,999: 1 year; Rs 1,00,000 and above: 2 years.</p>
        </field>
    </record>

</odoo>
