<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_inherit_training" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_trainings" type="object" class="oe_stat_button" icon="fa-graduation-cap"
                        groups="bxi_training_policy.group_training_hr,bxi_training_policy.group_training_finance">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="trn_bonded_amount" widget="monetary"/></span>
                        <span class="o_stat_text">Trainings (<field name="trn_request_count"/>)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
