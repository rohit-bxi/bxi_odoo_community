<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_expense_form_inherit_training" model="ir.ui.view">
        <field name="name">hr.expense.form.training</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="training_request_id" invisible="not training_request_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_training" model="ir.ui.view">
        <field name="name">product.template.form.training</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_expense.view_product_hr_expense_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='can_be_expensed']/.." position="after">
                <span class="d-inline-flex" invisible="not can_be_expensed">
                    <field name="is_training_expense"/>
                    <label for="is_training_expense"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
