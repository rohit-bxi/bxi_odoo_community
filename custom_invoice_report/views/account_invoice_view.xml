<odoo>
    <record id="view_account_move_form_custom_button" model="ir.ui.view">
        <field name="name">account.form.custom.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_custom_invoice_report_pdf"
                    type="object"
                    string="Print Invoice"
                    class="btn-primary"
                    icon="fa-print"
                />
            </xpath>
            <xpath expr="//button[@name='action_print_pdf']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_months" model="ir.ui.view">
        <field name="name">account.move.form.inherit.months</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="inv_months"/>
            </xpath>
        </field>
    </record>

</odoo>
