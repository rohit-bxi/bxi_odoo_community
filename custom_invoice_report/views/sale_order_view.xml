<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_months" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.months</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="months"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']" position="after">
                <field name="months"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_shipping_address" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.shipping.address</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="after">
                <group string="Ship To" name="ship_to_address_group">
                    <field name="is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked"/>
                    <field name="shipping_partner_id" string="Ship To" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked" options="{'no_open': True, 'no_create': True}"/>
                    <field name="shipping_street" string="Street 1" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked"/>
                    <field name="shipping_street2" string="Street 2" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked"/>
                    <field name="shipping_city" string="City" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked"/>
                    <field name="shipping_state_id" string="State" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked" options="{'no_open': True, 'no_create': True}"/>
                    <field name="shipping_zip" string="Zip" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked"/>
                    <field name="shipping_country_id" string="Country" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'sale') or locked" options="{'no_open': True, 'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

