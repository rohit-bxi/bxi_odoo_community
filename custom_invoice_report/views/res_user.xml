<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_inherit_signature_name" model="ir.ui.view">
        <field name="name">res.users.form.signature.name</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="after">
                <field name="signature_name" placeholder="Enter Signature Name"/>
            </xpath>
        </field>
    </record>
</odoo>