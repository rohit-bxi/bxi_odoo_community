<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="custom_invoice_template">
        <t t-call="web.html_container">
            <meta charset="UTF-8"/>
            <t t-foreach="docs" t-as="o">
                <t t-set="is_india" t-value="o.company_id.country_code == 'IN' or (not o.company_id.country_id and o.company_id.account_fiscal_country_id.code == 'IN')"/>
                <div class="page" style="font-size:12px;font-family:sans-serif;color:#000;">

                    <!-- TOP GST / TRN + TITLE -->
                    <table width="100%" style="border-collapse:collapse;border:1px solid black;">
                        <tr>
                            <td width="30%"
                                style="border:1px solid black;padding:6px;font-weight:bold;font-size:13px;vertical-align:middle;">
                                <t t-if="is_india">GSTIN</t>
                                <t t-elif="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                                <t t-elif="o.company_id.country_id.vat_label" t-out="o.company_id.country_id.vat_label"/>
                                <t t-elif="o.company_id.country_code in ('AE', 'SA', 'BH', 'OM', 'KW', 'QA')">TRN</t>
                                <t t-else="">TRN</t>:
                                <span t-field="o.company_id.vat"/>
                            </td>

                            <td width="40%"
                                style="border:1px solid black;padding:6px;text-align:center;font-weight:bold;font-size:15px;background:#0b2f5b;color:white;vertical-align:middle;">
                                TAX INVOICE
                                <br/>
                                <span t-field="o.company_id.name"/>
                            </td>

                            <td width="30%" style="border:1px solid black;padding:6px;text-align:center;vertical-align:middle;">
                                <t t-if="o.company_id.logo">
                                    <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height:45px;max-width:100%;" alt="Logo"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- COMPANY ADDRESS -->
                    <div style="text-align:center;border:1px solid black;border-top:0;padding:5px;font-weight:bold;font-size:11px;">
                        <span t-field="o.company_id.partner_id.contact_address"/>
                    </div>

                    <!-- BILL / SHIP / META -->
                    <table width="100%" style="border-collapse:collapse;">
                        <tr>
                            <td width="48%"
                                style="border:1px solid black;border-top:0;padding:6px;vertical-align:top;line-height:1.4;">
                                <b>BILL TO</b>
                                <br/>
                                <span t-field="o.partner_id.name"/>
                                <br/>
                                <t t-if="o.partner_id.vat">
                                    <t t-if="o.partner_id.country_code == 'IN'">GSTIN</t>
                                    <t t-elif="o.partner_id.country_id.vat_label" t-out="o.partner_id.country_id.vat_label"/>
                                    <t t-elif="o.partner_id.country_code in ('AE', 'SA', 'BH', 'OM', 'KW', 'QA')">TRN</t>
                                    <t t-elif="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                                    <t t-elif="is_india and not o.partner_id.country_id">GSTIN</t>
                                    <t t-else="">TRN</t>:
                                    <span t-field="o.partner_id.vat"/>
                                    <br/>
                                </t>
                                <span t-field="o.partner_id.contact_address"/>
                            </td>

                            <td width="24%"
                                style="border:1px solid black;border-top:0;padding:6px;vertical-align:top;line-height:1.4;">
                                <b>DATE</b>
                                <br/>
                                <span t-field="o.invoice_date"/>
                                <br/>
                                <br/>
                                <b>INVOICE NO.</b>
                                <br/>
                                <span t-field="o.name"/>
                            </td>

                            <td width="28%"
                                style="border:1px solid black;border-top:0;padding:6px;vertical-align:top;line-height:1.4;">
                                <b>SHIP TO</b>
                                <br/>
                                <t t-if="o.is_different_shipping_address">
                                    <t t-if="o.shipping_street"><span t-field="o.shipping_street"/><br/></t>
                                    <t t-if="o.shipping_street2"><span t-field="o.shipping_street2"/><br/></t>
                                    <t t-if="o.shipping_city"><span t-field="o.shipping_city"/><t t-if="o.shipping_state_id or o.shipping_zip">, </t></t>
                                    <t t-if="o.shipping_state_id"><span t-field="o.shipping_state_id.name"/><t t-if="o.shipping_zip"> - </t></t>
                                    <t t-if="o.shipping_zip"><span t-field="o.shipping_zip"/></t>
                                    <t t-if="o.shipping_city or o.shipping_state_id or o.shipping_zip"><br/></t>
                                    <t t-if="o.shipping_country_id"><span t-field="o.shipping_country_id.name"/></t>
                                </t>
                                <t t-else="">
                                    <span t-field="o.partner_id.contact_address"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- ITEMS TABLE -->
                    <table width="100%" style="border-collapse:collapse;border:1px solid black;border-top:0;">
                        <thead>
                            <tr style="background:#0b2f5b;color:white;font-weight:bold;text-align:center;">
                                <th style="border:1px solid black;padding:6px;width:5%;">S.No</th>
                                <th style="border:1px solid black;padding:6px;width:26%;">DESCRIPTION</th>
                                <th style="border:1px solid black;padding:6px;width:9%;">SAC/HSN CODE</th>
                                <th style="border:1px solid black;padding:6px;width:10%;">MONTH/YEAR</th>
                                <th style="border:1px solid black;padding:6px;width:6%;">QTY</th>
                                <th style="border:1px solid black;padding:6px;width:11%;">UNIT PRICE</th>
                                <th style="border:1px solid black;padding:6px;width:10%;">TAX</th>
                                <th style="border:1px solid black;padding:6px;width:11%;">TAX AMOUNT</th>
                                <th style="border:1px solid black;padding:6px;width:12%;">AMOUNT</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <t t-foreach="o.invoice_line_ids" t-as="l">
                                <t t-if="l.display_type in ('product', False) or not l.display_type">
                                    <tr>
                                        <td style="border:1px solid black;padding:6px;text-align:center;">
                                            <t t-esc="i"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:left;">
                                            <span t-field="l.name"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:center;">
                                            <span t-field="l.product_id.l10n_in_hsn_code"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:center;">
                                            <t t-if="l.inv_months">
                                                <span t-field="l.inv_months"/>
                                            </t>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:center;">
                                            <span t-field="l.quantity" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:right;">
                                            <span t-field="l.price_unit"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:center;">
                                            <span t-esc="', '.join(l.tax_ids.mapped('name'))"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:right;">
                                            <span t-esc="l.price_total - l.price_subtotal"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>

                                        <td style="border:1px solid black;padding:6px;text-align:right;">
                                            <span t-field="l.price_subtotal"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <t t-set="i" t-value="i+1"/>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- TOTALS -->
                    <table width="100%"
                           style="border-collapse:collapse;border:1px solid black;margin-top:10px;">
                        <tr>
                            <td width="60%" style="border:1px solid black;"></td>
                            <td width="20%"
                                style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">SUBTOTAL
                            </td>
                            <td width="20%"
                                style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                <span t-field="o.amount_untaxed"
                                      t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                            </td>
                        </tr>

                        <!-- TAX DISTRIBUTION LINES -->
                        <t t-set="tax_totals" t-value="o.tax_totals"/>

                        <t t-if="tax_totals and tax_totals.get('subtotals')">
                            <t t-foreach="tax_totals.get('subtotals')" t-as="subtotal">
                                <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                    <tr>
                                        <td style="border:1px solid black;"></td>
                                        <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                            <t t-esc="tax_group.get('group_name') or tax_group.get('tax_group_name')"/>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                            <span t-esc="tax_group.get('tax_amount_currency', 0.0)"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                        <t t-elif="tax_totals and tax_totals.get('groups_by_subtotal')">
                            <t t-foreach="tax_totals.get('groups_by_subtotal').values()" t-as="tax_group_list">
                                <t t-foreach="tax_group_list" t-as="tax_group">
                                    <tr>
                                        <td style="border:1px solid black;"></td>
                                        <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                            <t t-esc="tax_group.get('tax_group_name') or tax_group.get('group_name')"/>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                            <span t-esc="tax_group.get('tax_group_amount', tax_group.get('tax_amount_currency', 0.0))"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                        <t t-elif="o.line_ids.filtered(lambda l: l.display_type == 'tax')">
                            <t t-foreach="o.line_ids.filtered(lambda l: l.display_type == 'tax')" t-as="tax_line">
                                <tr>
                                    <td style="border:1px solid black;"></td>
                                    <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                        <t t-esc="tax_line.name"/>
                                    </td>
                                    <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                        <span t-esc="abs(tax_line.amount_currency)"
                                              t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </t>

                        <tr>
                            <td style="border:1px solid black;"></td>
                            <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">TOTAL TAX</td>
                            <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                <span t-field="o.amount_tax"
                                      t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                            </td>
                        </tr>

                        <tr style="background:#f0f0f0;font-size:13px;">
                            <td style="border:1px solid black;"></td>
                            <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">INVOICE VALUE</td>
                            <td style="border:1px solid black;text-align:right;font-weight:bold;padding:6px;">
                                <span t-field="o.amount_total"
                                      t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                            </td>
                        </tr>
                    </table>

                    <!-- AMOUNT WORDS -->
                    <div style="border:1px solid black;border-top:0;padding:6px;font-weight:bold;font-size:11px;">
                        Invoice Value in Words:
                        <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                    </div>

                    <!-- FOOTER -->
                    <table width="100%" style="border-collapse:collapse;border:1px solid black;border-top:0;">
                        <tr>
                            <td width="50%"
                                style="border-right:1px solid black;padding:8px;vertical-align:top;line-height:1.4;">
                                Certified that the particulars given above are true and correct.
                                <br/>
                                <br/>
                                <b>For <span t-field="o.company_id.name"/></b>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <div>Authorised Signatory</div>
                            </td>

                            <td width="50%"
                                style="padding:8px;vertical-align:top;line-height:1.4;">
                                <b>Bank Details</b>
                                <br/>
                                <br/>
                                <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[:1]"/>
                                <t t-if="bank">
                                    <t t-foreach="bank" t-as="b">
                                        Bank A/c No: <span t-field="b.acc_number"/>
                                        <br/>
                                        <t t-if="b.bank_bic">
                                            Bank IFSC / SWIFT: <span t-field="b.bank_bic"/>
                                            <br/>
                                        </t>
                                        <t t-if="b.bank_name">
                                            Bank Name: <span t-field="b.bank_name"/>
                                            <br/>
                                        </t>
                                    </t>
                                </t>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>