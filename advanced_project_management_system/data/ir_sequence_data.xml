<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Generate sequence for the project issue -->
        <record id="seq_project_issue" model="ir.sequence">
            <field name="name">Sequence</field>
            <field name="code">project.issue</field>
            <field name="prefix">PI</field>
            <field name="padding">3</field>
        </record>
    </data>
    <record id="seq_project_project_pmo" model="ir.sequence">
        <field name="name">PMO Project Reference</field>
        <field name="code">project.project.pmo</field>
        <field name="prefix">PRJ</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_project_milestone_pmo" model="ir.sequence">
        <field name="name">PMO Milestone Reference</field>
        <field name="code">project.milestone.pmo</field>
        <field name="prefix">MS</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_project_task_pmo" model="ir.sequence">
        <field name="name">PMO Task Reference</field>
        <field name="code">project.task.pmo</field>
        <field name="prefix">TSK</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_project_risk" model="ir.sequence">
        <field name="name">Project Risk Reference</field>
        <field name="code">project.risk</field>
        <field name="prefix">RSK</field>
        <field name="padding">4</field>
    </record>
</odoo>
