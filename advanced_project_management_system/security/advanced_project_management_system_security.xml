<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- Access levels: Admin / Manager / User                             -->
    <!-- ================================================================= -->
    <record id="res_groups_privilege_apms" model="res.groups.privilege">
        <field name="name">Advanced Project Management</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- User level: own tasks, own sub-tasks and own timesheets only.
         Milestones are visible but read only. -->
    <record id="group_apms_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: sees and edits only the tasks and
            sub-tasks assigned to them, records only their own timesheets and
            reads the milestones of the projects they work on.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_apms"/>
        <field name="implied_ids"
               eval="[(4, ref('project.group_project_user')),
                      (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>

    <!-- Manager level: everything happening on the projects they manage or
         follow, including their team's timesheets and milestones. -->
    <record id="group_apms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Manager: full access to the tasks, sub-tasks,
            milestones, issues and timesheets of the projects they manage or
            follow.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_apms"/>
        <field name="implied_ids"
               eval="[(4, ref('advanced_project_management_system.group_apms_user')),
                      (4, ref('hr_timesheet.group_hr_timesheet_approver')),
                      (4, ref('project.group_project_milestone'))]"/>
    </record>

    <!-- Admin level: unrestricted access to every project. -->
    <record id="group_apms_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: unrestricted access to every
            project, task, sub-task, milestone, issue and timesheet.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_apms"/>
        <field name="implied_ids"
               eval="[(4, ref('advanced_project_management_system.group_apms_manager')),
                      (4, ref('project.group_project_manager')),
                      (4, ref('project.group_project_stages')),
                      (4, ref('hr_timesheet.group_timesheet_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')),
                                      (4, ref('base.user_admin'))]"/>
    </record>

    <!-- PMO Head and CXO sit on top of the Administrator level and unlock
         the portfolio governance dashboards. -->
    <record id="group_apms_pmo" model="res.groups">
        <field name="name">PMO Head</field>
        <field name="comment">PMO Head: portfolio wide governance, project and
            milestone approvals, the risk and issue registers and the PMO
            dashboard.</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_apms"/>
        <field name="implied_ids"
               eval="[(4, ref('advanced_project_management_system.group_apms_admin'))]"/>
    </record>

    <record id="group_apms_cxo" model="res.groups">
        <field name="name">CXO</field>
        <field name="comment">CXO: executive portfolio view, strategic
            milestones, the risk heatmap, resource capacity and the CXO
            dashboard.</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_apms"/>
        <field name="implied_ids"
               eval="[(4, ref('advanced_project_management_system.group_apms_pmo'))]"/>
    </record>

    <!-- Legacy feature groups kept for backward compatibility -->
    <record id="ir_attachment_group_user" model="res.groups">
        <field name="name">Access Project Document</field>
    </record>
    <record id="group_project_category" model="res.groups">
        <field name="name">Access Project Category Menu</field>
    </record>

    <data noupdate="1">
        <!-- ============================================================= -->
        <!-- Record rules                                                  -->
        <!--                                                               -->
        <!-- These are *global* rules on purpose. Odoo ORs the rules that   -->
        <!-- are attached to a group and ANDs the global ones, so a group   -->
        <!-- rule could never narrow what the standard project rules        -->
        <!-- already grant. Each domain therefore branches on the level of  -->
        <!-- the current user. Portal / shared users are left to the        -->
        <!-- standard portal rules.                                         -->
        <!-- ============================================================= -->

        <!-- ========== Tasks and sub-tasks ========== -->
        <record id="apms_task_level_rule" model="ir.rule">
            <field name="name">APMS: tasks and sub-tasks visible by access level</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') else (['|', '|', '|', ('user_ids', 'in', user.id), ('parent_id.user_ids', 'in', user.id), ('project_id.user_id', '=', user.id), ('project_id.message_partner_ids', 'in', [user.partner_id.id])] if user.has_group('advanced_project_management_system.group_apms_manager') else ['|', '|', ('user_ids', 'in', user.id), ('parent_id.user_ids', 'in', user.id), ('create_uid', '=', user.id)])</field>
        </record>

        <record id="apms_task_unlink_rule" model="ir.rule">
            <field name="name">APMS: only managers and administrators delete tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') or user.has_group('advanced_project_management_system.group_apms_manager') else [(0, '=', 1)]</field>
        </record>

        <!-- ========== Milestones ========== -->
        <record id="apms_milestone_level_rule" model="ir.rule">
            <field name="name">APMS: milestones visible by access level</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') else ['|', '|', ('project_id.user_id', '=', user.id), ('project_id.message_partner_ids', 'in', [user.partner_id.id]), ('task_ids.user_ids', 'in', user.id)]</field>
        </record>

        <record id="apms_milestone_readonly_rule" model="ir.rule">
            <field name="name">APMS: milestones are read only for the user level</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') or user.has_group('advanced_project_management_system.group_apms_manager') else [(0, '=', 1)]</field>
        </record>

        <!-- ========== Timesheets ========== -->
        <!-- Analytic lines that are not linked to a project (pure accounting
             analytic lines) are deliberately left untouched. -->
        <record id="apms_timesheet_level_rule" model="ir.rule">
            <field name="name">APMS: timesheets visible by access level</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') else (['|', '|', '|', ('project_id', '=', False), ('user_id', '=', user.id), ('project_id.user_id', '=', user.id), ('project_id.message_partner_ids', 'in', [user.partner_id.id])] if user.has_group('advanced_project_management_system.group_apms_manager') else ['|', ('project_id', '=', False), ('user_id', '=', user.id)])</field>
        </record>

        <record id="apms_timesheet_unlink_rule" model="ir.rule">
            <field name="name">APMS: the user level only deletes its own timesheets</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') or user.has_group('advanced_project_management_system.group_apms_manager') else ['|', ('project_id', '=', False), ('user_id', '=', user.id)]</field>
        </record>

        <!-- ========== Project issues ========== -->
        <record id="apms_issue_company_rule" model="ir.rule">
            <field name="name">Project Issue: multi-company</field>
            <field name="model_id" ref="model_project_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="apms_issue_level_rule" model="ir.rule">
            <field name="name">APMS: issues visible by access level</field>
            <field name="model_id" ref="model_project_issue"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') else (['|', '|', ('user_id', '=', user.id), ('create_uid', '=', user.id), ('project_id.user_id', '=', user.id)] if user.has_group('advanced_project_management_system.group_apms_manager') else ['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)])</field>
        </record>

        <record id="apms_risk_company_rule" model="ir.rule">
            <field name="name">Project Risk: multi-company</field>
            <field name="model_id" ref="model_project_risk"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="apms_risk_level_rule" model="ir.rule">
            <field name="name">APMS: risks visible by access level</field>
            <field name="model_id" ref="model_project_risk"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') else (['|', '|', ('owner_id', '=', user.id), ('create_uid', '=', user.id), ('project_id.user_id', '=', user.id)] if user.has_group('advanced_project_management_system.group_apms_manager') else ['|', '|', ('owner_id', '=', user.id), ('create_uid', '=', user.id), ('task_id.user_ids', 'in', user.id)])</field>
        </record>

        <record id="apms_team_member_level_rule" model="ir.rule">
            <field name="name">APMS: team allocation visible by access level</field>
            <field name="model_id" ref="model_project_team_member"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.share or user.has_group('project.group_project_manager') or user.has_group('advanced_project_management_system.group_apms_manager') else [(0, '=', 1)]</field>
        </record>
    </data>
</odoo>
