<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Employee Purchase Requisition view -->
    <record id="employee_purchase_requisition_action"
            model="ir.actions.act_window">
        <field name="name">Purchase Requisition</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.purchase.requisition</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>

    <record id="employee_purchase_requisition_view_form" model="ir.ui.view">
        <field name="name">employee.purchase.requisition.view.form</field>
        <field name="model">employee.purchase.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget='statusbar'
                           statusbar_visible='new,waiting_manager_approval,waiting_ra_approval,waiting_finance_approval,approved,purchase_order_created,received'/>
                    <field name="can_manager_approve" invisible="1"/>
                    <field name="can_ra_approve" invisible="1"/>
                    <field name="can_finance_approve" invisible="1"/>

                    <!-- Employee Confirm -->
                    <button name="action_confirm_requisition"
                            class="oe_highlight"
                            invisible="state != 'new'" string="Confirm"
                            type="object"
                            help="Submit for Manager Approval"
                            />

                    <!-- Manager Approval -->
                    <button name="action_manager_approval"
                            class="oe_highlight"
                            invisible="state != 'waiting_manager_approval' or not can_manager_approve"
                            string="Approve" type="object"
                            help="Approve requisition and submit for Revenue Assurance approval"
                            />
                    <button name="action_manager_cancel"
                            invisible="state != 'waiting_manager_approval' or not can_manager_approve"
                            string="Reject" type="object"
                            help="Reject Purchase Requisition"
                            />

                    <!-- Revenue Assurance Approval -->
                    <button name="action_ra_approval"
                            class="oe_highlight"
                            invisible="state != 'waiting_ra_approval' or not can_ra_approve"
                            string="Approve" type="object"
                            help="Approve requisition and submit for Finance approval"
                            />
                    <button name="action_ra_cancel"
                            invisible="state != 'waiting_ra_approval' or not can_ra_approve"
                            string="Reject" type="object"
                            help="Reject Purchase Requisition"
                            />

                    <!-- Finance Approval -->
                    <button name="action_finance_approval" class="oe_highlight"
                            invisible="state not in ['waiting_finance_approval', 'waiting_head_approval'] or not can_finance_approve"
                            string="Approve"
                            type="object"
                            help="Approve Purchase requisition"
                            />
                    <button name="action_finance_cancel"
                            invisible="state not in ['waiting_finance_approval', 'waiting_head_approval'] or not can_finance_approve"
                            string="Reject"
                            type="object"
                            help="Reject Purchase Requisition"
                            />

                    <!-- Create PO (Only once approved by Finance) -->
                    <button name="action_create_purchase_order"
                            class="oe_highlight"
                            invisible="state != 'approved'"
                            string="Create PO"
                            type="object"
                            help="Create Purchase Order"
                            groups="employee_purchase_requisition.material_category_finance_group,employee_purchase_requisition.material_category_admin_group"
                            />
                    <button name="action_receive" class="oe_highlight"
                            invisible="state != 'purchase_order_created'"
                            string="Received"
                            type="object"
                            groups="employee_purchase_requisition.material_category_finance_group,employee_purchase_requisition.material_category_admin_group"
                            />
                    <button name="action_reset_to_draft"
                            invisible="state != 'cancelled'"
                            string="Reset to Draft"
                            type="object"
                            groups="employee_purchase_requisition.material_category_admin_group"
                            />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="get_purchase_order"
                                icon="fa-book"
                                invisible="not purchase_count">
                            <field string="Purchase Order"
                                   name="purchase_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="get_internal_transfer"
                                icon="fa-truck"
                                invisible="not internal_transfer_count">
                            <field string="Internal Transfer"
                                   name="internal_transfer_count"
                                   widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" string="Requested By" readonly="state not in ['new']"/>
                            <field name="dept_id"/>
                            <field name="user_id" readonly="state not in ['new']"/>
                            <field name="req_type" string="Request Type" readonly="state not in ['new']"/>
                            <field name="customer_id" string="Customers" readonly="state not in ['new']" invisible = "req_type != 'customer'"
                                required = "req_type == 'customer'"
                                domain="[('customer_type', 'in', ('customer', 'customer_and_vendor'))]"
                                />
                        </group>
                        <group>
                            <field name="requisition_date" readonly="state not in ['new']"/>
                            <field name="receive_date"/>
                            <field name="requisition_deadline" readonly="state not in ['new']"/>
                            <field name="company_id" readonly="state not in ['new']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requisition Orders ">
                            <field name="requisition_order_ids" readonly="1 if state not in ['new', 'waiting_manager_approval', 'waiting_ra_approval', 'waiting_finance_approval', 'approved'] else 0"/>
                        </page>
                        <page string="Picking Details">
                            <group>
                                <group>
                                    <field name="source_location_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="delivery_type_id" domain="[('company_id', '=', company_id), ('code', '=', 'incoming')]"/>
                                								</group>
                                <group>
                                    <field name="destination_location_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="internal_picking_id" domain="[('company_id', '=', company_id), ('code', '=', 'internal')]"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <group string="Approval Details">
                                    <field name="confirm_id"/>
                                    <field name="confirmed_date"/>
                                    <field name="manager_id"/>
                                    <field name="manager_approval_date"/>
                                    <field name="ra_id"/>
                                    <field name="ra_approval_date"/>
                                    <field name="finance_id"/>
                                    <field name="finance_approval_date"/>
                                </group>
                                <group string="Status Info">
                                    <field name="approval_date" string="Final Approved Date"/>
                                    <field name="rejected_user_id"/>
                                    <field name="reject_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group>
                        <field name="requisition_description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="employee_purchase_requisition_view_tree" model="ir.ui.view">
        <field name="name">employee.purchase.requisition.view.tree</field>
        <field name="model">employee.purchase.requisition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id" string="Requested By"/>
                <field name="dept_id"/>
                <field name="company_id" optional="show"/>
                <field name="customer_id"/>
                <field name="requisition_description"/>
                <field name="user_id"/>
                <field name="requisition_date"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved','received')"
                       decoration-warning="state in ('waiting_manager_approval','waiting_ra_approval','waiting_finance_approval','waiting_head_approval')"
                       decoration-info="state =='purchase_order_created'"
                       decoration-danger="state =='cancelled'"/>
            </list>
        </field>
    </record>

    <record id="employee_purchase_requisition_view_kanban" model="ir.ui.view">
        <field name="name">employee.purchase.requisition.view.kanban</field>
        <field name="model">employee.purchase.requisition</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card">
                                    <div>
                                        <b>
                                            <field name="name"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            <field name="employee_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            <field name="dept_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            <field name="user_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            <field name="requisition_date"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            <field name="state" widget="badge"
                                                   decoration-success="state in
                                            ('approved','received')"
                                                   decoration-warning="state in
                                            ('waiting_manager_approval','waiting_ra_approval','waiting_finance_approval','waiting_head_approval')"
                                                   decoration-info="state
                                            =='purchase_order_created'"
                                                   decoration-danger="state
                                            =='cancelled'"
                                             />
                                        </b>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
