<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Finance > Revenue Assurance flow on customer invoices / vendor bills -->
    <record id="view_move_form_finance_ra" model="ir.ui.view">
        <field name="name">account.move.form.finance.revenue.assurance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Hide standard Confirm for invoices/bills -->
            <xpath expr="(//header/button[@name='action_post'])[2]"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_post'])[2]"
                   position="before">
                <button name="action_confirm_to_finance" string="Confirm"
                        type="object" class="oe_highlight"
                        invisible="state != 'draft' or move_type == 'entry' or not id"/>
                <button name="action_finance_approve" string="Finance Approve"
                        type="object" class="oe_highlight"
                        groups="employee_purchase_requisition.material_category_finance_group"
                        invisible="state != 'finance'"/>
                <button name="action_finance_reject" string="Finance Reject"
                        type="object"
                        groups="employee_purchase_requisition.material_category_finance_group"
                        invisible="state != 'finance'"/>
                <button name="action_revenue_assurance_confirm"
                        string="Confirm" type="object" class="oe_highlight"
                        groups="employee_purchase_requisition.material_category_ra_group"
                        invisible="state != 'revenue_assurance'"/>
            </xpath>
            <xpath expr="//header/field[@name='state'][@widget='statusbar']"
                   position="attributes">
                <attribute name="statusbar_visible">draft,finance,revenue_assurance,posted</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][@widget='account_move_statusbar_secured']"
                   position="attributes">
                <attribute name="statusbar_visible">draft,finance,revenue_assurance,posted</attribute>
            </xpath>
        </field>
    </record>
</odoo>
