<odoo>
    <record id="view_hr_payslip_form_custom_button" model="ir.ui.view">
        <field name="name">hr.payslip.form.custom.button</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_custom_payslip"
                    type="object"
                    string="Print Payslip"
                    class="btn-primary"
                    icon="fa-print"
                />
            </xpath>
            <xpath expr="//button[@name='action_print_payslip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
