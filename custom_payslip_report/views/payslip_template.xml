<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="payslip_custom_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size:11px;">

                    <!-- HEADER -->
                    <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                        <tr style="background:#2f5597; color:white;">
                            <td colspan="8" style="padding:8px; text-align:center; font-weight:bold;">
                                Payslip for the Month of
                                <t t-esc="o.date_to.strftime('%B %Y') if o.date_to else ''"/><br/>
                                Pay Period
                                <t t-esc="o.date_from.strftime('%d.%m.%Y') if o.date_from else ''"/>
                                to
                                <t t-esc="o.date_to.strftime('%d.%m.%Y') if o.date_to else ''"/><br/>
                                <t t-esc="o.employee_id.name"/>
                            </td>
                            <td colspan="2" style="background:#d9d9d9; text-align:center; color:#000; padding:6px; vertical-align:middle;">
                                <t t-set="comp" t-value="o.company_id or o.employee_id.company_id"/>
                                <t t-if="comp and comp.logo">
                                    <img t-att-src="image_data_uri(comp.logo)" style="max-height:45px; max-width:140px; display:block; margin:0 auto 4px auto;"/>
                                </t>
                                <b style="font-size:12px;"><t t-esc="comp.name if comp else 'BXI Tech'"/></b><br/>
                                <span style="font-size:9px;">Technology Brilliance<br/>Service First Mindset</span>
                            </td>
                        </tr>
                    </table>

                    <!-- EMPLOYEE DETAILS & CALCULATED VALUES -->
                    <t t-set="total_month_days" t-value="(o.date_to - o.date_from).days + 1 if (o.date_to and o.date_from) else 30"/>
                    <t t-set="lwp_count" t-value="sum(o.input_line_ids.filtered(lambda l: l.code in ('LWP_DAYS', 'LWP')).mapped('amount')) or sum(o.worked_days_line_ids.filtered(lambda l: l.code in ('LWP', 'UNPAID')).mapped('number_of_days')) or 0"/>
                    <t t-set="work_100" t-value="sum(o.worked_days_line_ids.filtered(lambda l: l.code not in ('LWP', 'UNPAID')).mapped('number_of_days'))"/>
                    <t t-set="days_worked" t-value="work_100 if work_100 else (total_month_days - lwp_count)"/>

                    <t t-set="basic_std" t-value="o.employee_id.l10n_in_basic_salary_amount or 0.0"/>
                    <t t-set="hra_std" t-value="o.employee_id.l10n_in_hra or 0.0"/>
                    <t t-set="spl_std" t-value="o.employee_id.l10n_in_fixed_allowance or 0.0"/>
                    <t t-set="tot_std" t-value="basic_std + hra_std + spl_std"/>

                    <t t-set="basic_earn" t-value="sum(o.line_ids.filtered(lambda l: l.code == 'BASIC').mapped('total')) or 0.0"/>
                    <t t-set="hra_earn" t-value="sum(o.line_ids.filtered(lambda l: l.code == 'HRA').mapped('total')) or 0.0"/>
                    <t t-set="spl_earn" t-value="sum(o.line_ids.filtered(lambda l: l.code in ('SPL', 'FLEX')).mapped('total')) or 0.0"/>
                    <t t-set="ara_earn" t-value="abs(sum(o.line_ids.filtered(lambda l: l.code == 'ARA').mapped('total'))) or 0.0"/>
                    <t t-set="gross_earn" t-value="sum(o.line_ids.filtered(lambda l: l.category_id.code == 'GROSS').mapped('total')) or (basic_earn + hra_earn + spl_earn + ara_earn)"/>

                    <t t-set="mip_ded" t-value="abs(sum(o.line_ids.filtered(lambda l: l.code == 'MIP').mapped('total'))) or 0.0"/>
                    <t t-set="ee_pf_val" t-value="abs(sum(o.line_ids.filtered(lambda l: l.code in ('PF', 'EPF', 'EE_PF')).mapped('total'))) or 0.0"/>
                    <t t-set="tds_ded" t-value="abs(sum(o.line_ids.filtered(lambda l: l.code == 'TDS').mapped('total'))) or 0.0"/>
                    <t t-set="other_ded" t-value="abs(sum(o.line_ids.filtered(lambda l: l.code == 'DEDUCTION').mapped('total'))) or 0.0"/>

                    <t t-set="cat_ded_total" t-value="abs(sum(o.line_ids.filtered(lambda l: l.category_id.code == 'DED').mapped('total'))) or 0.0"/>
                    <t t-set="items_ded_total" t-value="mip_ded + ee_pf_val + tds_ded + other_ded"/>
                    <t t-set="gross_ded" t-value="items_ded_total if items_ded_total &gt; 0 else cat_ded_total"/>

                    <t t-set="net_pay" t-value="gross_earn - gross_ded"/>
                    <t t-set="er_pf_val" t-value="ee_pf_val if ee_pf_val else (o.employee_id.l10n_in_pf_employer_amount or 0.0)"/>
                    <t t-set="nps_val" t-value="o.employee_id.nps_contribution if o.employee_id.nps_contribution else (abs(sum(o.line_ids.filtered(lambda l: l.code in ('NPS', 'ERNPS', 'ER_NPS', 'EE_NPS')).mapped('total'))) or 0.0)"/>

                    <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                        <tr>
                            <td style="border:1px solid #000; width:20%;"><b> Employee No/Name </b></td>
                            <td style="border:1px solid #000; width:30%;"><t t-esc="o.employee_id.employee_code or ''"/> / <t t-esc="o.employee_id.name or ''"/></td>
                            <td style="border:1px solid #000; width:20%;"><b> Bank Name and Account No </b></td>
                            <td style="border:1px solid #000; width:30%;">
                                <t t-if="o.employee_id.bank_account_ids">
                                    <t t-foreach="o.employee_id.bank_account_ids" t-as="l">
                                        <span t-field="l.bank_id.name"/>, <span t-field="l.acc_number"/>
                                    </t>
                                </t>
                                <t t-else="">
                                    <t t-esc="o.employee_id.bank_name or ''"/> <t t-if="o.employee_id.bank_account_number">, <t t-esc="o.employee_id.bank_account_number"/></t>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>Designation</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.job_title or ''"/></td>
                            <td style="border:1px solid #000;"><b>Location</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.psa or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>DOJ / Gender</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.emp_date_of_joining or ''"/>, <t t-esc="dict(o.employee_id._fields['sex'].selection).get(o.employee_id.sex, o.employee_id.sex) if o.employee_id.sex else ''"/></td>
                            <td style="border:1px solid #000;"><b>Department</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.department_id.name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>PAN Number</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.l10n_in_pan or ''"/></td>
                            <td style="border:1px solid #000;"><b>Band</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.role_band or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>Medical Insurance No</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.medical_insurance_no or ''"/></td>
                            <td style="border:1px solid #000;"><b>Day Worked in Months</b></td>
                            <td style="border:1px solid #000;">
                                <t t-esc="round(days_worked)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>PF / Pension No</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.epf_number or o.employee_id.pf_number or ''"/></td>
                            <td style="border:1px solid #000;"><b>LWP Current / Previous</b></td>
                            <td style="border:1px solid #000;">
                                <t t-esc="round(lwp_count)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>UAN No</b></td>
                            <td style="border:1px solid #000;"><t t-esc="o.employee_id.l10n_in_uan or ''"/></td>
                            <td style="border:1px solid #000;"><b>Sabbatical Leave</b></td>
                            <td style="border:1px solid #000;"></td>
                        </tr>
                    </table>

                    <!-- EARNINGS / DEDUCTIONS -->
                    <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                        <tr>
                            <th style="border:1px solid #000;"><b>Standard Monthly Salary</b></th>
                            <th style="border:1px solid #000;"><b>INR</b></th>
                            <th style="border:1px solid #000;"><b>Earnings</b></th>
                            <th style="border:1px solid #000;"><b>INR</b></th>
                            <th style="border:1px solid #000;"><b>Deductions</b></th>
                            <th style="border:1px solid #000;"><b>INR</b></th>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>Basic Salary</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % basic_std"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Basic Salary</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % basic_earn"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Medical Premium</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % mip_ded"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>HRA</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % hra_std"/>
                            </td>
                            <td style="border:1px solid #000;"><b>HRA</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % hra_earn"/>
                            </td>
                            <td style="border:1px solid #000;"><b>EE PF Monthly</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % ee_pf_val"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;"><b>Flexible Allowance</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % spl_std"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Flexible Allowance</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % spl_earn"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Income Tax</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % tds_ded"/>
                            </td>
                        </tr>
                        <!-- Arrear / Deduction Row (Conditional) -->
                        <t t-if="o.line_ids.filtered(lambda l: l.code in ('ARA', 'DEDUCTION'))">
                            <tr>
                                <td style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;"><b>Arrear Allowance</b></td>
                                <td style="border:1px solid #000;">
                                    <t t-esc="'%.2f' % ara_earn"/>
                                </td>
                                <td style="border:1px solid #000;"><b>Deduction</b></td>
                                <td style="border:1px solid #000;">
                                    <t t-esc="'%.2f' % other_ded"/>
                                </td>
                            </tr>
                        </t>

                        <tr>
                            <td style="border:1px solid #000;"><b>Total Standard Salary</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % tot_std"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Gross Earning</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % gross_earn"/>
                            </td>
                            <td style="border:1px solid #000;"><b>Gross Deduction</b></td>
                            <td style="border:1px solid #000;">
                              <t t-esc="'%.2f' % gross_ded"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4"></td>
                            <td style="border:1px solid #000;"><b>Net Pay</b></td>
                            <td style="border:1px solid #000;"><b>
                              <t t-esc="'%.2f' % net_pay"/>
                              </b></td>
                        </tr>
                    </table>

                    <!-- INCOME TAX COMPUTATION -->
                    <table style="width:100%; border-collapse:collapse; border:1px solid #000;">
                        <tr>
                            <th colspan="4" style="border:1px solid #000;">Income Tax Computation</th>
                        </tr>

                        <tr>
                            <td style="border:1px solid #000;"><b>Exception U/S 10</b></td>
                            <td style="border:1px solid #000;"><b>Project / Actual Taxable Salary</b></td>
                            <td style="border:1px solid #000;"><b>Contribution under Chapter VI A</b></td>
                            <td style="border:1px solid #000;"><b>Monthly Tax Deduction</b></td>
                        </tr>
                        <tr style="height:180px;">
                            <td style="border:1px solid #000; vertical-align:top;">
                                <b>ER PF Monthly :</b>
                                <t t-esc="'%.2f' % er_pf_val"/>
                                <br/><br/>
                                <b>ER NPS Monthly :</b>
                                <t t-esc="'%.2f' % nps_val"/>
                                <br/><br/>
                            </td>

                            <td style="border:1px solid #000; vertical-align:top;">
                                Taxable Income till Prv. Month<br/>
                                Income Mth Taxable Income<br/>
                                Projected Standard Salary<br/>
                                Taxable Ann Perk<br/>
                                NPS ER Contribution<br/>
                                Gross Salary<br/>
                                Standard Deduction<br/>
                                Exemption U/S 10<br/>
                                Tax on Employment (Prof Tax)<br/>
                                Income under Head Salary<br/>
                                Int. on House Property / Other Income<br/>
                                Gross Total Income<br/>
                                Agg. of Chapter VI<br/>
                                Tax on Total Income<br/>
                                Tax Credit<br/>
                                Health and Education cess<br/>
                                Tax Payable<br/>
                                Tax Deducted so far<br/>
                                Balance Tax
                            </td>
                            <td style="border:1px solid #000; vertical-align:top;">
                                Provident Fund<br/>
                                Voluntary Fund<br/>
                                Employer NPS<br/>
                                Employee NPS
                            </td>
                            <td style="border:1px solid #000; vertical-align:top; padding:6px;">

                                <!-- Financial Year Start -->
                                <t t-set="fy_start_year"
                                   t-value="o.date_from.year if o.date_from and o.date_from.month &gt;= 4 else (o.date_from.year - 1 if o.date_from else 2025)"/>

                                <!-- All employee slips -->
                                <t t-set="all_slips" t-value="o.employee_id.slip_ids"/>

                                <!-- April to December -->
                                <t t-foreach="[4,5,6,7,8,9,10,11,12]" t-as="m">
                                    <t t-set="month_date" t-value="datetime.date(fy_start_year, m, 1)"/>

                                    <!-- Skip future months -->
                                    <t t-if="o.date_from and month_date &lt;= o.date_from">

                                        <t t-set="month_slip"
                                           t-value="all_slips.filtered(
                                               lambda s:
                                                   s.date_from
                                                   and s.date_from.month == m
                                                   and s.date_from.year == fy_start_year
                                                   and s.date_from &lt;= o.date_from
                                           )"/>

                                        <t t-set="month_tax"
                                           t-value="abs(sum(
                                               month_slip.mapped('line_ids')
                                               .filtered(lambda l: l.code == 'TDS')
                                               .mapped('total')
                                           )) or 0"/>

                                        <span>
                                            <t t-esc="month_date.strftime('%B')"/>'<t t-esc="str(month_date.year)[-2:]"/> :
                                            <t t-esc="'%.2f' % month_tax"/>
                                        </span>
                                        <br/>
                                    </t>
                                </t>

                                <!-- January to March -->
                                <t t-foreach="[1,2,3]" t-as="m">
                                    <t t-set="month_date" t-value="datetime.date(fy_start_year + 1, m, 1)"/>

                                    <!-- Skip future months -->
                                    <t t-if="o.date_from and month_date &lt;= o.date_from">

                                        <t t-set="month_slip"
                                           t-value="all_slips.filtered(
                                               lambda s:
                                                   s.date_from
                                                   and s.date_from.month == m
                                                   and s.date_from.year == fy_start_year + 1
                                                   and s.date_from &lt;= o.date_from
                                           )"/>

                                        <t t-set="month_tax"
                                           t-value="abs(sum(
                                               month_slip.mapped('line_ids')
                                               .filtered(lambda l: l.code == 'TDS')
                                               .mapped('total')
                                           )) or 0"/>

                                        <span>
                                            <t t-esc="month_date.strftime('%B')"/>'<t t-esc="str(month_date.year)[-2:]"/> :
                                            <t t-esc="'%.2f' % month_tax"/>
                                        </span>
                                        <br/>
                                    </t>
                                </t>

                            </td>

                        </tr>
                    </table>

                    <!-- FOOTER -->
                    <p style="font-size:9px;">
                        *This is a computer-generated payslip and does not require a signature or company seal.<br/>
                        *One-time payments are subject to applicable tax slab.<br/>
                        *Refer EPF portal for Pension details.
                    </p>

                </div>
            </t>
        </t>
    </template>
</odoo>
