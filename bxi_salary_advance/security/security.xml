<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_salary_advance">
        <field name="name">Salary Advance</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Every employee applies and Reporting Managers approve their team's requests,
         so neither needs a dedicated group. -->
    <record id="group_salary_advance_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_salary_advance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salary_advance_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_salary_advance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salary_advance_hr_head" model="res.groups">
        <field name="name">HR Head</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_salary_advance"/>
        <field name="implied_ids" eval="[(4, ref('group_salary_advance_hr'))]"/>
    </record>

    <record id="group_salary_advance_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_salary_advance"/>
        <field name="implied_ids" eval="[(4, ref('group_salary_advance_hr_head')), (4, ref('group_salary_advance_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Record rules ──────────────────────────────────────────────── -->
    <record id="bxi_salary_advance_rule_own" model="ir.rule">
        <field name="name">Salary Advance: own, team and exceptions to approve</field>
        <field name="model_id" ref="model_bxi_salary_advance"/>
        <field name="domain_force">['|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('manager_id.user_id', '=', user.id),
            ('exception_approver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_salary_advance_rule_all" model="ir.rule">
        <field name="name">Salary Advance: all</field>
        <field name="model_id" ref="model_bxi_salary_advance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_salary_advance_hr')), (4, ref('group_salary_advance_finance'))]"/>
    </record>

    <record id="bxi_salary_advance_installment_rule_own" model="ir.rule">
        <field name="name">Salary Advance EMI: own and team</field>
        <field name="model_id" ref="model_bxi_salary_advance_installment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('advance_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_salary_advance_installment_rule_all" model="ir.rule">
        <field name="name">Salary Advance EMI: all</field>
        <field name="model_id" ref="model_bxi_salary_advance_installment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_salary_advance_hr')), (4, ref('group_salary_advance_finance'))]"/>
    </record>

    <!-- ── Multi-company ─────────────────────────────────────────────── -->
    <record id="bxi_salary_advance_comp_rule" model="ir.rule">
        <field name="name">Salary Advance: multi-company</field>
        <field name="model_id" ref="model_bxi_salary_advance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bxi_salary_advance_installment_comp_rule" model="ir.rule">
        <field name="name">Salary Advance EMI: multi-company</field>
        <field name="model_id" ref="model_bxi_salary_advance_installment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
