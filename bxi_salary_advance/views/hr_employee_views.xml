<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_inherit_salary_advance" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.salary.advance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_salary_advances" type="object" class="oe_stat_button" icon="fa-money"
                        groups="bxi_salary_advance.group_salary_advance_hr,bxi_salary_advance.group_salary_advance_finance">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="sa_outstanding_balance" widget="monetary"/></span>
                        <span class="o_stat_text">Salary Advances (<field name="sa_advance_count"/>)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
