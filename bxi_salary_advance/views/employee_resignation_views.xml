<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_resignation_form_inherit_salary_advance" model="ir.ui.view">
        <field name="name">employee.resignation.form.inherit.salary.advance</field>
        <field name="model">employee.resignation</field>
        <field name="inherit_id" ref="employee_onboarding.view_employee_resignation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sa_currency_id" invisible="1"/>
                <field name="sa_advance_ids" invisible="1"/>
                <button name="action_open_salary_advances" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not sa_advance_ids" help="Salary advances recovered in the Full &amp; Final Settlement"
                        groups="bxi_salary_advance.group_salary_advance_hr,bxi_salary_advance.group_salary_advance_finance">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="sa_outstanding_balance" widget="monetary" options="{'currency_field': 'sa_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Salary Advance Dues</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
