<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bxi_salary_advance_installment_list" model="ir.ui.view">
        <field name="name">bxi.salary.advance.installment.list</field>
        <field name="model">bxi.salary.advance.installment</field>
        <field name="arch" type="xml">
            <list string="Salary Advance EMIs" create="0" edit="0" delete="0"
                  decoration-muted="state == 'deducted'" decoration-warning="is_fnf">
                <field name="advance_id"/>
                <field name="employee_id"/>
                <field name="category" optional="show"/>
                <field name="sequence"/>
                <field name="due_date" widget="date" options="{'format': 'MMMM yyyy'}"/>
                <field name="amount" sum="Total"/>
                <field name="amount_recovered" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payslip_id"/>
                <field name="is_fnf" optional="show"/>
                <field name="move_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'deducted'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_salary_advance_installment_search" model="ir.ui.view">
        <field name="name">bxi.salary.advance.installment.search</field>
        <field name="model">bxi.salary.advance.installment</field>
        <field name="arch" type="xml">
            <search string="Salary Advance EMIs">
                <field name="employee_id"/>
                <field name="advance_id"/>
                <field name="payslip_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="deducted" string="Deducted" domain="[('state', '=', 'deducted')]"/>
                <filter name="fnf" string="Full &amp; Final Settlement" domain="[('is_fnf', '=', True)]"/>
                <separator/>
                <filter name="due_date" string="Payroll Month" date="due_date"/>
                <group>
                    <filter name="group_month" string="Payroll Month" context="{'group_by': 'due_date:month'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bxi_salary_advance_installment_pivot" model="ir.ui.view">
        <field name="name">bxi.salary.advance.installment.pivot</field>
        <field name="model">bxi.salary.advance.installment</field>
        <field name="arch" type="xml">
            <pivot string="Salary Advance EMIs">
                <field name="due_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_bxi_salary_advance_installment" model="ir.actions.act_window">
        <field name="name">EMI Recoveries</field>
        <field name="res_model">bxi.salary.advance.installment</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_pending': 1, 'search_default_group_month': 1}</field>
    </record>

</odoo>
