<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         DeskTime Config Form View
    ============================================================ -->
    <record id="view_bxi_desktime_config_form" model="ir.ui.view">
        <field name="name">bxi.desktime.config.form</field>
        <field name="model">bxi.desktime.config</field>
        <field name="arch" type="xml">
            <form string="DeskTime Configuration">
                <header>
                    <button name="action_sync_now" string="Sync Today Now" type="object" class="oe_highlight"/>
                    <button name="action_sync_for_date" string="Sync Custom Date" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. DeskTime Main Integration"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Access">
                            <field name="api_key" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Settings &amp; Company">
                            <field name="default_project_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Sync History" name="sync_history">
                        <group>
                            <field name="last_sync_datetime"/>
                            <field name="last_sync_date"/>
                        </group>
                        <group>
                            <field name="last_sync_status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         DeskTime Config List View
    ============================================================ -->
    <record id="view_bxi_desktime_config_list" model="ir.ui.view">
        <field name="name">bxi.desktime.config.list</field>
        <field name="model">bxi.desktime.config</field>
        <field name="arch" type="xml">
            <list string="DeskTime Configurations">
                <field name="name"/>
                <field name="active"/>
                <field name="last_sync_datetime"/>
                <field name="last_sync_status"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         DeskTime Config Action
    ============================================================ -->
    <record id="action_bxi_desktime_config" model="ir.actions.act_window">
        <field name="name">DeskTime Configurations</field>
        <field name="res_model">bxi.desktime.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new DeskTime integration configuration.
            </p>
        </field>
    </record>

    <!-- ============================================================
         DeskTime Sync Wizard Form View
    ============================================================ -->
    <record id="view_bxi_desktime_sync_wizard_form" model="ir.ui.view">
        <field name="name">bxi.desktime.sync.wizard.form</field>
        <field name="model">bxi.desktime.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync DeskTime Date">
                <group>
                    <field name="config_id" readonly="1" options="{'no_open': True}"/>
                    <field name="sync_date"/>
                </group>
                <footer>
                    <button name="action_sync" string="Start Sync" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
