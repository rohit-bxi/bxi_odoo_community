<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         DeskTime Daily Log Form View
    ============================================================ -->
    <record id="view_bxi_desktime_log_form" model="ir.ui.view">
        <field name="name">bxi.desktime.log.form</field>
        <field name="model">bxi.desktime.log</field>
        <field name="arch" type="xml">
            <form string="DeskTime Daily Log" create="false" edit="false">
                <header>
                    <button name="action_view_timesheet" string="View Timesheet" type="object" class="oe_highlight" invisible="not timesheet_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1>
                            <field name="employee_id" options="{'no_open': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identity Details">
                            <field name="date"/>
                            <field name="department_id"/>
                            <field name="config_id" options="{'no_open': True}"/>
                            <field name="is_absent"/>
                            <field name="suspicious_count"/>
                        </group>
                        <group string="DeskTime Raw Info">
                            <field name="desktime_name"/>
                            <field name="desktime_email"/>
                            <field name="desktime_employee_id"/>
                            <field name="timezone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Arrived &amp; Left times">
                            <field name="arrived"/>
                            <field name="left"/>
                            <field name="is_late"/>
                        </group>
                        <group string="Linked Timesheet">
                            <field name="timesheet_id"/>
                            <field name="timesheet_unit_amount"/>
                        </group>
                    </group>
                    <group string="Time &amp; Performance Metrics">
                        <group string="Hours tracked">
                            <field name="at_work_hours"/>
                            <field name="online_hours"/>
                            <field name="offline_hours"/>
                            <field name="productive_hours"/>
                            <field name="desktime_hours"/>
                            <field name="unproductive_hours"/>
                            <field name="neutral_hours"/>
                        </group>
                        <group string="Efficiency Scores">
                            <field name="productivity"/>
                            <field name="efficiency"/>
                            <field name="active_level"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw API Data">
                            <field name="raw_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         DeskTime Daily Log List View
    ============================================================ -->
    <record id="view_bxi_desktime_log_list" model="ir.ui.view">
        <field name="name">bxi.desktime.log.list</field>
        <field name="model">bxi.desktime.log</field>
        <field name="arch" type="xml">
            <list string="DeskTime Daily Logs" create="false" edit="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="arrived"/>
                <field name="left"/>
                <field name="at_work_hours" sum="Total Hours"/>
                <field name="productive_hours" sum="Total Productive Hours"/>
                <field name="productivity" avg="Avg Productivity"/>
                <field name="is_late" widget="boolean_toggle"/>
                <field name="is_absent" optional="hide"/>
                <field name="desktime_hours" optional="hide"/>
                <field name="unproductive_hours" optional="hide"/>
                <field name="neutral_hours" optional="hide"/>
                <field name="active_level" optional="hide"/>
                <field name="suspicious_count" optional="hide"/>
                <field name="timesheet_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         DeskTime Daily Log Search View
    ============================================================ -->
    <record id="view_bxi_desktime_log_search" model="ir.ui.view">
        <field name="name">bxi.desktime.log.search</field>
        <field name="model">bxi.desktime.log</field>
        <field name="arch" type="xml">
            <search string="Search DeskTime Logs">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <separator/>
                <filter string="Late Arrivals" name="late" domain="[('is_late', '=', True)]"/>
                <filter string="Timesheet Created" name="has_timesheet" domain="[('timesheet_id', '!=', False)]"/>
                <filter string="No Timesheet" name="no_timesheet" domain="[('timesheet_id', '=', False)]"/>
                <separator/>
                <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>


    <!-- ============================================================
         DeskTime Daily Log Action
    ============================================================ -->
    <record id="action_bxi_desktime_log" model="ir.actions.act_window">
        <field name="name">DeskTime Logs</field>
        <field name="res_model">bxi.desktime.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bxi_desktime_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No DeskTime sync logs found.
            </p>
            <p>
                Logs will populate automatically once the scheduled sync runs or a manual sync is completed.
            </p>
        </field>
    </record>

</odoo>
