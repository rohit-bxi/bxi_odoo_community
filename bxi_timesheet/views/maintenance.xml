<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         TIMESHEET MAINTENANCE MODE (DISABLED - RESTORED FOR ALL USERS)
         All Timesheet menus and actions are restored to their normal
         access groups for all users.
         ============================================================ -->

    <!-- Form View for Maintenance Popup Dialog -->
    <record id="view_timesheet_maintenance_warning_form" model="ir.ui.view">
        <field name="name">timesheet.maintenance.warning.form</field>
        <field name="model">timesheet.maintenance.warning</field>
        <field name="arch" type="xml">
            <form string="Notice">
                <div class="alert alert-warning d-flex align-items-center" role="alert" style="font-size: 15px; margin: 15px 0; border-left: 5px solid #f0ad4e;">
                    <div style="font-size: 15px; font-weight: 500; color: #856404; line-height: 1.5;">
                        Due to maintenance, the module is currently not working. We will inform once the maintenance is completed.
                    </div>
                </div>
                <footer>
                    <button string="OK" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action for the Maintenance Popup Dialog -->
    <record id="action_timesheet_maintenance_popup" model="ir.actions.act_window">
        <field name="name">Maintenance Notice</field>
        <field name="res_model">timesheet.maintenance.warning</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_timesheet_maintenance_warning_form"/>
    </record>

    <!-- Server Action: Open Timesheet Dashboard for All Users -->
    <record id="action_timesheet_menu_entry" model="ir.actions.server">
        <field name="name">Timesheet Menu Entry</field>
        <field name="model_id" ref="model_timesheet_maintenance_warning"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('bxi_timesheet.action_bxi_timesheet_dashboard').sudo().read()[0]
        </field>
    </record>

    <!-- Restore Timesheets Main Menu (clear maintenance action so default first submenu opens) -->
    <record id="hr_timesheet.timesheet_menu_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <!-- Restore child menus and their normal security groups for all users -->
    <record id="bxi_timesheet.menu_bxi_timesheet_dashboard" model="ir.ui.menu">
        <field name="action" ref="bxi_timesheet.action_bxi_timesheet_dashboard"/>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.clear()]"/>
    </record>

    <record id="hr_timesheet.timesheet_menu_activity_user" model="ir.ui.menu">
        <field name="action" ref="hr_timesheet.act_hr_timesheet_line"/>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('hr_timesheet.group_hr_timesheet_user')])]"/>
    </record>

    <record id="hr_timesheet.menu_hr_time_tracking" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.clear()]"/>
    </record>

    <record id="bxi_timesheet.menu_bxi_timesheet_team_approvals" model="ir.ui.menu">
        <field name="action" ref="bxi_timesheet.action_bxi_timesheet_approvals"/>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('hr_timesheet.group_hr_timesheet_approver')])]"/>
    </record>

    <record id="bxi_timesheet.menu_bxi_timesheet_admin_approvals" model="ir.ui.menu">
        <field name="action" ref="bxi_timesheet.action_bxi_timesheet_admin_approvals"/>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_system'), ref('hr_timesheet.group_timesheet_manager')])]"/>
    </record>

    <record id="bxi_timesheet.menu_bxi_desktime_root" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('hr_timesheet.group_timesheet_manager')])]"/>
    </record>

    <record id="bxi_timesheet.menu_bxi_timesheet_reporting" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_erp_manager'), ref('base.group_system')])]"/>
    </record>

    <record id="hr_timesheet.menu_timesheets_reports" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('hr_timesheet.group_hr_timesheet_approver')])]"/>
    </record>

    <record id="hr_timesheet.hr_timesheet_menu_configuration" model="ir.ui.menu">
        <field name="action" ref="hr_timesheet.hr_timesheet_config_settings_action"/>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[Command.set([ref('hr_timesheet.group_timesheet_manager')])]"/>
    </record>

</odoo>
