<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Form View for Timesheet Line Approval -->
    <record id="view_bxi_analytic_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form.bxi</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Timesheet Approval Details">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'submitted'" groups="hr.group_hr_user,hr.group_hr_manager,hr_timesheet.group_hr_timesheet_approver,hr_timesheet.group_timesheet_manager"/>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-danger" invisible="state != 'submitted'" groups="hr.group_hr_user,hr.group_hr_manager,hr_timesheet.group_hr_timesheet_approver,hr_timesheet.group_timesheet_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Timesheet Information">
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="timesheet_category_id" string="Category (L1)" readonly="1"/>
                            <field name="timesheet_activity_id" string="Predefined Activity (L2)" invisible="not timesheet_activity_id" readonly="1"/>
                            <field name="lead_id" string="CRM Lead (L2)" invisible="not lead_id" readonly="1"/>
                            <field name="project_id" string="Project (L2)" invisible="not project_id" readonly="1"/>
                            <field name="task_id" string="Task" invisible="not task_id" readonly="1"/>
                            <field name="l2_activity_name" string="Activity (L2)" readonly="1"/>
                        </group>
                        <group string="Details">
                            <field name="unit_amount" string="Duration (Hours)" widget="float_time" readonly="1"/>
                            <field name="name" string="Description (L3)" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approval Remarks">
                        <field name="remarks" string="Manager Remarks" placeholder="Enter remarks for approval or refusal (optional)..." readonly="state in ('approved', 'refused')"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Custom Tree/List View for Timesheet Approval -->
    <record id="view_bxi_analytic_line_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.bxi</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Timesheet Approvals" 
                  decoration-muted="state == 'refused'" 
                  decoration-info="state == 'submitted'" 
                  decoration-success="state == 'approved'"
                  create="true" 
                  edit="true">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="timesheet_category_id" string="Category (L1)"/>
                <field name="l2_activity_name" string="Activity (L2)"/>
                <field name="name" string="Description (L3)"/>
                <field name="unit_amount" widget="float_time" sum="Total Hours"/>
                <field name="remarks" string="Manager Remarks"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'submitted'" 
                       decoration-success="state == 'approved'" 
                       decoration-warning="state == 'refused'"/>
            </list>
        </field>
    </record>

    <!-- Action for Manager Team Approvals -->
    <record id="action_bxi_timesheet_approvals" model="ir.actions.act_window">
        <field name="name">Team Approvals</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted'), ('employee_id.parent_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No timesheets pending approval from your team.
            </p>
        </field>
    </record>

    <!-- Action for Admin Approvals -->
    <record id="action_bxi_timesheet_admin_approvals" model="ir.actions.act_window">
        <field name="name">Admin Approvals</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No timesheets pending approval.
            </p>
        </field>
    </record>

    <!-- Bind custom tree and form view IDs to action -->
    <record id="action_bxi_timesheet_approvals_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bxi_analytic_line_tree"/>
        <field name="act_window_id" ref="action_bxi_timesheet_approvals"/>
    </record>

    <record id="action_bxi_timesheet_approvals_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bxi_analytic_line_form"/>
        <field name="act_window_id" ref="action_bxi_timesheet_approvals"/>
    </record>

    <!-- Server Actions for Bulk Approval and Rejection -->
    <record id="action_server_bxi_timesheet_approve" model="ir.actions.server">
        <field name="name">Approve Timesheets</field>
        <field name="model_id" ref="model_account_analytic_line"/>
        <field name="binding_model_id" ref="model_account_analytic_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_approve()
        </field>
        <!-- <field name="groups_id" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver')), (4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/> -->
    </record>

    <record id="action_server_bxi_timesheet_refuse" model="ir.actions.server">
        <field name="name">Reject Timesheets</field>
        <field name="model_id" ref="model_account_analytic_line"/>
        <field name="binding_model_id" ref="model_account_analytic_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_refuse()
        </field>
        <!-- <field name="groups_id" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver')), (4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/> -->
    </record>

    <!-- Team Approvals: visible only to managers / approvers with direct reports -->
    <menuitem
        id="menu_bxi_timesheet_team_approvals"
        name="Team Approvals"
        parent="hr_timesheet.timesheet_menu_root"
        action="action_bxi_timesheet_approvals"
        groups="hr_timesheet.group_hr_timesheet_approver"
        sequence="10"/>

    <!-- Admin Approvals: visible only to admin level users -->
    <menuitem
        id="menu_bxi_timesheet_admin_approvals"
        name="Admin Approvals"
        parent="hr_timesheet.timesheet_menu_root"
        action="action_bxi_timesheet_admin_approvals"
        groups="base.group_system,hr_timesheet.group_timesheet_manager"
        sequence="20"/>

    <!-- ============================================================
         Standard Odoo hr_timesheet View Inheritances
         - Add Category (L1) and Sub Category (L2) before Project
         - Make project_id optional across tree/form
    ============================================================ -->

    <!-- Inherit standard hr_timesheet tree view (My Timesheets / All Timesheets) -->
    <record id="hr_timesheet_line_tree_inherit_bxi" model="ir.ui.view">
        <field name="name">account.analytic.line.list.bxi.l2</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="before">
                <field name="timesheet_category_id" string="Category (L1)" optional="show"/>
                <field name="timesheet_activity_id" string="Sub Category (L2)" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit standard hr_timesheet form view -->
    <record id="hr_timesheet_line_form_inherit_bxi" model="ir.ui.view">
        <field name="name">account.analytic.line.form.bxi.l2</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="before">
                <field name="timesheet_category_id" string="Category (L1)"/>
                <field name="timesheet_activity_id" string="Sub Category (L2)"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit standard hr_timesheet search view -->
    <record id="hr_timesheet_line_search_inherit_bxi" model="ir.ui.view">
        <field name="name">account.analytic.line.search.bxi.l2</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="before">
                <field name="timesheet_category_id" string="Category (L1)"/>
                <field name="timesheet_activity_id" string="Sub Category (L2)"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Standard Odoo hr_timesheet Action Overrides
         - Remove project_id != False restrictions
         - Allow matching by user_id or employee_id.user_id
    ============================================================ -->

    <!-- My Timesheets (act_hr_timesheet_line) -->
    <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
        <field name="domain">['|', ('user_id', '=', uid), ('employee_id.user_id', '=', uid)]</field>
    </record>

    <!-- All Timesheets (timesheet_action_all) -->
    <record id="hr_timesheet.timesheet_action_all" model="ir.actions.act_window">
        <field name="domain">[]</field>
    </record>

    <!-- Timesheets from Employee (timesheet_action_from_employee) -->
    <record id="hr_timesheet.timesheet_action_from_employee" model="ir.actions.act_window">
        <field name="domain">[('employee_id', '=', active_id)]</field>
    </record>
</odoo>
