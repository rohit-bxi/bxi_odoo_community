<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Record Rules: bxi.desktime.log  (Multi-Company aware)
         - Employee (base.group_user): sees only own records in their company
         - HR User / HR Manager: sees all records within their allowed companies
    ============================================================ -->

    <!-- Regular employee / Manager: own records + team records within allowed companies -->
    <record id="rule_bxi_desktime_log_employee_own" model="ir.rule">
        <field name="name">DeskTime Log: Employee/Manager sees own and team records (company-scoped)</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- HR Officer: all records within allowed companies -->
    <record id="rule_bxi_desktime_log_hr_user_all" model="ir.rule">
        <field name="name">DeskTime Log: HR User sees all records (company-scoped)</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- HR Manager: all records within allowed companies -->
    <record id="rule_bxi_desktime_log_hr_manager_all" model="ir.rule">
        <field name="name">DeskTime Log: HR Manager sees all records (company-scoped)</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================
         Record Rules: account.analytic.line  (Multi-Company aware)
         - Employee/Manager (base.group_user): sees own + team records in their company
         - HR User / HR Manager: sees all records within their allowed companies
    ============================================================ -->

    <!-- Regular employee / Manager: own + team timesheet lines + within allowed companies -->
    <record id="rule_analytic_line_employee_own" model="ir.rule">
        <field name="name">Timesheet Line: Employee/Manager sees own and team records (company-scoped)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- HR Officer: all timesheet lines within allowed companies -->
    <record id="rule_analytic_line_hr_user_all" model="ir.rule">
        <field name="name">Timesheet Line: HR User sees all records (company-scoped)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- HR Manager: all timesheet lines within allowed companies -->
    <record id="rule_analytic_line_hr_manager_all" model="ir.rule">
        <field name="name">Timesheet Line: HR Manager sees all records (company-scoped)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
