<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Record Rules: bxi.desktime.log (Multi-Company aware)
    ============================================================ -->

    <!-- Timesheet User: own records -->
    <record id="rule_bxi_desktime_log_user_own" model="ir.rule">
        <field name="name">DeskTime Log: Timesheet User sees own records</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">['&amp;', ('employee_id.user_id', '=', user.id), ('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Timesheet Approver: own + team records -->
    <record id="rule_bxi_desktime_log_approver_team" model="ir.rule">
        <field name="name">DeskTime Log: Approver sees own and team records</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Timesheet Manager / HR Manager: all records -->
    <record id="rule_bxi_desktime_log_manager_all" model="ir.rule">
        <field name="name">DeskTime Log: Administrator sees all records (company-scoped)</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Fallback Base User: own + team records -->
    <record id="rule_bxi_desktime_log_employee_own" model="ir.rule">
        <field name="name">DeskTime Log: Base User sees own and team records (company-scoped)</field>
        <field name="model_id" ref="model_bxi_desktime_log"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================
         Record Rules: account.analytic.line (Timesheets)
    ============================================================ -->

    <!-- Timesheet User: own timesheets only -->
    <record id="rule_analytic_line_timesheet_user_own" model="ir.rule">
        <field name="name">Timesheet Line: User sees own timesheets only</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">['&amp;', ('employee_id.user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Timesheet Approver (User: all timesheets): own + team timesheets only -->
    <record id="rule_analytic_line_timesheet_approver_team" model="ir.rule">
        <field name="name">Timesheet Line: Approver sees own and team timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Timesheet Manager / HR Manager: all timesheets -->
    <record id="rule_analytic_line_timesheet_manager_all" model="ir.rule">
        <field name="name">Timesheet Line: Administrator sees all timesheets (company-scoped)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Fallback Base User: own + team records -->
    <record id="rule_analytic_line_employee_own" model="ir.rule">
        <field name="name">Timesheet Line: Base User sees own and team records (company-scoped)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">['&amp;', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
