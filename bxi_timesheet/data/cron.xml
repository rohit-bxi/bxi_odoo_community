<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_desktime_daily" model="ir.cron">
            <field name="name">DeskTime Daily Timesheet Sync</field>
            <field name="model_id" ref="model_bxi_desktime_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_desktime()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=18, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_check_unpaid_leave_consecutive_days" model="ir.cron">
            <field name="name">Check Unpaid Leaves (6 Days Empty Timesheets)</field>
            <field name="model_id" ref="model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_unpaid_leaves()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=23, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_send_consolidated_timesheet_approval_emails" model="ir.cron">
            <field name="name">Consolidated Timesheet Approval Email Notification</field>
            <field name="model_id" ref="model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_consolidated_approval_emails()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=20, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
        
        <record id="ir_cron_monthly_timesheet_compliance_email" model="ir.cron">
            <field name="name">Monthly Timesheet and Attendance Compliance Email</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_monthly_timesheet_compliance_email()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall">2026-10-21 09:00:00</field>
        </record>
    </data>
</odoo>
