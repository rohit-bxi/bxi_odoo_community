<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_desktime_daily" model="ir.cron">
            <field name="name">DeskTime Daily Timesheet Sync</field>
            <field name="model_id" ref="model_bxi_desktime_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_desktime()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=18, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_check_unpaid_leave_consecutive_days" model="ir.cron">
            <field name="name">Check Unpaid Leaves (7 Days Empty Timesheets)</field>
            <field name="model_id" ref="model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_unpaid_leaves()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
