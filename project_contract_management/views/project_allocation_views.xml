<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEARCH VIEW FOR PROJECT ALLOCATION -->
    <record id="view_project_allocation_search" model="ir.ui.view">
        <field name="name">project.allocation.search</field>
        <field name="model">project.allocation</field>
        <field name="arch" type="xml">
            <search string="Search Project Allocations">
                <field name="name" string="Allocation"/>
                <field name="partner_id" string="Customer"/>
                <field name="contract_id"/>
                <field name="user_id" string="Project Manager"/>
                <field name="account_lead_id"/>
                <field name="delivery_lead_id"/>
                <field name="practice_lead_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Customer" name="group_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                <filter string="Contract" name="group_contract" domain="[]" context="{'group_by': 'contract_id'}"/>
                <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                <filter string="Project Manager" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                <filter string="Delivery Lead" name="group_delivery_lead" domain="[]" context="{'group_by': 'delivery_lead_id'}"/>
            </search>
        </field>
    </record>

    <!-- LIST VIEW FOR PROJECT ALLOCATION -->
    <record id="view_project_allocation_list" model="ir.ui.view">
        <field name="name">project.allocation.list</field>
        <field name="model">project.allocation</field>
        <field name="arch" type="xml">
            <list string="Project Allocations">
                <field name="name" string="Allocation Title"/>
                <field name="partner_id" string="Customer Name"/>
                <field name="contract_id"/>
                <field name="user_id" string="Project Manager" widget="many2one_avatar_user"/>
                <field name="account_lead_id" widget="many2one_avatar_employee"/>
                <field name="delivery_lead_id" widget="many2one_avatar_employee"/>
                <field name="practice_lead_id" widget="many2one_avatar_employee"/>
                <field name="date_start" string="Start Date"/>
                <field name="date" string="End Date"/>
                <field name="billing_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_allocation_amount" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="total_margin" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW FOR PROJECT ALLOCATION -->
    <record id="view_project_allocation_form" model="ir.ui.view">
        <field name="name">project.allocation.form</field>
        <field name="model">project.allocation</field>
        <field name="arch" type="xml">
            <form string="Project Allocation">
                <header>
                    <button name="action_submit_for_approval"
                            type="object"
                            string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            groups="project_contract_management.group_contract_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn-danger"
                            groups="project_contract_management.group_contract_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_create_project"
                            type="object"
                            string="Create Project"
                            class="btn-primary"
                            icon="fa-plus"
                            groups="project_contract_management.group_contract_manager"
                            invisible="state != 'approved' or project_id"/>

                    <button name="action_reset_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state not in ('rejected', 'approved') or project_id"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_project"
                                class="oe_stat_button"
                                icon="fa-folder-open"
                                invisible="not project_id">
                            <field name="project_id" string="Project" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project / Allocation Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id" string="Customer Name" required="1"
                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                            <field name="contract_id" required="1"
                                   domain="[('client_ids', 'in', partner_id)] if partner_id else []"
                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                            <field name="billing_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="label_tasks" string="Name of the Tasks" placeholder="Tasks"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id" string="Project Manager" widget="many2one_avatar_user" required="1"/>
                            <field name="account_lead_id" widget="many2one_avatar_employee" required="1"
                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                            <field name="delivery_lead_id" widget="many2one_avatar_employee" required="1"
                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                            <field name="practice_lead_id" widget="many2one_avatar_employee" required="1"
                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                            <field name="date_start" string="Planned Date" widget="daterange" options="{'end_date_field': 'date', 'always_range': '1'}" required="1"/>
                            <field name="date" invisible="1" required="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB 1: DESCRIPTION -->
                        <page name="description" string="Description">
                            <field name="description" placeholder="Project Description..."/>
                        </page>

                        <!-- TAB 2: SETTINGS -->
                        <page name="settings" string="Settings">
                            <group>
                                <group name="group_tasks_milestones" string="Tasks &amp; Milestones">
                                    <field name="allow_milestones"/>
                                    <field name="allow_timesheets"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: INVOICING -->
                        <page name="invoicing" string="Invoicing">
                            <group>
                                <group string="Sales &amp; Invoicing">
                                    <field name="allow_billable"/>
                                    <field name="billing_type" invisible="not allow_billable"/>
                                    <field name="sale_order_id" options="{'no_create': True}"/>
                                    <field name="sale_line_id" options="{'no_create': True}" invisible="not sale_order_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 4: ALLOCATIONS -->
                        <page name="allocations" string="Allocations">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0 fw-bold">Allocated Resources</h5>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold fs-6">Billing Amount:</span>
                                    <field name="billing_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" class="fw-bold fs-5 text-primary"/>
                                </div>
                            </div>
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="resource_type"/>
                                    <field name="employee_id"
                                           string="Based On Type"
                                           readonly="resource_type != 'employee'"
                                           invisible="resource_type != 'employee'"
                                           required="resource_type == 'employee'"
                                           widget="many2one_avatar_employee"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="name"
                                           string="Based On Type"
                                           readonly="resource_type == 'employee' or not resource_type"
                                           invisible="resource_type == 'employee'"
                                           required="resource_type != 'employee'"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="allocation_percentage"/>
                                    <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="resource_type not in ('hardwares', 'licenses')"/>
                                    <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="resource_type not in ('hardwares', 'licenses')"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Margin"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Resource Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type"/>
                                            <field name="employee_id"
                                                   readonly="resource_type != 'employee'"
                                                   invisible="resource_type != 'employee'"
                                                   required="resource_type == 'employee'"
                                                   widget="many2one_avatar_employee"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="name"
                                                   string="Based On Type"
                                                   readonly="resource_type == 'employee' or not resource_type"
                                                   invisible="resource_type == 'employee'"
                                                   required="resource_type != 'employee'"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                            <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="resource_type not in ('hardwares', 'licenses')"/>
                                            <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="resource_type not in ('hardwares', 'licenses')"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="allocation_percentage"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="allocation_total">
                                <field name="total_allocation_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_margin" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ACTION FOR PROJECT ALLOCATION -->
    <record id="action_project_allocation" model="ir.actions.act_window">
        <field name="name">Project Allocations</field>
        <field name="res_model">project.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_allocation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Project Allocation
            </p>
        </field>
    </record>

</odoo>
