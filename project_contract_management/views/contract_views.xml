<odoo>

    <record id="action_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">project.contract.management</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">contract.list</field>
        <field name="model">project.contract.management</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-info="stage_id == 1" decoration-success="stage_id == 4">
                <field name="name" string="Contract Name"/>
                <field name="lead_id" string="Opportunity"/>
                <field name="client_ids" widget="many2many_tags"/>
                <field name="industry_id"/>
                <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_delete': True}"/>
                <field name="contract_type"/>
                <field name="billing_cycle"/>
                <field name="contract_start_date"/>
                <field name="contract_end_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="contract_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>

                <field name="stage_id" widget="badge"/>
            </list>


        </field>
    </record>


    <record id="view_contract_kanban" model="ir.ui.view">
        <field name="name">contract.kanban</field>
        <field name="model">project.contract.management</field>
        <field name="arch" type="xml">

            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column o_kanban_dashboard">

                <field name="stage_id"/>
                <field name="name"/>
                <field name="client_ids"/>
                <field name="contract_amount"/>
                <field name="currency_id"/>
                <field name="contract_start_date"/>
                <field name="contract_end_date"/>
                <field name="probability"/>

                <templates>
                    <t t-name="card">

                        <div class="oe_kanban_card oe_kanban_global_click contract_card">

                            <!-- LEFT COLOR STRIP -->
                            <div class="stage_strip"
                                 t-attf-class="stage_strip o_kanban_color_#{record.stage_id.raw_value}">
                            </div>

                            <div class="card_content">

                                <!-- HEADER -->
                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <div class="fw-bold text-dark">
                                        <field name="name"/>
                                    </div>

                                    <span class="badge rounded-pill bg-primary">
                                        <field name="probability"/>%
                                    </span>

                                </div>

                                <!-- CLIENTS -->
                                <div class="mb-2 small text-muted">
                                    <i class="fa fa-users me-1" title="Clients"/>
                                    <field name="client_ids" widget="many2many_tags"/>
                                </div>

                                <!-- AMOUNT -->
                                <div class="mb-2 fw-semibold text-success">
                                    <field name="contract_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>

                                <!-- DATES -->
                                <div class="small text-muted mb-3">
                                    <i class="fa fa-calendar me-1" title="Dates"/>
                                    <field name="contract_start_date"/>
                                    →
                                    <field name="contract_end_date"/>
                                </div>



                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">contract.form</field>
        <field name="model">project.contract.management</field>
        <field name="arch" type="xml">
            <form string="Contract">

                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': True}"/>

                    <button name="action_create_project"
                            type="object"
                            string="Create Project"
                            class="btn-primary"
                            icon="fa-plus"/>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button type="object"
                                name="action_view_projects"
                                class="oe_stat_button"
                                icon="fa-folder-open">

                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>

                        <button type="object"
                                name="action_view_clients"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="client_count" widget="statinfo" string="Clients"/>
                        </button>

                        <button type="object"
                                name="action_view_invoices"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">

                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>

                    </div>


                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Classification">
                            <field name="lead_id"/>
                            <field name="industry_id" required="1"/>
                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_delete': True}"/>
                            <field name="client_ids" widget="many2many_tags" required="1"/>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="sale_order_ids" widget="many2many_tags"/>
                        </group>

                        <group string="Billing &amp; Value">
                            <field name="contract_type" required="1"/>
                            <field name="billing_cycle" required="1"/>
                            <field name="milestone_no" invisible="billing_cycle != 'milestone'"/>
                            <field name="contract_amount" required="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="company_id" required="1" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group string="Duration &amp; Timeline">
                        <group>
                            <field name="contract_start_date" required="1"/>
                            <field name="contract_end_date"/>
                        </group>
                        <group>
                            <field name="contract_tenure" readonly="1"/>
                        </group>
                    </group>



                    <notebook>

                        <page string="Attachments">
                            <group>
                                <field name="contract_attachment_ids"
                                       widget="many2many_binary"
                                       class="oe_inline"/>
                            </group>
                        </page>

                        <page string="Invoices">
                            <field name="invoice_ids">
                                <list>

                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <field name="payment_state"/>
                                </list>
                            </field>
                        </page>



                    </notebook>

                </sheet>
                <chatter/>

            </form>

        </field>
    </record>

</odoo>