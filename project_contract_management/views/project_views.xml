<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_contract" model="ir.ui.view">
        <field name="name">project.project.form.inherit.contract</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Replace default partner_id position so it doesn't appear twice -->
            <xpath expr="//field[@name='partner_id']" position="replace"/>

            <!-- Add fields before label_tasks (Name of the Tasks) -->
            <xpath expr="//group/field[@name='label_tasks']" position="before">
                <field name="partner_id" string="Customer Name" invisible="is_template" readonly="1"
                       options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                <field name="contract_id" readonly="1"
                       domain="[('client_ids', 'in', partner_id)] if partner_id else []"
                       options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                <field name="project_code" readonly="1" placeholder="Auto-generated if blank"/>
                <field name="billing_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
            </xpath>

            <!-- Add Account Head, Delivery Head, Practice Head after Project Manager (user_id) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="account_lead_id" string="Account Head" widget="many2one_avatar_employee" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                <field name="delivery_lead_id" string="Delivery Head" widget="many2one_avatar_employee" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                <field name="practice_lead_id" string="Practice Head" widget="many2one_avatar_employee" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
            </xpath>

            <!-- Add Allocations notebook page -->
            <xpath expr="//notebook" position="inside">
                <page name="allocations" string="Allocations">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold">Allocated Resources</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-6">Billing Amount:</span>
                            <field name="billing_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" class="fw-bold fs-5 text-primary"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="Employee" name="page_employee_allocations">
                            <field name="employee_allocation_ids" context="{'default_resource_type': 'employee'}">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="resource_type" column_invisible="True"/>
                                    <field name="employee_id" string="Employee" required="1"
                                           widget="many2one_avatar_employee"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="allocation_days" readonly="1" force_save="1"/>
                                    <field name="allocation_percentage"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Employee Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type" invisible="1"/>
                                            <field name="employee_id" required="1"
                                                   widget="many2one_avatar_employee"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="allocation_days" readonly="1" force_save="1"/>
                                            <field name="allocation_percentage"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Hardware" name="page_hardware_allocations">
                            <field name="hardware_allocation_ids" context="{'default_resource_type': 'hardwares'}">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="resource_type" column_invisible="True"/>
                                    <field name="product_id" string="Hardware" required="1"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="vendor_id" string="Vendor"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="qty" string="QTY"/>
                                    <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Hardware Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type" invisible="1"/>
                                            <field name="product_id" string="Hardware" required="1"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="vendor_id" string="Vendor"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="qty" string="QTY"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Licenses" name="page_license_allocations">
                            <field name="license_allocation_ids" context="{'default_resource_type': 'licenses'}">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="resource_type" column_invisible="True"/>
                                    <field name="product_id" string="Licenses" required="1"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="vendor_id" string="Vendor"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="qty" string="QTY"/>
                                    <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="License Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type" invisible="1"/>
                                            <field name="product_id" string="Licenses" required="1"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="vendor_id" string="Vendor"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="qty" string="QTY"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="SSD" name="page_ssd_allocations">
                            <field name="ssd_allocation_ids" context="{'default_resource_type': 'ssd'}">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="resource_type" column_invisible="True"/>
                                    <field name="ssd_id" string="SSD" required="1"
                                           widget="many2one_avatar_employee"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="allocation_days" readonly="1" force_save="1"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="SSD Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type" invisible="1"/>
                                            <field name="ssd_id" string="SSD" required="1"
                                                   widget="many2one_avatar_employee"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="allocation_days" readonly="1" force_save="1"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Others" name="page_other_allocations">
                            <field name="other_allocation_ids" context="{'default_resource_type': 'others'}">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="resource_type" column_invisible="True"/>
                                    <field name="name" string="Description / Item" required="1"/>
                                    <field name="vendor_id" string="Vendor"
                                           options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" string="Start Date" required="1"/>
                                    <field name="end_date" string="End Date" required="1"/>
                                    <field name="allocation_days" readonly="1" force_save="1"/>
                                    <field name="allocation_percentage"/>
                                    <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Amount"/>
                                    <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                                <form string="Other Allocation">
                                    <group>
                                        <group>
                                            <field name="resource_type" invisible="1"/>
                                            <field name="name" string="Description / Item" required="1"/>
                                            <field name="vendor_id" string="Vendor"
                                                   options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="service_line_id" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
                                            <field name="vendor_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name="customer_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </group>
                                        <group>
                                            <field name="start_date" required="1"/>
                                            <field name="end_date" required="1"/>
                                            <field name="allocation_days" readonly="1" force_save="1"/>
                                            <field name="allocation_percentage"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="allocation_total">
                        <field name="total_allocation_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                        <field name="total_margin" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Hide Allocated Time from Project Form -->
    <record id="project_invoice_form_inherit_hide_allocated_hours" model="ir.ui.view">
        <field name="name">project.project.form.hide.allocated.hours</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="hr_timesheet.project_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
