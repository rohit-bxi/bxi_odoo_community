<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Service Line Action
         ============================================================ -->
    <record id="action_contract_service_line" model="ir.actions.act_window">
        <field name="name">Service Lines</field>
        <field name="res_model">project.contract.service.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Service Line.
            </p>
            <p>
                Service Lines classify the nature/department of services delivered under contracts.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Service Line List View
         ============================================================ -->
    <record id="view_contract_service_line_list" model="ir.ui.view">
        <field name="name">project.contract.service.line.list</field>
        <field name="model">project.contract.service.line</field>
        <field name="arch" type="xml">
            <list string="Service Lines" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Service Line Form View
         ============================================================ -->
    <record id="view_contract_service_line_form" model="ir.ui.view">
        <field name="name">project.contract.service.line.form</field>
        <field name="model">project.contract.service.line</field>
        <field name="arch" type="xml">
            <form string="Service Line">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
