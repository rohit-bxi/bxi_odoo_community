<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract Management Privilege -->
    <record id="res_groups_privilege_contract_management" model="res.groups.privilege">
        <field name="name">Contract Management</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="placeholder">No</field>
    </record>

    <!-- Contract Management / User Group (Read-Only) -->
    <record id="group_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Contract Management / Admin Group (Full Access) -->
    <record id="group_contract_manager" model="res.groups">
        <field name="name">Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_management"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="project_contract_management_multi_company_rule" model="ir.rule">
        <field name="name">Project Contract Multi-Company</field>
        <field name="model_id" ref="model_project_contract_management"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
