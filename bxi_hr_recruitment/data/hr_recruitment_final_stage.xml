<odoo>
    <data>

        <!--  ADD NEW STAGES -->

        <record model="hr.recruitment.stage" id="stage_final_interview">
            <field name="name">Final Interview</field>
            <field name="sequence">4</field>
        </record>

        <record model="hr.recruitment.stage" id="stage_make_proposal">
            <field name="name">Make Proposal</field>
            <field name="sequence">5</field>
        </record>

        <!--  UPDATE EXISTING USING SEARCH -->

        <function model="hr.recruitment.stage" name="write">
            <value eval="[(ref('hr_recruitment.stage_job4'))]"/>
            <value eval="{'sequence': 6}"/>
        </function>

        <function model="hr.recruitment.stage" name="write">
            <value eval="[(ref('hr_recruitment.stage_job5'))]"/>
            <value eval="{'sequence': 7}"/>
        </function>

    </data>
</odoo>
