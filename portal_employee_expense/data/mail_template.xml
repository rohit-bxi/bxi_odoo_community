<odoo>
    <!-- Expense Submission & Finance Approval Email -->
    <record id="email_template_finance" model="mail.template">
        <field name="name">Expense Request - Finance Approval</field>
        <field name="model_id" ref="model_hr_expense" />
        <field name="subject">Finance Approval Required - {{ object.employee_id.name }}</field>
        <field name="email_from">hrsupport@bxitech.com</field>
        <field name="email_to">{{ object.employee_id.work_email or object.employee_id.user_id.email or '' }},FSO@bxiventures.com</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.5;">
                <p>Dear <b><t t-esc="object.employee_id.name or 'Employee'" /></b> / Finance Team,</p>
                <p>A new Expense request has been submitted and is currently pending financial approval.</p>
                
                <table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; max-width: 600px; margin: 15px 0; border: 1px solid #dee2e6;">
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Employee</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                            <t t-esc="object.employee_id.name" />
                        </td>
                    </tr>
                    <tr>
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Description</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                            <t t-esc="object.name" />
                        </td>
                    </tr>
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Category</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                            <t t-esc="object.product_id.name" />
                        </td>
                    </tr>
                    <tr>
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Expense Date</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                            <t t-esc="object.date" />
                        </td>
                    </tr>
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Reimbursement Date</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                            <t t-esc="object.reimbursement_date" />
                        </td>
                    </tr>
                    <tr>
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Total Amount</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">
                            <t t-esc="object.total_amount" />
                        </td>
                    </tr>
                    <tr style="background-color: #f8f9fa;">
                        <th style="padding: 8px 12px; text-align: left; border: 1px solid #dee2e6;">Status</th>
                        <td style="padding: 8px 12px; border: 1px solid #dee2e6; color: #17a2b8; font-weight: bold;">
                            Finance Approval
                        </td>
                    </tr>
                </table>

                <br />
                <t t-set="url" t-value="'/web#id=%s&amp;model=hr.expense&amp;view_type=form' % object.id" />
                <a t-att-href="url"
                    style="
                        display: inline-block;
                        background-color: #875a7b;
                        color: #ffffff;
                        padding: 10px 18px;
                        font-size: 14px;
                        font-weight: 600;
                        font-family: Arial, sans-serif;
                        text-decoration: none;
                        border-radius: 4px;
                    ">
                    View Expense Request
                </a>
            </div>
        </field>
        <field name="reply_to">hrsupport@bxitech.com</field>
    </record>

