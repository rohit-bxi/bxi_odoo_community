<odoo>
    <record id="view_hr_expense_form_inherit_finance" model="ir.ui.view">
        <field name="name">hr.expense.form.finance.approval</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">

            <!-- Replace the two "Approve" buttons (with/without attachment) with "Finance Approve" -->
            <xpath expr="//button[@name='action_approve'][1]" position="replace">
                <button name="action_finance_approved"
                    type="object"
                    string="Finance Approve"
                    class="btn-primary oe_highlight o_expense_approve_highlight"
                    data-hotkey="q"
                    invisible="nb_attachment == 0 or state != 'submitted'" />
            </xpath>
            <xpath expr="//button[@name='action_approve'][2]" position="replace">
                <button name="action_finance_approved"
                    type="object"
                    string="Finance Approve"
                    class="btn-primary o_expense_approve"
                    data-hotkey="q"
                    invisible="nb_attachment &gt;= 1 or state != 'submitted'" />
            </xpath>

            <!-- Replace the state statusbar to use our visible statuses -->
            <xpath expr="//field[@name='state'][@invisible=\"state in ('submitted', 'in_payment', 'refused')\"]" position="replace">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,approved,posted,paid"
                       invisible="state in ('submitted', 'in_payment', 'refused')"/>
            </xpath>
            <xpath expr="//field[@name='state'][@invisible=\"state != 'submitted'\"]" position="replace">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,submitted,approved,posted,paid"
                       invisible="state != 'submitted'"/>
            </xpath>

        </field>
    </record>
</odoo>