<odoo>
    <data>

        <record id="view_expense_form_inherit_reimbursement" model="ir.ui.view">
            <field name="name">hr.expense.form.reimbursement</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="reimbursement_date" readonly="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>