<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_helpdesk_sub_category_list" model="ir.ui.view">
        <field name="name">helpdesk.sub.category.list</field>
        <field name="model">helpdesk.sub.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
                <field name="category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_sub_category_form" model="ir.ui.view">
        <field name="name">helpdesk.sub.category.form</field>
        <field name="model">helpdesk.sub.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_id"/>
                        <field name="category_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_sub_category" model="ir.actions.act_window">
        <field name="name">Sub Categories</field>
        <field name="res_model">helpdesk.sub.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_sub_category"
              name="Sub Categories"
              parent="helpdesk.helpdesk_menu_config"
              action="action_helpdesk_sub_category"
              sequence="30"/>
</odoo>
