<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View -->
    <record id="view_helpdesk_escalation_level_list" model="ir.ui.view">
        <field name="name">helpdesk.escalation.level.list</field>
        <field name="model">helpdesk.escalation.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
                <field name="assignees_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_helpdesk_escalation_level_form" model="ir.ui.view">
        <field name="name">helpdesk.escalation.level.form</field>
        <field name="model">helpdesk.escalation.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_id"/>
                        <field name="assignees_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_escalation_level" model="ir.actions.act_window">
        <field name="name">Escalation Levels</field>
        <field name="res_model">helpdesk.escalation.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_escalation_level"
              name="Escalation Levels"
              parent="helpdesk.helpdesk_menu_config"
              action="action_helpdesk_escalation_level"
              sequence="40"/>
</odoo>
