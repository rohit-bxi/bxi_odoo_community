<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_letter_wizard" model="ir.ui.view">
        <field name="name">employee.letter.wizard.form</field>
        <field name="model">employee.letter.wizard</field>
        <field name="arch" type="xml">
            <form string="Letter Actions">
                <group>
                    <field name="appraisal_id"
                           readonly="1"/>
                </group>
                <footer>
                    <button name="action_send"
                            type="object"
                            string="Send"
                            class="btn-primary"/>

                    <button name="action_download"
                            type="object"
                            string="Download"
                            class="btn-secondary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>