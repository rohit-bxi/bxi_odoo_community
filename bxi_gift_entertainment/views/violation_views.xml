<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_gift_violation_list" model="ir.ui.view">
        <field name="name">bxi.gift.violation.list</field>
        <field name="model">bxi.gift.violation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="violation_type"/>
                <field name="subject_employee_id"/>
                <field name="subject_partner_id"/>
                <field name="anonymous"/>
                <field name="outcome"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-warning="state == 'investigating'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_gift_violation_form" model="ir.ui.view">
        <field name="name">bxi.gift.violation.form</field>
        <field name="model">bxi.gift.violation</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_investigate" string="Investigate" type="object" class="btn-primary" invisible="state != 'new'" groups="bxi_gift_entertainment.group_gift_lso"/>
                    <button name="action_close" string="Close" type="object" invisible="state == 'closed'" groups="bxi_gift_entertainment.group_gift_lso"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="violation_type" readonly="state == 'closed'"/>
                            <field name="subject_employee_id" readonly="state == 'closed'"/>
                            <field name="subject_partner_id" readonly="state == 'closed'"/>
                            <field name="related_ref" readonly="state == 'closed'"/>
                        </group>
                        <group>
                            <field name="anonymous"/>
                            <field name="reporter_user_id" invisible="anonymous"/>
                            <field name="outcome" readonly="state == 'closed'"/>
                            <field name="closed_date"/>
                        </group>
                    </group>
                    <field name="description" readonly="state == 'closed'"/>
                    <group string="Investigation" groups="bxi_gift_entertainment.group_gift_lso,bxi_gift_entertainment.group_gift_ethics_committee">
                        <field name="investigation" nolabel="1" colspan="2" readonly="state == 'closed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bxi_gift_violation" model="ir.actions.act_window">
        <field name="name">Violations</field>
        <field name="res_model">bxi.gift.violation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
