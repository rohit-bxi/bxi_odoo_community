<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_gift_due_diligence_list" model="ir.ui.view">
        <field name="name">bxi.gift.due.diligence.list</field>
        <field name="model">bxi.gift.due.diligence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="record_name"/>
                <field name="partner_id"/>
                <field name="scope"/>
                <field name="reviewer_id"/>
                <field name="risk_rating" widget="badge" decoration-success="risk_rating == 'low'" decoration-warning="risk_rating == 'medium'" decoration-danger="risk_rating == 'high'"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_gift_due_diligence_form" model="ir.ui.view">
        <field name="name">bxi.gift.due.diligence.form</field>
        <field name="model">bxi.gift.due.diligence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Clear" type="object" class="btn-primary" invisible="state != 'draft'" groups="bxi_gift_entertainment.group_gift_lso"/>
                    <button name="action_reject" string="Not Cleared" type="object" invisible="state != 'draft'" groups="bxi_gift_entertainment.group_gift_lso"/>
                    <button name="action_open_record" string="Open Request" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="scope" readonly="1"/>
                        </group>
                        <group>
                            <field name="reviewer_id" readonly="state != 'draft'"/>
                            <field name="risk_count"/>
                            <field name="risk_rating"/>
                        </group>
                    </group>
                    <field name="answer_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0" decoration-danger="is_risk">
                            <field name="question" readonly="1"/>
                            <field name="guidance" optional="hide" readonly="1"/>
                            <field name="answer"/>
                            <field name="comment"/>
                            <field name="is_risk" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        <field name="conclusion" readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bxi_gift_due_diligence" model="ir.actions.act_window">
        <field name="name">Due Diligence</field>
        <field name="res_model">bxi.gift.due.diligence</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

    <record id="view_bxi_gift_due_diligence_search" model="ir.ui.view">
        <field name="name">bxi.gift.due.diligence.search</field>
        <field name="model">bxi.gift.due.diligence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="todo" string="To Do" domain="[('state', '=', 'draft')]"/>
                <filter name="high" string="High Risk" domain="[('risk_rating', '=', 'high')]"/>
            </search>
        </field>
    </record>
</odoo>
