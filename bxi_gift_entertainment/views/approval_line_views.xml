<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_gift_approval_line_list" model="ir.ui.view">
        <field name="name">bxi.gift.approval.line.list</field>
        <field name="model">bxi.gift.approval.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="record_name"/>
                <field name="res_model" optional="hide"/>
                <field name="requester_user_id"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="approved_user_ids" widget="many2many_tags"/>
                <field name="required_votes"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <button name="action_open_record" string="Open" type="object" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_bxi_gift_approval_line_mine" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">bxi.gift.approval.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'pending'), ('user_ids', 'in', uid), ('approved_user_ids', 'not in', uid)]</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p></field>
    </record>
</odoo>
