        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bxi_gift_extortion" model="ir.sequence">
        <field name="name">Extortion Report</field>
        <field name="code">bxi.gift.extortion</field>
        <field name="prefix">EXT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bxi_gift_violation" model="ir.sequence">
        <field name="name">Gift Policy Violation</field>
        <field name="code">bxi.gift.violation</field>
        <field name="prefix">VIO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
