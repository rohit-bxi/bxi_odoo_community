<odoo>
    <record id="view_hr_comp_off_request_list" model="ir.ui.view">
        <field name="name">hr.comp.off.request.list</field>
        <field name="model">hr.comp.off.request</field>
        <field name="arch" type="xml">
            <list string="Comp-Off Requests"
                  decoration-success="state == 'credited'"
                  decoration-info="state in ('manager_approved', 'hr_approved', 'worked')"
                  decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="work_date"/>
                <field name="comp_off_date"/>
                <field name="attendance_hours" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="allocation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_comp_off_request_form" model="ir.ui.view">
        <field name="name">hr.comp.off.request.form</field>
        <field name="model">hr.comp.off.request</field>
        <field name="arch" type="xml">
            <form string="Comp-Off Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object" string="Manager Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_hr_approve" type="object" string="HR Approve"
                            class="btn-primary" invisible="state != 'manager_approved'"/>
                    <button name="action_verify_attendance_and_credit" type="object"
                            string="Verify Attendance &amp; Credit" class="btn-primary"
                            invisible="state not in ('hr_approved', 'worked')"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            class="btn-secondary" invisible="state not in ('submitted', 'manager_approved', 'hr_approved')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary" invisible="state not in ('draft', 'submitted', 'manager_approved', 'hr_approved')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('refused', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_approved,hr_approved,credited,refused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Comp-Off Dates">
                            <field name="work_date" readonly="state != 'draft'"/>
                            <field name="comp_off_date" readonly="state != 'draft'"/>
                            <field name="attendance_hours" readonly="1"/>
                            <field name="allocation_id" readonly="1" invisible="not allocation_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Reason or additional details..."
                               readonly="state not in ('draft',)"/>
                        <field name="refusal_reason" readonly="1" invisible="not refusal_reason"/>
                    </group>
                    <group string="Approval Audit">
                        <group>
                            <field name="manager_approved_by" readonly="1"/>
                            <field name="manager_approved_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="hr_approved_by" readonly="1"/>
                            <field name="hr_approved_on" readonly="1"/>
                            <field name="attendance_verified_by" readonly="1"/>
                            <field name="attendance_verified_on" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Submit at least 5 calendar days before the Saturday/Sunday work date.
                        HR verifies completed attendance after the work date. At least 8 hours
                        are required to credit one day of the existing Comp-Off leave type.
                    </div>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_comp_off_request" model="ir.actions.act_window">
        <field name="name">Comp-Off Requests</field>
        <field name="res_model">hr.comp.off.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_comp_off_request_list"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_hr_comp_off_root"
          name="Comp-Off"
          parent="bxi_shift_management.menu_shift_management_root"
          sequence="35"
          groups="group_comp_off_user,group_comp_off_manager,hr_holidays.group_hr_holidays_manager"/>

<menuitem id="menu_hr_comp_off_requests"
          name="Comp-Off Requests"
          parent="menu_hr_comp_off_root"
          action="action_hr_comp_off_request"
          sequence="10"
          groups="group_comp_off_user,group_comp_off_manager,hr_holidays.group_hr_holidays_manager"/>
        </odoo>
