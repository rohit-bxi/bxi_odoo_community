<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_performance_bonus_user" model="res.groups">
        <field name="name">Performance Bonus / HR User</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_performance_bonus_manager" model="res.groups">
        <field name="name">Performance Bonus / HR Manager</field>
        <field name="implied_ids" eval="[(4, ref('bxi_performance_bonus_final.group_performance_bonus_user')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="rule_performance_bonus_cycle" model="ir.rule">
        <field name="name">Performance Bonus Cycles - HR</field>
        <field name="model_id" ref="model_performance_bonus_cycle"/>
        <field name="groups" eval="[(4, ref('bxi_performance_bonus_final.group_performance_bonus_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_performance_bonus_line" model="ir.rule">
        <field name="name">Performance Bonus Lines - HR</field>
        <field name="model_id" ref="model_performance_bonus_line"/>
        <field name="groups" eval="[(4, ref('bxi_performance_bonus_final.group_performance_bonus_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_performance_bonus_plan" model="ir.rule">
        <field name="name">Performance Bonus Plans - HR</field>
        <field name="model_id" ref="model_performance_bonus_plan"/>
        <field name="groups" eval="[(4, ref('bxi_performance_bonus_final.group_performance_bonus_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_performance_bonus_rating_rule" model="ir.rule">
        <field name="name">Performance Bonus Rating Rules - HR</field>
        <field name="model_id" ref="model_performance_bonus_rating_rule"/>
        <field name="groups" eval="[(4, ref('bxi_performance_bonus_final.group_performance_bonus_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
