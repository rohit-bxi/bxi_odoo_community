<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_bonus_policy" model="ir.ui.view">
        <field name="name">hr.employee.bonus.policy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Bonus Policy">
                    <group>
                        <group string="Eligibility">
                            <field name="bonus_in_compensation"/>
                            <field name="bonus_employment_type"/>
                            <field name="bonus_grade"/>
                            <field name="bonus_geography"/>
                        </group>
                        <group string="Exclusions">
                            <field name="bonus_is_sales_employee"/>
                            <field name="bonus_is_rebadged"/>
                        </group>
                    </group>
                    <group string="Bonus Calculation">
                        <field name="bonus_annual_base"/>
                        <field name="bonus_currency_id" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
