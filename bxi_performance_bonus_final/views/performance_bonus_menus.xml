<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_performance_bonus_cycles" model="ir.actions.act_window">
        <field name="name">Bonus Cycles</field>
        <field name="res_model">performance.bonus.cycle</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_performance_bonus_employees" model="ir.actions.act_window">
        <field name="name">Employee Bonus Review</field>
        <field name="res_model">performance.bonus.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_performance_bonus_line_search"/>
    </record>

    <record id="action_performance_bonus_plans" model="ir.actions.act_window">
        <field name="name">Bonus Plans</field>
        <field name="res_model">performance.bonus.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_bonus_root" name="Performance Bonus"
              sequence="55" groups="bxi_performance_bonus_final.group_performance_bonus_user"/>

    <menuitem id="menu_performance_bonus_employee_review" name="Employee Bonus Review"
              parent="menu_performance_bonus_root"
              action="action_performance_bonus_employees" sequence="10"
              groups="bxi_performance_bonus_final.group_performance_bonus_user"/>

    <menuitem id="menu_performance_bonus_cycles" name="Bonus Cycles"
              parent="menu_performance_bonus_root"
              action="action_performance_bonus_cycles" sequence="20"
              groups="bxi_performance_bonus_final.group_performance_bonus_user"/>

    <menuitem id="menu_performance_bonus_configuration" name="Configuration"
              parent="menu_performance_bonus_root" sequence="90"
              groups="bxi_performance_bonus_final.group_performance_bonus_manager"/>

    <menuitem id="menu_performance_bonus_plans" name="Bonus Plans"
              parent="menu_performance_bonus_configuration"
              action="action_performance_bonus_plans" sequence="10"
              groups="bxi_performance_bonus_final.group_performance_bonus_manager"/>
</odoo>
