<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_equitable_benefit">
        <field name="name">Equitable Benefit</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- The policy is jointly governed by Revenue Assurance and Finance. -->
    <record id="group_eb_revenue_assurance" model="res.groups">
        <field name="name">Revenue Assurance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_equitable_benefit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eb_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_equitable_benefit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eb_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_equitable_benefit"/>
        <field name="implied_ids" eval="[(4, ref('group_eb_revenue_assurance')), (4, ref('group_eb_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Employees and managers see their own / their team's records. -->
    <record id="bxi_eb_assignment_rule_own" model="ir.rule">
        <field name="name">Equitable Benefit Assignment: own and team</field>
        <field name="model_id" ref="model_bxi_eb_assignment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_eb_assignment_rule_all" model="ir.rule">
        <field name="name">Equitable Benefit Assignment: all</field>
        <field name="model_id" ref="model_bxi_eb_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_eb_revenue_assurance')), (4, ref('group_eb_finance'))]"/>
    </record>

    <record id="bxi_eb_payout_rule_own" model="ir.rule">
        <field name="name">Equitable Benefit Payout: own</field>
        <field name="model_id" ref="model_bxi_eb_payout"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_eb_payout_rule_all" model="ir.rule">
        <field name="name">Equitable Benefit Payout: all</field>
        <field name="model_id" ref="model_bxi_eb_payout"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_eb_revenue_assurance')), (4, ref('group_eb_finance'))]"/>
    </record>

    <record id="bxi_eb_payout_line_rule_own" model="ir.rule">
        <field name="name">Equitable Benefit Payout Line: own</field>
        <field name="model_id" ref="model_bxi_eb_payout_line"/>
        <field name="domain_force">[('payout_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="bxi_eb_payout_line_rule_all" model="ir.rule">
        <field name="name">Equitable Benefit Payout Line: all</field>
        <field name="model_id" ref="model_bxi_eb_payout_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_eb_revenue_assurance')), (4, ref('group_eb_finance'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="bxi_eb_assignment_comp_rule" model="ir.rule">
        <field name="name">Equitable Benefit Assignment: multi-company</field>
        <field name="model_id" ref="model_bxi_eb_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="bxi_eb_payout_comp_rule" model="ir.rule">
        <field name="name">Equitable Benefit Payout: multi-company</field>
        <field name="model_id" ref="model_bxi_eb_payout"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="bxi_eb_rate_comp_rule" model="ir.rule">
        <field name="name">Equitable Benefit Rate: multi-company</field>
        <field name="model_id" ref="model_bxi_eb_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
