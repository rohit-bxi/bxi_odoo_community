<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_eb_rate_list" model="ir.ui.view">
        <field name="name">bxi.eb.rate.list</field>
        <field name="model">bxi.eb.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="work_category"/>
                <field name="work_pattern_id"/>
                <field name="deployment"/>
                <field name="rate_percent"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_eb_rate_search" model="ir.ui.view">
        <field name="name">bxi.eb.rate.search</field>
        <field name="model">bxi.eb.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="work_pattern_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_pattern" string="Work Pattern" context="{'group_by': 'work_pattern_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bxi_eb_rate" model="ir.actions.act_window">
        <field name="name">Rate Matrix</field>
        <field name="res_model">bxi.eb.rate</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False, 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the benefit percentage of Annualized Component A</p>
            <p>Add a new row with a later "Valid From" date to revise a rate without changing past payouts.</p>
        </field>
    </record>
</odoo>
