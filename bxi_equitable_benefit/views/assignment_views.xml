<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_eb_assignment_list" model="ir.ui.view">
        <field name="name">bxi.eb.assignment.list</field>
        <field name="model">bxi.eb.assignment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="work_category"/>
                <field name="work_pattern_id"/>
                <field name="deployment"/>
                <field name="client_name" optional="show"/>
                <field name="rate_percent"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_eb_assignment_form" model="ir.ui.view">
        <field name="name">bxi.eb.assignment.form</field>
        <field name="model">bxi.eb.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'submitted'" groups="bxi_equitable_benefit.group_eb_revenue_assurance"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'" groups="bxi_equitable_benefit.group_eb_revenue_assurance"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('submitted', 'rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Work Pattern">
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" readonly="state != 'draft'"/>
                                <span>to</span>
                                <field name="date_to" placeholder="Ongoing" readonly="state not in ('draft', 'approved')"/>
                            </div>
                            <field name="work_category" readonly="state != 'draft'"/>
                            <field name="work_pattern_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="deployment" readonly="state != 'draft'"/>
                            <field name="rate_percent"/>
                        </group>
                    </group>
                    <group string="Client / Project Requirement">
                        <field name="client_name" readonly="state != 'draft'"/>
                        <field name="project_reference" readonly="state != 'draft'"/>
                        <field name="justification" readonly="state != 'draft'"/>
                        <field name="requirement_attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                    </group>
                    <group string="Review" invisible="state in ('draft', 'submitted')">
                        <field name="approved_by_id" invisible="not approved_by_id"/>
                        <field name="approved_date" invisible="not approved_date"/>
                        <field name="rejection_reason" readonly="state not in ('submitted', 'rejected')"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bxi_eb_assignment_search" model="ir.ui.view">
        <field name="name">bxi.eb.assignment.search</field>
        <field name="model">bxi.eb.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="client_name"/>
                <field name="work_pattern_id"/>
                <filter name="my" string="My Assignments" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_pattern" string="Work Pattern" context="{'group_by': 'work_pattern_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bxi_eb_assignment" model="ir.actions.act_window">
        <field name="name">Work Pattern Assignments</field>
        <field name="res_model">bxi.eb.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Declare a work pattern period</p>
            <p>Record the period, work pattern and deployment together with the documented client or
                project requirement. Revenue Assurance approves it before it counts for the benefit.</p>
        </field>
    </record>

    <record id="action_bxi_eb_assignment_my" model="ir.actions.act_window">
        <field name="name">My Work Patterns</field>
        <field name="res_model">bxi.eb.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_bxi_eb_assignment_to_approve" model="ir.actions.act_window">
        <field name="name">Assignments to Approve</field>
        <field name="res_model">bxi.eb.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
