<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_eb_disciplinary_action_list" model="ir.ui.view">
        <field name="name">bxi.eb.disciplinary.action.list</field>
        <field name="model">bxi.eb.disciplinary.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge" decoration-danger="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_eb_disciplinary_action_form" model="ir.ui.view">
        <field name="name">bxi.eb.disciplinary.action.form</field>
        <field name="model">bxi.eb.disciplinary.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" string="Close" type="object" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Details..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bxi_eb_disciplinary_action" model="ir.actions.act_window">
        <field name="name">Disciplinary Actions</field>
        <field name="res_model">bxi.eb.disciplinary.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bxi_eb_performance_rating_list" model="ir.ui.view">
        <field name="name">bxi.eb.performance.rating.list</field>
        <field name="model">bxi.eb.performance.rating</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="fy_start"/>
                <field name="fy_name"/>
                <field name="rating"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_eb_performance_rating_search" model="ir.ui.view">
        <field name="name">bxi.eb.performance.rating.search</field>
        <field name="model">bxi.eb.performance.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="fy_name"/>
                <group>
                    <filter name="group_fy" string="Financial Year" context="{'group_by': 'fy_name'}"/>
                    <filter name="group_rating" string="Rating" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bxi_eb_performance_rating" model="ir.actions.act_window">
        <field name="name">Performance Ratings</field>
        <field name="res_model">bxi.eb.performance.rating</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
