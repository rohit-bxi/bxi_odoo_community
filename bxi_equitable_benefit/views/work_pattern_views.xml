<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bxi_eb_work_pattern_list" model="ir.ui.view">
        <field name="name">bxi.eb.work.pattern.list</field>
        <field name="model">bxi.eb.work.pattern</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="days_per_week"/>
                <field name="is_shift"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_bxi_eb_work_pattern" model="ir.actions.act_window">
        <field name="name">Work Patterns</field>
        <field name="res_model">bxi.eb.work.pattern</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
