<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor Code Sequence -->
    <record id="bxi_vendor_sequence" model="ir.sequence">
        <field name="name">BXI Vendor Code</field>
        <field name="code">bxi.vendor.sequence</field>
        <field name="prefix">VND/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ASN Number Sequence -->
    <record id="bxi_vendor_asn_sequence" model="ir.sequence">
        <field name="name">BXI ASN Number</field>
        <field name="code">bxi.vendor.asn.sequence</field>
        <field name="prefix">ASN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
