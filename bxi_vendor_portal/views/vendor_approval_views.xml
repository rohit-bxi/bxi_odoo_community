<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_approval_list" model="ir.ui.view">
        <field name="name">bxi.vendor.approval.list</field>
        <field name="model">bxi.vendor.approval</field>
        <field name="arch" type="xml">
            <list string="Approval Records">
                <field name="vendor_id"/>
                <field name="level"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'rejected'"/>
                <field name="assigned_to"/>
                <field name="approved_by"/>
                <field name="approved_on"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_approval_form" model="ir.ui.view">
        <field name="name">bxi.vendor.approval.form</field>
        <field name="model">bxi.vendor.approval</field>
        <field name="arch" type="xml">
            <form string="Approval Record" readonly="1">
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="level"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="approved_by"/>
                            <field name="approved_on"/>
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="remarks" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_approval" model="ir.actions.act_window">
        <field name="name">Approval Records</field>
        <field name="res_model">bxi.vendor.approval</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','pending')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
