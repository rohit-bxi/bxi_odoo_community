<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_rating_list" model="ir.ui.view">
        <field name="name">bxi.vendor.rating.list</field>
        <field name="model">bxi.vendor.rating</field>
        <field name="arch" type="xml">
            <list string="Vendor Performance Ratings"
                  decoration-success="overall_score >= 90"
                  decoration-warning="overall_score >= 60 and overall_score &lt; 90"
                  decoration-danger="overall_score &lt; 60">
                <field name="vendor_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="period_type"/>
                <field name="otd_score" string="OTD %"/>
                <field name="quality_score" string="Quality %"/>
                <field name="lead_time_score" string="Lead Time %"/>
                <field name="compliance_score" string="Compliance %"/>
                <field name="overall_score" string="Score"/>
                <field name="rating_label" string="Grade"
                       decoration-success="rating_label and rating_label.startswith('A')"
                       decoration-primary="rating_label and rating_label.startswith('B')"
                       decoration-warning="rating_label and rating_label.startswith('C')"
                       decoration-danger="rating_label and rating_label.startswith('D')"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_rating_form" model="ir.ui.view">
        <field name="name">bxi.vendor.rating.form</field>
        <field name="model">bxi.vendor.rating</field>
        <field name="arch" type="xml">
            <form string="Vendor Performance Rating">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="vendor_id"/></h1>
                        <div class="text-muted">
                            <field name="period_start" class="oe_inline"/> to <field name="period_end" class="oe_inline"/>
                            — <field name="period_type" class="oe_inline"/>
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <strong>Overall Score: </strong>
                        <field name="overall_score" class="oe_inline"/>%
                        — <field name="rating_label" class="oe_inline"/>
                    </div>
                    <group string="Scoring Dimensions (Weighted)">
                        <group>
                            <field name="otd_score" string="On-Time Delivery % (30% weight)"/>
                            <field name="quality_score" string="Quality / Rejection Rate % (25% weight)"/>
                            <field name="lead_time_score" string="Lead Time Adherence % (20% weight)"/>
                        </group>
                        <group>
                            <field name="compliance_score" string="Document Compliance % (15% weight)"/>
                            <field name="responsiveness_score" string="Responsiveness % (10% weight)"/>
                            <field name="evaluated_by"/>
                        </group>
                    </group>
                    <group string="Evaluator Remarks">
                        <field name="remarks" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_rating_search" model="ir.ui.view">
        <field name="name">bxi.vendor.rating.search</field>
        <field name="model">bxi.vendor.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="vendor_id"/>
                <group>
                    <filter string="Vendor" name="grp_vendor" context="{'group_by':'vendor_id'}"/>
                    <filter string="Period Type" name="grp_period_type" context="{'group_by':'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_rating" model="ir.actions.act_window">
        <field name="name">Vendor Performance Ratings</field>
        <field name="res_model">bxi.vendor.rating</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_rating_search"/>
        <field name="context">{'search_default_grp_vendor': 1}</field>
    </record>
</odoo>
