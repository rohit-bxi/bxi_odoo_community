<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_bxi_vendor_portal" model="ir.module.category">
        <field name="name">BXI Vendor Portal</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_vendor_portal" model="res.groups.privilege">
        <field name="name">Vendor Portal Management</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="module_bxi_vendor_portal"/>
    </record>

    <record id="group_vendor_user" model="res.groups">
        <field name="name">Vendor User</field>
        <field name="privilege_id" ref="res_groups_vendor_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vendor_manager" model="res.groups">
        <field name="name">Vendor Manager</field>
        <field name="privilege_id" ref="res_groups_vendor_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_user'))]"/>
    </record>

    <record id="group_vendor_approver" model="res.groups">
        <field name="name">Vendor Approver</field>
        <field name="privilege_id" ref="res_groups_vendor_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_manager'))]"/>
    </record>

    <record id="group_vendor_admin" model="res.groups">
        <field name="name">Vendor Admin</field>
        <field name="privilege_id" ref="res_groups_vendor_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_approver'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
