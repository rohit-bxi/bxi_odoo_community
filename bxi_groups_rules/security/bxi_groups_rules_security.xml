<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         GROUP: Base Employee
         Appears in the "Employees" Access Rights dropdown on the
         User form alongside Officer and Administrator (no debug needed).
         The privilege_id is assigned dynamically via post_init_hook
         to match hr.group_hr_user's privilege.
    ============================================================ -->
    <record id="group_hr_employee_base" model="res.groups">
        <field name="name">Base Employee</field>
        <field name="sequence">1</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Minimal access: the user can only see their own employee profile
            in the Employees app, their own attendance records, and their own time off records.
        </field>
    </record>

    <!-- ============================================================
         RECORD RULE: hr.employee — own record only
         Applies to every member of Base Employee group.
    ============================================================ -->
    <record id="rule_hr_employee_own_record" model="ir.rule">
        <field name="name">Base Employee: own employee record only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bxi_groups_rules.group_hr_employee_base'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================
         RECORD RULE: hr.attendance — own attendance records only
         Applies to every member of Base Employee group.
    ============================================================ -->
    <record id="rule_hr_attendance_own_records" model="ir.rule">
        <field name="name">Base Employee: own attendance records only</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bxi_groups_rules.group_hr_employee_base'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================
         RECORD RULE: hr.leave — own time off requests only
         Applies to every member of Base Employee group.
    ============================================================ -->
    <record id="rule_hr_leave_own_records" model="ir.rule">
        <field name="name">Base Employee: own time off requests only</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bxi_groups_rules.group_hr_employee_base'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================
         RECORD RULE: hr.leave.allocation — own time off allocations only
         Applies to every member of Base Employee group.
    ============================================================ -->
    <record id="rule_hr_leave_allocation_own_records" model="ir.rule">
        <field name="name">Base Employee: own time off allocations only</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bxi_groups_rules.group_hr_employee_base'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
