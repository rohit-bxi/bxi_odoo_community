<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Telemetry Log – List View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_ev_telemetry_log_list" model="ir.ui.view">
        <field name="name">ev.telemetry.log.list</field>
        <field name="model">ev.telemetry.log</field>
        <field name="arch" type="xml">
            <list string="Telemetry Logs"
                  decoration-danger="gps_status == 'V'"
                  decoration-success="ignition == True and gps_status == 'A'">
                <field name="name"/>
                <field name="device_id"/>
                <field name="vehicle_id"/>
                <field name="timestamp"/>
                <field name="latitude" digits="[10,6]"/>
                <field name="longitude" digits="[10,6]"/>
                <field name="speed" string="Speed (km/h)"/>
                <field name="odometer" string="Odometer (km)"/>
                <field name="ignition" widget="boolean_toggle"/>
                <field name="battery_voltage" string="Batt. V"/>
                <field name="gps_status" widget="badge"
                       decoration-success="gps_status == 'A'"
                       decoration-danger="gps_status == 'V'"
                       decoration-warning="gps_status == 'unknown'"/>
                <field name="satellites"/>
                <field name="import_batch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Telemetry Log – Form View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_ev_telemetry_log_form" model="ir.ui.view">
        <field name="name">ev.telemetry.log.form</field>
        <field name="model">ev.telemetry.log</field>
        <field name="arch" type="xml">
            <form string="Telemetry Log">
                <header>
                    <button name="action_view_on_map" type="object"
                            string="📍 View on Map" class="btn-secondary"
                            invisible="not latitude and not longitude"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Device / Vehicle">
                            <field name="device_id"/>
                            <field name="vehicle_id"/>
                            <field name="timestamp"/>
                            <field name="log_date"/>
                        </group>
                        <group string="Import Info">
                            <field name="import_batch_id"/>
                            <field name="raw_import_source"/>
                        </group>
                    </group>
                    <group string="GPS Position">
                        <group>
                            <field name="latitude" digits="[10,6]"/>
                            <field name="longitude" digits="[10,6]"/>
                            <field name="altitude"/>
                            <field name="heading"/>
                        </group>
                        <group>
                            <field name="gps_status" widget="badge"/>
                            <field name="satellites"/>
                        </group>
                    </group>
                    <group string="Motion &amp; Power">
                        <group>
                            <field name="speed"/>
                            <field name="odometer"/>
                            <field name="ignition" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="battery_voltage"/>
                        </group>
                    </group>
                    <group string="Raw Payload" invisible="not raw_payload">
                        <field name="raw_payload" widget="text" nolabel="1"
                               style="font-family: monospace; font-size: 12px; color: #475569;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Telemetry Log – Search View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_ev_telemetry_log_search" model="ir.ui.view">
        <field name="name">ev.telemetry.log.search</field>
        <field name="model">ev.telemetry.log</field>
        <field name="arch" type="xml">
            <search string="Search Telemetry Logs">
                <field name="name"/>
                <field name="device_id"/>
                <field name="vehicle_id"/>
                <field name="import_batch_id"/>
                <filter string="Ignition ON" name="filter_ignition_on" domain="[('ignition', '=', True)]"/>
                <filter string="GPS Active" name="filter_gps_active" domain="[('gps_status', '=', 'A')]"/>
                <filter string="GPS Void (No Fix)" name="filter_gps_void" domain="[('gps_status', '=', 'V')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('log_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Device" name="group_by_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'log_date'}"/>
                    <filter string="GPS Status" name="group_by_gps" context="{'group_by': 'gps_status'}"/>
                    <filter string="Import Batch" name="group_by_batch" context="{'group_by': 'import_batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Action
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_ev_telemetry_log" model="ir.actions.act_window">
        <field name="name">Telemetry Logs</field>
        <field name="res_model">ev.telemetry.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ev_telemetry_log_search"/>
        <field name="context">{'search_default_filter_gps_active': 1}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Menu
    ═══════════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_ev_telemetry_log"
              name="Telemetry Logs"
              parent="ev_battery_dashboard.menu_ev_battery_root"
              action="action_ev_telemetry_log"
              sequence="26"/>

</odoo>
