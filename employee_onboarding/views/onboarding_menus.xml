<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu - Only visible to HR Administrator -->
    <menuitem
        id="menu_employee_onboarding_root"
        name="Employee Onboarding"
        sequence="10"
        web_icon="employee_onboarding,static/description/icon.png"
        groups="hr.group_hr_manager"/>

    <!-- Onboarding / Offboarding -->
    <menuitem
        id="menu_employee_onboarding"
        name="Onboarding / Offboarding"
        parent="menu_employee_onboarding_root"
        action="action_employee_onboarding_offboarding"
        sequence="1"
        groups="hr.group_hr_manager"/>

    <!-- Resignation -->
    <menuitem
        id="menu_employee_resignation"
        name="Resignations"
        parent="menu_employee_onboarding_root"
        action="action_employee_resignation"
        sequence="5"
        groups="hr.group_hr_manager"/>

    <!-- Configuration -->
    <menuitem
        id="menu_employee_onboarding_config"
        name="Configuration"
        parent="menu_employee_onboarding_root"
        sequence="99"
        groups="hr.group_hr_manager"/>

    <!-- Configuration > Request Types -->
    <menuitem
        id="menu_boarding_request_type"
        name="Request Types"
        parent="menu_employee_onboarding_config"
        action="action_boarding_request_type"
        sequence="1"
        groups="hr.group_hr_manager"/>

    <!-- Configuration > Teams -->
    <menuitem
        id="menu_request_type_team"
        name="Teams"
        parent="menu_employee_onboarding_config"
        action="action_request_type_team"
        sequence="2"
        groups="hr.group_hr_manager"/>

</odoo>