        web_icon="employee_onboarding,static/description/icon.png"/>

    <!-- Onboarding / Offboarding -->
    <menuitem
        id="menu_employee_onboarding"
        name="Onboarding / Offboarding"
        parent="menu_employee_onboarding_root"
        action="action_employee_onboarding_offboarding"
        sequence="1"/>

    <!-- Resignation -->
    <menuitem
        id="menu_employee_resignation"
        name="Resignations"
        parent="menu_employee_onboarding_root"
