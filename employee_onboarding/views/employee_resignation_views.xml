<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Resignation Reference Sequence -->
    <data noupdate="1">
        <record id="seq_employee_resignation" model="ir.sequence">
            <field name="name">Employee Resignation Sequence</field>
            <field name="code">employee.resignation.sequence</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- List View -->
    <record id="view_employee_resignation_list" model="ir.ui.view">
        <field name="name">employee.resignation.list</field>
        <field name="model">employee.resignation</field>
        <field name="arch" type="xml">
            <list string="Resignations"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="department_id"/>
                <field name="resignation_date"/>
                <field name="last_working_day"/>
                <field name="reason"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_employee_resignation_form" model="ir.ui.view">
        <field name="name">employee.resignation.form</field>
        <field name="model">employee.resignation</field>
        <field name="arch" type="xml">
            <form string="Employee Resignation">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="hr.group_hr_user"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'submitted'"
                            groups="hr.group_hr_user"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="employee_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="employee_code"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id"/>
                            <field name="emp_date_of_joining"/>
                        </group>
                        <group string="Resignation Details">
                            <field name="resignation_date" readonly="state != 'draft'"/>
                            <field name="last_working_day" readonly="state != 'draft'"/>
                            <field name="approved_last_working_day" readonly="state not in ('draft', 'submitted')"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resignation Letter">
                            <field name="resignation_body" readonly="state != 'draft'" placeholder="Write details / explanation for resignation here..."/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_employee_resignation_search" model="ir.ui.view">
        <field name="name">employee.resignation.search</field>
        <field name="model">employee.resignation</field>
        <field name="arch" type="xml">
            <search string="Resignations">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_employee_resignation" model="ir.actions.act_window">
        <field name="name">Resignations</field>
        <field name="res_model">employee.resignation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_resignation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Employee Resignation request.
            </p>
        </field>
    </record>

</odoo>
