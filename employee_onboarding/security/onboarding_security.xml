<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rule for Boarding Request Type -->
    <record id="boarding_request_type_comp_rule" model="ir.rule">
        <field name="name">Boarding Request Type: multi-company</field>
        <field name="model_id" ref="model_boarding_request_type"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <!-- Multi-company record rule for Employee Onboarding/Offboarding -->
    <record id="employee_onboarding_offboarding_comp_rule" model="ir.rule">
        <field name="name">Employee Onboarding Offboarding: multi-company</field>
        <field name="model_id" ref="model_employee_onboarding_offboarding"/>
        <field name="domain_force">
            [
                '|',
                ('onboarding_company_id', 'in', company_ids),
                ('offboarding_company_id', 'in', company_ids)
            ]
        </field>
    </record>

    <!-- Multi-company record rule for Employee Resignation -->
    <record id="employee_resignation_comp_rule" model="ir.rule">
        <field name="name">Employee Resignation: multi-company</field>
        <field name="model_id" ref="model_employee_resignation"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <!-- Custom Access Rights Category -->
    <record id="module_category_employee_onboarding"
            model="ir.module.category">
        <field name="name">Employee Onboarding</field>
        <field name="description">
            Employee Onboarding and Offboarding Access Rights
        </field>
        <field name="sequence">35</field>
    </record>

    <!-- Offboarding Administrator -->
    <record id="group_offboarding_admin" model="res.groups">
        <field name="name">Offboarding Administrator</field>
    </record>

    <!-- Offboarding Manager -->
    <record id="group_offboarding_manager" model="res.groups">
        <field name="name">Offboarding Manager</field>
    </record>
    <!-- Managers can only see requests of their reporting employees -->
    <record id="employee_onboarding_manager_rule" model="ir.rule">
        <field name="name">Onboarding: Reporting Manager Only</field>
        <field name="model_id"
            ref="model_employee_onboarding_offboarding"/>
        <field name="groups"
            eval="[(4, ref('employee_onboarding.group_offboarding_manager'))]"/>
        <field name="domain_force">
            [
                '|',
                ('onboarding_manager_id.user_id', '=', user.id),
                ('offboarding_manager_id.user_id', '=', user.id)
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Managers can only see their own assigned manager tasks -->
    <record id="employee_onboarding_task_manager_rule" model="ir.rule">
        <field name="name">Onboarding Tasks: Reporting Manager Only</field>
        <field name="model_id" ref="model_employee_onboarding_task"/>
        <field name="groups"
            eval="[(4, ref('employee_onboarding.group_offboarding_manager'))]"/>
        <field name="domain_force">
            [
                '|',
                ('onboarding_id.onboarding_manager_id.user_id', '=', user.id),
                ('onboarding_id.offboarding_manager_id.user_id', '=', user.id)
            ]
        </field>
    </record>
    <!-- Employees and their reporting managers can see relevant resignations -->
    <record id="employee_resignation_manager_rule" model="ir.rule">
        <field name="name">Resignation: Own Employees and Reporting Team</field>
        <field name="model_id" ref="model_employee_resignation"/>
        <field name="groups"
            eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            [
                '|',
                ('employee_id.user_id', '=', user.id),
                ('manager_id.user_id', '=', user.id)
            ]
        </field>
    </record>

</odoo>