<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hdfc_bank_config_list" model="ir.ui.view">
        <field name="name">hdfc.bank.config.list</field>
        <field name="model">hdfc.bank.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="environment" widget="badge"
                       decoration-info="environment == 'mock'"
                       decoration-warning="environment == 'uat'"
                       decoration-success="environment == 'prod'"/>
                <field name="debit_account_number"/>
                <field name="journal_id"/>
                <field name="salary_entry_mode"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hdfc_bank_config_form" model="ir.ui.view">
        <field name="name">hdfc.bank.config.form</field>
        <field name="model">hdfc.bank.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Mock" bg_color="text-bg-info" invisible="environment != 'mock' or not active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. HDFC Salary Account"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="base_url" invisible="environment == 'mock'" required="environment != 'mock'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="debit_account_number" required="1"/>
                            <field name="debit_ifsc" required="1"/>
                            <field name="debit_account_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credentials" name="credentials">
                            <group>
                                <group string="Identity">
                                    <field name="corporate_id" required="environment != 'mock'"/>
                                    <field name="hdfc_user_id"/>
                                    <field name="aggregator_id"/>
                                    <field name="client_id"/>
                                </group>
                                <group string="Secrets" groups="base.group_system">
                                    <field name="client_secret" password="True"/>
                                    <field name="api_key" password="True"/>
                                    <field name="client_private_key" filename="client_private_key_name"/>
                                    <field name="client_private_key_name" invisible="1"/>
                                    <field name="client_certificate" filename="client_certificate_name"/>
                                    <field name="client_certificate_name" invisible="1"/>
                                    <field name="bank_public_certificate" filename="bank_public_certificate_name"/>
                                    <field name="bank_public_certificate_name" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Payment Rules" name="rules">
                            <group>
                                <group string="Transfer Mode">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="rtgs_threshold"/>
                                    <field name="allow_imps"/>
                                    <field name="max_lines_per_batch"/>
                                    <field name="narration_template"/>
                                </group>
                                <group string="Approval &amp; Safety">
                                    <field name="otp_validity_minutes"/>
                                    <field name="otp_max_attempts"/>
                                    <field name="require_trusted_accounts"/>
                                    <field name="log_retention_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group>
                                    <field name="journal_id" required="1" options="{'no_create': True}"/>
                                    <field name="salary_entry_mode" widget="radio"/>
                                    <field name="salary_payable_account_id"
                                           invisible="salary_entry_mode != 'payable'"
                                           required="salary_entry_mode == 'payable'"
                                           options="{'no_create': True}"/>
                                    <field name="salary_expense_account_id"
                                           invisible="salary_entry_mode != 'expense'"
                                           required="salary_entry_mode == 'expense'"
                                           options="{'no_create': True}"/>
                                    <field name="credit_account_id" required="1" options="{'no_create': True}"/>
                                    <field name="auto_post"/>
                                </group>
                                <group>
                                    <div class="text-muted" colspan="2">
                                        When HDFC confirms a transfer, an entry is posted in the bank journal:
                                        debit the salary account (one line per employee),
                                        credit the outstanding payments account (one line per batch),
                                        to be reconciled with the bank statement.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hdfc_bank_config" model="ir.actions.act_window">
        <field name="name">HDFC Bank Settings</field>
        <field name="res_model">hdfc.bank.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
