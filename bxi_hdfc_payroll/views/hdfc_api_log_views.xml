<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hdfc_api_log_list" model="ir.ui.view">
        <field name="name">hdfc.api.log.list</field>
        <field name="model">hdfc.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="not success">
                <field name="create_date" string="Date"/>
                <field name="batch_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="operation"/>
                <field name="environment"/>
                <field name="success"/>
                <field name="duration_ms"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hdfc_api_log_form" model="ir.ui.view">
        <field name="name">hdfc.api.log.form</field>
        <field name="model">hdfc.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="batch_id"/>
                            <field name="config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="environment"/>
                            <field name="success"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Error" invisible="success">
                        <field name="error" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Request (masked)">
                        <field name="request_masked" nolabel="1" colspan="2" class="font-monospace"/>
                    </group>
                    <group string="Response (masked)">
                        <field name="response_masked" nolabel="1" colspan="2" class="font-monospace"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hdfc_api_log_search" model="ir.ui.view">
        <field name="name">hdfc.api.log.search</field>
        <field name="model">hdfc.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_id"/>
                <filter name="errors" string="Errors" domain="[('success', '=', False)]"/>
                <group>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hdfc_api_log" model="ir.actions.act_window">
        <field name="name">HDFC API Logs</field>
        <field name="res_model">hdfc.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
