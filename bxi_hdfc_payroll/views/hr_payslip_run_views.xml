<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_form_hdfc" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.hdfc</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_hdfc_release" type="object" string="Pay via HDFC" class="btn-primary"
                        invisible="state == 'draft'"
                        groups="bxi_hdfc_payroll.group_hdfc_payout_user"/>
            </xpath>
        </field>
    </record>
</odoo>
