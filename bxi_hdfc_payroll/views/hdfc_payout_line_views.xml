<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hdfc_payout_line_list" model="ir.ui.view">
        <field name="name">hdfc.payout.line.list</field>
        <field name="model">hdfc.payout.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="state == 'paid'"
                  decoration-danger="state in ('failed', 'returned')"
                  decoration-muted="state in ('cancelled', 'reversed')">
                <field name="batch_id"/>
                <field name="line_reference" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="employee_id"/>
                <field name="payslip_id"/>
                <field name="account_number_masked"/>
                <field name="ifsc"/>
                <field name="txn_type"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="utr"/>
                <field name="value_date" optional="show"/>
                <field name="failure_reason" optional="show"/>
                <field name="move_id" optional="hide"/>
                <field name="reversal_move_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hdfc_payout_line_search" model="ir.ui.view">
        <field name="name">hdfc.payout.line.search</field>
        <field name="model">hdfc.payout.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="batch_id"/>
                <field name="utr"/>
                <field name="line_reference"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="failed" string="Failed / Returned" domain="[('state', 'in', ('failed', 'returned'))]"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('draft', 'submitted', 'processing'))]"/>
                <group>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'txn_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hdfc_payout_line" model="ir.actions.act_window">
        <field name="name">HDFC Transfers</field>
        <field name="res_model">hdfc.payout.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
