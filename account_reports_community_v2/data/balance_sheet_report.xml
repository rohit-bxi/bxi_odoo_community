<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Grouped by account.account.account_type (a fixed vocabulary, not
            chart-of-accounts-specific), unlike Trial Balance's per-account
            groupby="account_id"; Balance Sheet needs a small, static
            hierarchy so it reuses the generic ReportLines renderer as-is,
            with no frontend changes.

            Sign convention: asset accounts are debit-normal (their raw
            'balance' is already positive when healthy), so they use
            subformula="sum". Liability/equity/income accounts are
            credit-normal (raw balance is negative when healthy), so they use
            subformula="-sum" to display as positive figures, matching how a
            printed Balance Sheet is normally read.

            "Current Year Earnings" is computed directly here (income minus
            expense for the fiscal year to date) rather than read from any
            'equity_unaffected' account balance, since that account is only
            populated by an actual year-end closing entry, which this
            module doesn't perform. Combining a single domain over both
            income and expense account types with subformula="-sum" gives
            exactly (revenue - expense) in one expression, since income
            accounts are credit-normal and expense accounts are debit-normal.

            Every leaf line also sets groupby="account_id" and foldable=True,
            reusing the exact same mechanism Trial Balance uses for its
            per-account rows (see account_report_line.py's
            _build_groupby_row): each category collapses to a single total by
            default, and expanding it lists the individual accounts (with
            code) behind that figure, each with the same General
            Ledger/Journal Items drill-down menu Trial Balance rows have.
        -->
        <record id="balance_sheet_report" model="account.report">
            <field name="name">Balance Sheet</field>
            <field name="filter_date_range" eval="True"/>
            <field name="availability_condition">always</field>
            <field name="column_ids">
                <record id="bs_col_balance" model="account.report.column">
                    <field name="name">Balance</field>
                    <field name="expression_label">balance</field>
                    <field name="figure_type">monetary</field>
                </record>
            </field>
            <field name="line_ids">

                <record id="bs_line_assets" model="account.report.line">
                    <field name="name">ASSETS</field>
                    <field name="code">BS_ASSETS</field>
                    <field name="sequence">10</field>
                    <field name="children_ids">
                        <record id="bs_line_assets_current" model="account.report.line">
                            <field name="name">Current Assets</field>
                            <field name="code">BS_ASSETS_CURRENT</field>
                            <field name="sequence">1</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_assets_current" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['asset_receivable', 'asset_cash', 'asset_current', 'asset_prepayments'])]</field>
                                    <field name="subformula">sum</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_assets_noncurrent" model="account.report.line">
                            <field name="name">Non-current Assets</field>
                            <field name="code">BS_ASSETS_NONCURRENT</field>
                            <field name="sequence">2</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_assets_noncurrent" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['asset_non_current', 'asset_fixed'])]</field>
                                    <field name="subformula">sum</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_assets_total" model="account.report.line">
                            <field name="name">Total Assets</field>
                            <field name="code">BS_ASSETS_TOTAL</field>
                            <field name="sequence">3</field>
                            <field name="expression_ids">
                                <record id="bs_expr_assets_total" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">aggregation</field>
                                    <field name="formula">BS_ASSETS_CURRENT.balance + BS_ASSETS_NONCURRENT.balance</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                    </field>
                </record>

                <record id="bs_line_liabilities" model="account.report.line">
                    <field name="name">LIABILITIES</field>
                    <field name="code">BS_LIAB</field>
                    <field name="sequence">20</field>
                    <field name="children_ids">
                        <record id="bs_line_liab_current" model="account.report.line">
                            <field name="name">Current Liabilities</field>
                            <field name="code">BS_LIAB_CURRENT</field>
                            <field name="sequence">1</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_liab_current" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['liability_payable', 'liability_credit_card', 'liability_current'])]</field>
                                    <field name="subformula">-sum</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_liab_noncurrent" model="account.report.line">
                            <field name="name">Non-current Liabilities</field>
                            <field name="code">BS_LIAB_NONCURRENT</field>
                            <field name="sequence">2</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_liab_noncurrent" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['liability_non_current'])]</field>
                                    <field name="subformula">-sum</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_liab_total" model="account.report.line">
                            <field name="name">Total Liabilities</field>
                            <field name="code">BS_LIAB_TOTAL</field>
                            <field name="sequence">3</field>
                            <field name="expression_ids">
                                <record id="bs_expr_liab_total" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">aggregation</field>
                                    <field name="formula">BS_LIAB_CURRENT.balance + BS_LIAB_NONCURRENT.balance</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                    </field>
                </record>

                <record id="bs_line_equity" model="account.report.line">
                    <field name="name">EQUITY</field>
                    <field name="code">BS_EQUITY</field>
                    <field name="sequence">30</field>
                    <field name="children_ids">
                        <record id="bs_line_equity_accounts" model="account.report.line">
                            <field name="name">Equity</field>
                            <field name="code">BS_EQUITY_ACCOUNTS</field>
                            <field name="sequence">1</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_equity_accounts" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['equity', 'equity_unaffected'])]</field>
                                    <field name="subformula">-sum</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_current_earnings" model="account.report.line">
                            <field name="name">Current Year Earnings</field>
                            <field name="code">BS_CURRENT_EARNINGS</field>
                            <field name="sequence">2</field>
                            <field name="groupby">account_id</field>
                            <field name="foldable" eval="True"/>
                            <field name="expression_ids">
                                <record id="bs_expr_current_earnings" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">domain</field>
                                    <field name="formula">[('account_id.account_type', 'in', ['income', 'income_other', 'expense', 'expense_other', 'expense_depreciation', 'expense_direct_cost'])]</field>
                                    <field name="subformula">-sum</field>
                                    <field name="date_scope">from_fiscalyear</field>
                                </record>
                            </field>
                        </record>
                        <record id="bs_line_equity_total" model="account.report.line">
                            <field name="name">Total Equity</field>
                            <field name="code">BS_EQUITY_TOTAL</field>
                            <field name="sequence">3</field>
                            <field name="expression_ids">
                                <record id="bs_expr_equity_total" model="account.report.expression">
                                    <field name="label">balance</field>
                                    <field name="engine">aggregation</field>
                                    <field name="formula">BS_EQUITY_ACCOUNTS.balance + BS_CURRENT_EARNINGS.balance</field>
                                    <field name="date_scope">from_beginning</field>
                                </record>
                            </field>
                        </record>
                    </field>
                </record>

                <record id="bs_line_total_liab_equity" model="account.report.line">
                    <field name="name">Total Liabilities + Equity</field>
                    <field name="code">BS_LIAB_EQUITY_TOTAL</field>
                    <field name="sequence">40</field>
                    <field name="expression_ids">
                        <record id="bs_expr_total_liab_equity" model="account.report.expression">
                            <field name="label">balance</field>
                            <field name="engine">aggregation</field>
                            <field name="formula">BS_LIAB_TOTAL.balance + BS_EQUITY_TOTAL.balance</field>
                            <field name="date_scope">from_beginning</field>
                        </record>
                    </field>
                </record>

            </field>
        </record>

    </data>
</odoo>
