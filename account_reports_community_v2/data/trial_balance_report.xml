<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="trial_balance_report" model="account.report">
            <field name="name">Trial Balance</field>
            <field name="filter_date_range" eval="True"/>
            <field name="filter_period_comparison" eval="True"/>
            <field name="filter_unfold_all" eval="True"/>
            <field name="availability_condition">always</field>
            <field name="column_ids">
                <record id="trial_balance_column_initial" model="account.report.column">
                    <field name="name">Initial Balance</field>
                    <field name="expression_label">initial_balance</field>
                    <field name="figure_type">monetary</field>
                </record>
                <record id="trial_balance_column_debit" model="account.report.column">
                    <field name="name">Debit</field>
                    <field name="expression_label">period_debit</field>
                    <field name="figure_type">monetary</field>
                </record>
                <record id="trial_balance_column_credit" model="account.report.column">
                    <field name="name">Credit</field>
                    <field name="expression_label">period_credit</field>
                    <field name="figure_type">monetary</field>
                </record>
                <record id="trial_balance_column_end" model="account.report.column">
                    <field name="name">End Balance</field>
                    <field name="expression_label">end_balance</field>
                    <field name="figure_type">monetary</field>
                </record>
            </field>
            <field name="line_ids">
                <record id="trial_balance_line_accounts" model="account.report.line">
                    <field name="name">Accounts</field>
                    <field name="code">TBALL</field>
                    <field name="sequence">10</field>
                    <field name="groupby">account_id</field>
                    <field name="expression_ids">
                        <record id="trial_balance_expr_initial" model="account.report.expression">
                            <field name="label">initial_balance</field>
                            <field name="engine">domain</field>
                            <field name="formula">[]</field>
                            <field name="subformula">sum</field>
                            <field name="date_scope">to_beginning_of_period</field>
                        </record>
                        <record id="trial_balance_expr_debit" model="account.report.expression">
                            <field name="label">period_debit</field>
                            <field name="engine">domain</field>
                            <field name="formula">[]</field>
                            <field name="subformula">sum_debit</field>
                            <field name="date_scope">strict_range</field>
                        </record>
                        <record id="trial_balance_expr_credit" model="account.report.expression">
                            <field name="label">period_credit</field>
                            <field name="engine">domain</field>
                            <field name="formula">[]</field>
                            <field name="subformula">sum_credit</field>
                            <field name="date_scope">strict_range</field>
                        </record>
                        <record id="trial_balance_expr_end" model="account.report.expression">
                            <field name="label">end_balance</field>
                            <field name="engine">domain</field>
                            <field name="formula">[]</field>
                            <field name="subformula">sum</field>
                            <field name="date_scope">from_beginning</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>

    </data>
</odoo>
