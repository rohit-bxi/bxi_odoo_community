<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Minimal bootstrap records so Default Team / Default Category work without full demo data -->
        <record id="dummy_helpdesk_team_default" model="helpdesk.team">
            <field name="name">General Support</field>
            <field name="description">Default helpdesk team created on install. Adjust members and settings under Helpdesk, Configuration.</field>
            <field name="active">True</field>
        </record>

        <record id="dummy_helpdesk_category_general" model="helpdesk.category">
            <field name="name">General Inquiry</field>
            <field name="description">Default category for uncategorized tickets.</field>
            <field name="sequence">5</field>
            <field name="color">1</field>
            <field name="active">True</field>
            <field name="default_team_id" ref="dummy_helpdesk_team_default"/>
        </record>
    </data>
</odoo>
