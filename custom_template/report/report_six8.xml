<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="six8_life_science_layout">
        <style>
.footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    min-height: 70px;
    z-index: 9999;
}

.page:last-child {
    page-break-after: auto !important;
}
</style>

        <t t-set="company"
           t-value="o.template_company_id or res_company"/>

        <style>
            /* =========================================
               PAGE AND BASE STYLES
               ========================================= */
            html,
            body {
                margin: 0 !important;
                padding: 0 !important;
                font-family: Arial, sans-serif;
            }

            .six8-page {
                position: relative;
                width: 100%;
                margin: 0;
                padding: 0;
                background: #ffffff;
            }

            /* =========================================
               HEADER
               ========================================= */
            .six8-header {
                position: relative;
                width: 100%;
                height: 112px;
                margin: 0;
                padding: 0;
                overflow: hidden;
                box-sizing: border-box;
                background: #ffffff;
            }

            .six8-header-shape {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 112px;
                display: block;
            }

            .six8-header-logo {
                position: absolute;
                top: 23px;
                right: 28px;
                width: 155px;
                text-align: right;
                z-index: 2;
            }

            .six8-header-logo img {
                display: inline-block;
                max-width: 150px;
                max-height: 52px;
                width: auto;
                height: auto;
                border: 0;
            }

            /* =========================================
               REPORT CONTENT
               ========================================= */
            .six8-content {
                margin: 0;
                padding: 22px 32px 130px 32px;
                box-sizing: border-box;
                color: #222222;
                font-size: 11pt;
                line-height: 1.4;
                background: #ffffff;
            }

            .six8-content table {
                max-width: 100%;
                page-break-inside: auto;
            }

            .six8-content tr {
                page-break-inside: avoid;
            }

            /* =========================================
               FOOTER
               ========================================= */
            .six8-footer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                width: 100%;
                height: 112px;
                margin: 0;
                padding: 0;
                overflow: hidden;
                box-sizing: border-box;
                background: #ffffff;
                font-family: Arial, sans-serif;
                z-index: 10;
            }

            .six8-footer-table {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 98px;
                border-collapse: collapse;
                table-layout: fixed;
                z-index: 2;
            }

            .six8-footer-left {
                width: 72%;
                vertical-align: bottom;
                padding: 0 5px 17px 32px;
                color: #16365f;
                font-size: 9pt;
                line-height: 14px;
                text-align: left;
                overflow-wrap: break-word;
            }

            .six8-footer-company {
                margin-bottom: 2px;
                color: #16365f;
                font-size: 12pt;
                line-height: 18px;
                font-weight: bold;
            }

            .six8-footer-cin {
                margin-bottom: 6px;
                font-weight: bold;
            }

            .six8-footer-address-label {
                font-weight: bold;
            }

            .six8-footer-right {
                width: 28%;
                vertical-align: bottom;
                text-align: center;
                padding: 0 15px 19px 0;
            }

            .six8-footer-right img {
                display: inline-block;
                max-width: 145px;
                max-height: 45px;
                width: auto;
                height: auto;
                border: 0;
            }

            /* Bottom color strip touches the footer's bottom edge */
            .six8-footer-shape {
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 18px;
                display: block;
                z-index: 1;
            }

            /* =========================================
               PRINT / PDF
               ========================================= */
            .page:last-child {
                page-break-after: auto !important;
            }
        </style>

        <div class="six8-page">

            <!-- =====================================
                 HEADER
                 ===================================== -->
            <div class="header six8-header">

                <svg class="six8-header-shape"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 1000 130"
                     preserveAspectRatio="none">

                    <!-- Thin top border -->
                    <path d="M0,0 L1000,0 L1000,4 L0,4 Z"
                          fill="#147f91"/>

                    <!-- Navy curved banner -->
                    <path d="M0,4
                             L1000,4
                             L1000,18
                             C760,22 520,30 300,53
                             C175,66 75,92 0,115 Z"
                          fill="#123f78"/>

                    <!-- Teal accent -->
                    <path d="M0,111
                             C120,82 245,58 385,43
                             C250,62 120,92 0,120 Z"
                          fill="#147f91"/>
                </svg>

                <div class="six8-header-logo">
                    <t t-if="company.logo_web">
                        <img t-att-src="image_data_uri(company.logo_web)"
                             alt="SIX8 Life Science Logo"/>
                    </t>
                </div>

            </div>

            <!-- =====================================
                 REPORT CONTENT
                 ===================================== -->
            <div class="article six8-content"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id">

                <t t-out="0"/>

            </div>

            <!-- =====================================
                 FOOTER
                 ===================================== -->
            <div class="footer six8-footer">

                <svg class="six8-footer-shape"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 1000 55"
                     preserveAspectRatio="none">

                    <!-- Teal accent line -->
                    <path d="M0,38
                             C250,48 650,48 1000,17
                             L1000,21
                             C650,52 250,53 0,42 Z"
                          fill="#147f91"/>

                    <!-- Navy bottom banner -->
                    <path d="M0,42
                             C300,52 650,51 1000,21
                             L1000,55 L0,55 Z"
                          fill="#123f78"/>
                </svg>

                <table class="six8-footer-table">
                    <tr>

                        <!-- COMPANY DETAILS -->
                        <td class="six8-footer-left">

                            <div class="six8-footer-company">
                                <t t-esc="company.name"/>
                            </div>

                            <div class="six8-footer-cin">
                                Corporate Identification Number:
                                <t t-esc="company.company_registry or 'ADA-9134'"/>
                            </div>

                            <div>
                                <span class="six8-footer-address-label">
                                    Registered Office:
                                </span>
                                <br/>

                                <t t-if="company.street">
                                    <t t-esc="company.street"/>,
                                </t>

                                <t t-if="company.street2">
                                    <t t-esc="company.street2"/>,
                                </t>

                                <t t-if="company.city">
                                    <t t-esc="company.city"/>,
                                </t>

                                <t t-if="company.state_id">
                                    <t t-esc="company.state_id.name"/>,
                                </t>

                                <t t-if="company.zip">
                                    <t t-esc="company.zip"/>
                                </t>
                            </div>

                        </td>

                        <!-- FOOTER LOGO -->
                        <td class="six8-footer-right">
                            <t t-if="company.logo_web">
                                <img t-att-src="image_data_uri(company.logo_web)"
                                     alt="SIX8 Life Science Logo"/>
                            </t>
                        </td>

                    </tr>
                </table>

            </div>

        </div>

    </template>

</odoo>
