<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="six8_life_science_layout">

        <t t-set="company"
           t-value="o.template_company_id or res_company"/>

        <style>
            @media print {
                .six8_header {
                    position: relative;
                    width: 100%;
                    height: 95px;
                    overflow: hidden;
                    margin: 0;
                    padding: 0;
                }

                .six8_footer {
                    position: relative;
                    width: 100%;
                    height: 85px;
                    overflow: hidden;
                    margin: 0;
                    padding: 0;
                }

                .six8_article {
                    padding: 20px 20px 100px 20px;
                    box-sizing: border-box;
                }
            }

            .six8_header,
            .six8_footer {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        </style>

        <!-- ================= HEADER ================= -->
        <div class="header six8_header"
             style="
                height:95px;
                width:100%;
                background:#ffffff;
                overflow:hidden;
                margin:0;
                padding:0;
             ">

            <!-- CURVED NAVY HEADER -->
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 1000 95"
                 preserveAspectRatio="none"
                 style="
                    position:absolute;
                    top:0;
                    left:0;
                    width:100%;
                    height:95px;
                 ">

                <path d="M0,0 H1000 V5
                         C760,2 420,8 0,88 Z"
                      fill="#0b2a6f"/>

                <path d="M0,0 H1000 V3
                         C760,0 420,6 0,84 Z"
                      fill="#14609c"/>
            </svg>

            <!-- HEADER LOGO: RIGHT SIDE -->
            <table style="
                position:relative;
                z-index:2;
                width:100%;
                height:95px;
                border-collapse:collapse;
            ">
                <tr>
                    <td style="width:75%;"></td>

                    <td style="
                        width:25%;
                        text-align:right;
                        vertical-align:middle;
                        padding:0 30px 0 0;
                    ">
                        <t t-if="company.logo_web">
                            <img t-att-src="image_data_uri(company.logo_web)"
                                 style="
                                    max-height:60px;
                                    max-width:180px;
                                    width:auto;
                                "/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>

        <!-- ================= REPORT BODY ================= -->
        <div class="article six8_article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="
                padding:20px 20px 100px 20px;
                box-sizing:border-box;
             ">

            <t t-out="0"/>
        </div>

        <!-- ================= FOOTER ================= -->
        <div class="footer six8_footer"
             style="
                height:85px;
                width:100%;
                position:relative;
                overflow:hidden;
                background:#0b2a6f;
                color:#ffffff;
                font-size:11px;
                margin:0;
                padding:0;
             ">

            <!-- CURVED CYAN AND GREEN STRIPS -->
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 1000 85"
                 preserveAspectRatio="none"
                 style="
                    position:absolute;
                    top:0;
                    left:0;
                    width:100%;
                    height:85px;
                 ">

                <path d="M0,0
                         C250,20 620,15 1000,0
                         L1000,15
                         C620,30 250,35 0,15 Z"
                      fill="#159bc3"/>

                <path d="M0,15
                         C250,35 620,30 1000,15
                         L1000,22
                         C620,37 250,42 0,22 Z"
                      fill="#20b59a"/>
            </svg>

            <!-- FOOTER DETAILS -->
            <table style="
                position:relative;
                z-index:2;
                width:100%;
                height:85px;
                table-layout:fixed;
                border-collapse:collapse;
            ">
                <tr>
                    <!-- COMPANY ADDRESS -->
                    <td style="
                        width:48%;
                        vertical-align:middle;
                        padding:22px 0 3px 15px;
                        color:#ffffff;
                        line-height:14px;
                        font-size:10px;
                    ">
                        <strong>
                            <t t-esc="company.name"/>
                        </strong>
                        <br/>

                        <t t-esc="company.street or ''"/>

                        <t t-if="company.street2">
                            , <t t-esc="company.street2"/>
                        </t>

                        <br/>

                        <t t-esc="company.city or ''"/>

                        <t t-if="company.state_id">
                            , <t t-esc="company.state_id.name"/>
                        </t>

                        <t t-if="company.zip">
                            - <t t-esc="company.zip"/>
                        </t>

                        <t t-if="company.country_id">
                            , <t t-esc="company.country_id.name"/>
                        </t>
                    </td>

                    <!-- EMAIL AND CIN -->
                    <td style="
                        width:32%;
                        text-align:right;
                        vertical-align:middle;
                        padding:22px 12px 3px 0;
                        line-height:15px;
                        font-size:10px;
                        color:#ffffff;
                        overflow-wrap:anywhere;
                    ">
                        <div>
                            Email:
                            <t t-esc="company.email or ''"/>
                        </div>

                        <div>
                            CIN:
                            <t t-esc="company.company_registry or ''"/>
                        </div>
                    </td>

                    <!-- FOOTER LOGO: RIGHT SIDE -->
                    <td style="
                        width:20%;
                        text-align:right;
                        vertical-align:middle;
                        padding:22px 15px 3px 0;
                    ">
                        <t t-if="company.logo_web">
                            <img t-att-src="image_data_uri(company.logo_web)"
                                 style="
                                    max-height:42px;
                                    max-width:125px;
                                    width:auto;
                                "/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>

    </template>
</odoo>