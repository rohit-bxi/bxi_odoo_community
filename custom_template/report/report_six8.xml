<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="six8_life_science_layout">

        <t t-set="company"
           t-value="o.template_company_id or res_company"/>

        <style>
            .six8_header {
                position: relative;
                height: 100px;
                width: 100%;
                margin: 0;
                padding: 0;
                overflow: hidden;
                border: none !important;
                outline: none !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .six8_header table,
            .six8_header td,
            .six8_footer table,
            .six8_footer td {
                border: none !important;
                outline: none !important;
            }

            .six8_article {
                margin: 0 !important;
                padding: 45px 20px 110px 20px !important;
                box-sizing: border-box;
                border: none !important;
                outline: none !important;
            }

            .six8_footer {
                position: relative;
                height: 85px;
                width: 100%;
                margin: 0;
                padding: 0;
                overflow: hidden;
                border: none !important;
                outline: none !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        </style>

        <!-- ================= HEADER ================= -->
        <div class="header six8_header"
             style="
                position:relative;
                height:100px;
                width:100%;
                margin:0;
                padding:0;
                overflow:hidden;
                background:#ffffff;
                border:none;
                outline:none;
             ">

            <!-- CURVED NAVY AND BLUE SHAPES -->
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 1000 100"
                 preserveAspectRatio="none"
                 style="
                    position:absolute;
                    top:0;
                    left:0;
                    width:100%;
                    height:100px;
                    border:none;
                 ">
                <path d="M0,0 H1000 V5
                         C760,2 420,8 0,90 Z"
                      fill="#0b2a6f"/>

                <path d="M0,0 H1000 V3
                         C760,0 420,6 0,86 Z"
                      fill="#14609c"/>
            </svg>

            <!-- LOGO ON RIGHT -->
            <table style="
                position:relative;
                z-index:2;
                width:100%;
                height:100px;
                border-collapse:collapse;
                border:none;
                background:transparent;
            ">
                <tr>
                    <td style="width:75%; border:none;"></td>

                    <td style="
                        width:25%;
                        text-align:right;
                        vertical-align:middle;
                        padding:0 30px 0 0;
                        border:none;
                    ">
                        <t t-if="company.logo_web">
                            <img t-att-src="image_data_uri(company.logo_web)"
                                 style="
                                    max-height:55px;
                                    max-width:180px;
                                    width:auto;
                                    border:none;
                                    outline:none;
                                "/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>

        <!-- ================= OFFER LETTER BODY ================= -->
        <div class="article six8_article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="
                margin:0;
                padding:45px 20px 110px 20px;
                box-sizing:border-box;
                border:none;
                outline:none;
             ">

            <t t-out="0"/>

        </div>

        <!-- ================= FOOTER ================= -->
        <div class="footer six8_footer"
             style="
                position:relative;
                height:85px;
                width:100%;
                overflow:hidden;
                background:#0b2a6f;
                color:#ffffff;
                font-size:10px;
                margin:0;
                padding:0;
                border:none;
                outline:none;
             ">

            <!-- CYAN AND GREEN CURVES -->
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 1000 85"
                 preserveAspectRatio="none"
                 style="
                    position:absolute;
                    top:0;
                    left:0;
                    width:100%;
                    height:85px;
                    border:none;
                 ">
                <path d="M0,0
                         C250,20 620,15 1000,0
                         L1000,15
                         C620,30 250,35 0,15 Z"
                      fill="#159bc3"/>

                <path d="M0,15
                         C250,35 620,30 1000,15
                         L1000,22
                         C620,37 250,42 0,22 Z"
                      fill="#20b59a"/>
            </svg>

            <!-- FOOTER INFORMATION -->
            <table style="
                position:relative;
                z-index:2;
                width:100%;
                height:85px;
                table-layout:fixed;
                border-collapse:collapse;
                border:none;
                background:transparent;
            ">
                <tr>
                    <!-- COMPANY ADDRESS -->
                    <td style="
                        width:48%;
                        vertical-align:middle;
                        padding:22px 0 3px 15px;
                        color:#ffffff;
                        line-height:14px;
                        font-size:10px;
                        border:none;
                    ">
                        <strong>
                            <t t-esc="company.name"/>
                        </strong>
                        <br/>

                        <t t-esc="company.street or ''"/>

                        <t t-if="company.street2">
                            , <t t-esc="company.street2"/>
                        </t>

                        <br/>

                        <t t-esc="company.city or ''"/>

                        <t t-if="company.state_id">
                            , <t t-esc="company.state_id.name"/>
                        </t>

                        <t t-if="company.zip">
                            - <t t-esc="company.zip"/>
                        </t>

                        <t t-if="company.country_id">
                            , <t t-esc="company.country_id.name"/>
                        </t>
                    </td>

                    <!-- EMAIL AND CIN -->
                    <td style="
                        width:32%;
                        text-align:right;
                        vertical-align:middle;
                        padding:22px 12px 3px 0;
                        line-height:15px;
                        font-size:10px;
                        color:#ffffff;
                        border:none;
                        overflow-wrap:anywhere;
                    ">
                        <div>
                            Email:
                            <t t-esc="company.email or ''"/>
                        </div>

                        <div>
                            CIN:
                            <t t-esc="company.company_registry or ''"/>
                        </div>
                    </td>

                    <!-- FOOTER LOGO ON RIGHT -->
                    <td style="
                        width:20%;
                        text-align:right;
                        vertical-align:middle;
                        padding:22px 15px 3px 0;
                        border:none;
                    ">
                        <t t-if="company.logo_web">
                            <img t-att-src="image_data_uri(company.logo_web)"
                                 style="
                                    max-height:42px;
                                    max-width:125px;
                                    width:auto;
                                    border:none;
                                "/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>

    </template>
</odoo>