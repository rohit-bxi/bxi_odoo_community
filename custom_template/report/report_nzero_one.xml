<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="bxi_n01_layout">
<style>
.footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 70px;
    width: 100%;
}

.page:last-child {
    page-break-after: auto !important;
}
</style>
            <!-- COMPANY -->
            <t t-set="company"
               t-value="o.template_company_id or res_company"/>

            <!-- HEADER COLOR -->
            <t t-set="header_bg"
               t-value="'#E3E3E3'"/>

                <!-- ================= HEADER ================= -->
                <div t-attf-style="
                    width:100%;
                    height:95px;
                    background:#{header_bg};
                    -webkit-print-color-adjust:exact;
                    print-color-adjust:exact;
                    padding:0 30px;
                    box-sizing:border-box;
                ">

                    <table style="
                        width:100%;
                        height:95px;
                        border-collapse:collapse;
                    ">
                        <tr>

                            <!-- LEFT LOGO -->
                            <td style="
                                width:20%;
                                vertical-align:middle;
                                text-align:right;
                            ">
                                <t t-if="company.logo_web">
                                    <img t-att-src="image_data_uri(company.logo_web)"
                                         style="height:55px; width:auto;"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                </div>

                <!-- ================= BODY ================= -->
                <div style="
                    padding:20px;
                    padding-bottom:90px;
                    box-sizing:border-box;
                ">
                    <t t-out="0"/>
                </div>

                <!-- ================= FOOTER ================= -->
                <div class="footer" style="
                    width:100%;
                    background:#E3E3E3;
                    color:#222;
                    font-size:9px;
                ">

                    <table style="
                        width:100%;
                        table-layout:fixed;
                        border-collapse:collapse;
                    ">

                        <tr>

                            <!-- LEFT DETAILS -->
                            <td style="
                                width:55%;
                                padding:8px 15px;
                                vertical-align:middle;
                                line-height:16px;
                                font-size:11px;
                            ">
                                <strong>
                                    <t t-esc="company.name"/>
                                </strong>
                                <br/>

                                <t t-esc="company.street or ''"/>

                                <t t-if="company.street2">
                                    ,
                                    <t t-esc="company.street2"/>
                                </t>

                                <br/>

                                <t t-esc="company.city or ''"/>

                                <t t-if="company.state_id">
                                    ,
                                    <t t-esc="company.state_id.name"/>
                                </t>

                                <t t-if="company.zip">
                                    -
                                    <t t-esc="company.zip"/>
                                </t>

                                <br/>

                                <t t-esc="company.country_id.name or ''"/>
                            </td>

                            <!-- RIGHT DETAILS (RESTORED) -->
                            <td style="
                                width:25%;
                                text-align:right;
                                vertical-align:middle;
                                padding:8px 15px;
                                line-height:16px;
                                font-size:11px;
                                color:#222;
                            ">

                                <div>
                                    Email:
                                    <t t-esc="company.email or ''"/>
                                </div>
                                <div>
                                    CIN:
                                    <t t-esc="company.company_registry or ''"/>
                                </div>
                            </td>

                            <!-- RIGHT LOGO (RESTORED) -->
                            <td style="
                                width:20%;
                                text-align:right;
                                vertical-align:middle;
                                padding:15px;
                            ">
                                <t t-if="company.logo_web">
                                    <img t-att-src="image_data_uri(company.logo_web)"
                                         style="max-height:45px; width:auto;"/>
                                </t>
                            </td>

                        </tr>
                    </table>

                </div>

    </template>

</odoo> 