<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="bxi_n01_layout">

        <t t-set="company"
           t-value="o.template_company_id or res_company"/>

        <style>
            /* HEADER */
            .n01_header {
                height: 75px !important;
                width: 100%;
                margin: 0;
                padding: 0;
                background-color: #D9D9D9 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                box-shadow: 0 3px 4px rgba(0, 0, 0, 0.25);
            }

            .n01_header table {
                width: 100%;
                height: 75px;
                margin: 0;
                padding: 0;
                border-collapse: collapse;
                background-color: #D9D9D9 !important;
            }

            /* BODY */
            .n01_article {
                margin: 0 !important;
                padding: 25px 20px 20px 20px !important;
                box-sizing: border-box;
            }

            /* FOOTER */
            .n01_footer {
                height: 80px !important;
                width: 100%;
                margin: 0;
                padding: 0;
                background-color: #D9D9D9 !important;
                color: #555555;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .n01_footer table {
                width: 100%;
                height: 80px;
                margin: 0;
                padding: 0;
                border-collapse: collapse;
                table-layout: fixed;
                background-color: #D9D9D9 !important;
            }

            .n01_footer td {
                vertical-align: middle;
                padding: 7px 20px;
                font-size: 10px;
                line-height: 15px;
                color: #555555;
            }

            .n01_footer .n01_company_name,
            .n01_footer .n01_registered_title {
                color: #568D62;
                font-size: 12px;
                font-weight: bold;
            }

            .n01_footer .n01_company_number {
                font-size: 10px;
                white-space: nowrap;
            }

            .n01_footer .n01_registered_address {
                font-size: 10px;
                line-height: 15px;
            }
        </style>

        <!-- HEADER -->
        <div class="header n01_header">
            <table>
                <tbody>
                    <tr>
                        <td style="
                            text-align: right;
                            vertical-align: middle;
                            padding: 0 20px;
                        ">
                            <t t-if="company.logo_web">
                                <img
                                    t-att-src="image_data_uri(company.logo_web)"
                                    style="
                                        max-height: 55px;
                                        max-width: 150px;
                                        width: auto;
                                    "
                                />
                            </t>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- BODY -->
        <div class="article n01_article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">

            <t t-out="0"/>

        </div>

        <!-- FOOTER -->
        <div class="footer n01_footer">
            <table>
                <tbody>
                    <tr>
                        <!-- LEFT: COMPANY NAME AND IDENTIFICATION -->
                        <td style="width: 58%; text-align: left;">

                            <div class="n01_company_name">
                                <t t-esc="company.name or 'nZeroOne'"/>
                            </div>

                            <div class="n01_company_number">
                                Corporate identification Number:
                                <t t-esc="company.company_registry or 'ACN-6333'"/>
                            </div>

                        </td>

                        <!-- RIGHT: REGISTERED OFFICE -->
                        <td style="width: 42%; text-align: left;">

                            <div class="n01_registered_title">
                                Registered Office:
                            </div>

                            <div class="n01_registered_address">
                                <t t-if="company.street">
                                    <t t-esc="company.street"/>
                                </t>

                                <t t-if="company.street2">
                                    <t t-esc="company.street2"/>
                                </t>

                                <br/>

                                <t t-if="company.city">
                                    <t t-esc="company.city"/>
                                </t>

                                <t t-if="company.state_id">
                                    , <t t-esc="company.state_id.name"/>
                                </t>

                                <t t-if="company.zip">
                                    - <t t-esc="company.zip"/>
                                </t>

                                <t t-if="company.country_id">
                                    , <t t-esc="company.country_id.name"/>
                                </t>
                            </div>

                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </template>
</odoo>