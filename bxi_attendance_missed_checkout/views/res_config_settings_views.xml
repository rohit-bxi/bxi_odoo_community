<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_missed_checkout" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.missed.checkout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="Missed Check-out" name="missed_checkout_setting_container">
                    <setting string="Mark LWP on Missed Check-out" company_dependent="1"
                             help="If an employee does not check out on an office or home day, the attendance is closed. Without an approved attendance regularization by the 25th, a full-day LWP is applied.">
                        <field name="missed_checkout_lwp"/>
                        <div class="mt8" invisible="not missed_checkout_lwp">
                            <label for="missed_checkout_lwp_start_date" class="o_light_label"/>
                            <field name="missed_checkout_lwp_start_date" class="ms-2"/>
                        </div>
                        <div class="mt8" invisible="not missed_checkout_lwp">
                            <label for="attendance_regularization_start_date" class="o_light_label"/>
                            <field name="attendance_regularization_start_date" class="ms-2"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
