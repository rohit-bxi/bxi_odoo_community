<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_shipping_address" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.shipping.address</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_custom_po"
                    type="object"
                    string="Print PO"
                    class="btn-primary"
                    icon="fa-print"
                />
            </xpath>
            <xpath expr="//button[@name='print_quotation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='%(purchase.action_report_purchase_order)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='invoice_info']" position="after">
                <group string="Ship To" name="ship_to_address_group">
                    <field name="is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked"/>
                    <field name="shipping_street" string="Street 1" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked"/>
                    <field name="shipping_street2" string="Street 2" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked"/>
                    <field name="shipping_city" string="City" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked"/>
                    <field name="shipping_state_id" string="State" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked" options="{'no_open': True, 'no_create': True}"/>
                    <field name="shipping_zip" string="Zip" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked"/>
                    <field name="shipping_country_id" string="Country" invisible="not is_different_shipping_address" readonly="state in ('cancel', 'purchase') or locked" options="{'no_open': True, 'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
