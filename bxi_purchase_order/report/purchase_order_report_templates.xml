<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_shipping" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-if='o.dest_address_id']" position="replace">
            <t t-if="o.is_different_shipping_address">
                <t t-set="information_block">
                    <strong class="d-block mt-3">Shipping address</strong>
                    <div name="purchase_custom_shipping_address">
                        <t t-if="o.shipping_street"><span t-field="o.shipping_street"/><br/></t>
                        <t t-if="o.shipping_street2"><span t-field="o.shipping_street2"/><br/></t>
                        <t t-if="o.shipping_city"><span t-field="o.shipping_city"/><t t-if="o.shipping_state_id or o.shipping_zip">, </t></t>
                        <t t-if="o.shipping_state_id"><span t-field="o.shipping_state_id.name"/><t t-if="o.shipping_zip"> - </t></t>
                        <t t-if="o.shipping_zip"><span t-field="o.shipping_zip"/></t>
                        <t t-if="o.shipping_city or o.shipping_state_id or o.shipping_zip"><br/></t>
                        <t t-if="o.shipping_country_id"><span t-field="o.shipping_country_id.name"/></t>
                    </div>
                </t>
            </t>
            <t t-elif="o.dest_address_id">
                <t t-set="information_block">
                    <strong class="d-block mt-3">Shipping address</strong>
                    <div t-if="o.dest_address_id">
                        <div t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit_shipping" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//t[@t-if='o.dest_address_id']" position="replace">
            <t t-if="o.is_different_shipping_address">
                <t t-set="information_block">
                    <strong class="d-block mt-3">Shipping address</strong>
                    <div name="purchase_custom_shipping_address">
                        <t t-if="o.shipping_street"><span t-field="o.shipping_street"/><br/></t>
                        <t t-if="o.shipping_street2"><span t-field="o.shipping_street2"/><br/></t>
                        <t t-if="o.shipping_city"><span t-field="o.shipping_city"/><t t-if="o.shipping_state_id or o.shipping_zip">, </t></t>
                        <t t-if="o.shipping_state_id"><span t-field="o.shipping_state_id.name"/><t t-if="o.shipping_zip"> - </t></t>
                        <t t-if="o.shipping_zip"><span t-field="o.shipping_zip"/></t>
                        <t t-if="o.shipping_city or o.shipping_state_id or o.shipping_zip"><br/></t>
                        <t t-if="o.shipping_country_id"><span t-field="o.shipping_country_id.name"/></t>
                    </div>
                    <div>
                        <strong>Requested Ship Date:</strong>
                        <span t-field="o.date_planned" t-options="{'date_only': 'true'}"/>
                    </div>
                </t>
            </t>
            <t t-elif="o.dest_address_id">
                <t t-set="information_block">
                    <strong class="d-block mt-3">Shipping address</strong>
                    <div t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                    <div>
                        <strong>Requested Ship Date:</strong>
                        <span t-field="o.date_planned" t-options="{'date_only': 'true'}"/>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
