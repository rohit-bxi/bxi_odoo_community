<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aura_backend_theme_free.SettingsApp" t-inherit="web.SettingsApp" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('icon')]" position="attributes">
            <attribute name="t-att-src">this.getAppIconUrl()</attribute>
        </xpath>
    </t>
</templates>
