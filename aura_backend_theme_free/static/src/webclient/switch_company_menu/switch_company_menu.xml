<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="web.SwitchCompanyMenu" t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
    <xpath expr="//button[@data-hotkey='shift+u']" position="replace">
      <button data-hotkey="shift+u" t-att-disabled="isSingleCompany" t-att-title="user.activeCompany.name">
        <i class="fa fa-building"/>
        <span class="oe_topbar_name text-truncate" t-esc="user.activeCompany.name"/>
      </button>
    </xpath>
  </t>

</templates>
