<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_icici_otp_wizard_form" model="ir.ui.view">
        <field name="name">icici.otp.wizard.form</field>
        <field name="model">icici.otp.wizard</field>
        <field name="arch" type="xml">
            <form string="ICICI OTP Verification">
                <group>
                    <field name="otp" password="True" required="1" placeholder="Enter OTP received from ICICI" default_focus="1"/>
                    <field name="payment_date" required="1"/>
                </group>
                <footer>
                    <button
                        name="action_confirm_otp"
                        string="Verify OTP"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_icici_reverse_wizard_form" model="ir.ui.view">
        <field name="name">icici.reverse.wizard.form</field>
        <field name="model">icici.reverse.wizard</field>
        <field name="arch" type="xml">
            <form string="Reverse Payment">
                <group>
                    <field name="payslip_id" readonly="1"/>
                    <field name="file_seq_num" required="1" placeholder="Enter ICICI File Sequence Number"/>
                </group>
                <footer>
                    <button
                        name="action_reverse"
                        string="Reverse Payment"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>