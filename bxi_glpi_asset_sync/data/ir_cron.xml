<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Lists every enabled GLPI item type, refreshes changed items,
             flags purged ones, then pushes pending Odoo changes. -->
        <record id="ir_cron_glpi_sync" model="ir.cron">
            <field name="name">GLPI: Synchronise Assets</field>
            <field name="model_id" ref="model_glpi_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
