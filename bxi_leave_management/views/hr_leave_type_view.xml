<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_hr_leave_type_form_inherit_time_off_code" model="ir.ui.view">
        <field name="name">hr.leave.type.form.time.off.code</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='country_id']" position="after">
                <field name="time_off_code"/>
            </xpath>

        </field>
    </record>

    <!-- list View -->
    <record id="view_hr_leave_type_list_inherit_time_off_code" model="ir.ui.view">
        <field name="name">hr.leave.type.list.time.off.code</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <field name="time_off_code"/>
            </xpath>

        </field>
    </record>
    <record id="view_hr_leave_form_compensation" model="ir.ui.view">
        <field name="name">hr.leave.form.compensation</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='holiday_status_id']" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not compensation_required"
                >
                    <strong>Compensation Required</strong>
                    <br/>
                    You are applying Earned Leave on a mandatory WFO day.
                    You must compensate by working from office on Monday or
                    Friday of the same week.
                </div>
                <field
                    name="compensation_required"
                    invisible="1"
                />
                <field
                    name="compensation_date"
                    string="Compensation Date"
                    invisible="not compensation_required"
                    required="compensation_required"
                />
            </xpath> 
        </field>
    </record>

    <record id="view_hr_leave_form_hd_attendance" model="ir.ui.view">
        <field name="name">hr.leave.form.hd.attendance</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="is_hd_leave_type" invisible="1"/>
                <field name="is_hd_leave_origin" invisible="1"/>
                <field name="hd_attendance_hours" invisible="1"/>

                <div class="alert alert-info"
                    role="alert"
                    invisible="not is_hd_leave_type">
                    <strong>Half-Day Leave Policy</strong>
                    <p>
                        Half-Day Leave requires at least five completed
                        attendance hours according to your shift timmings 
                        on the selected date.
                    </p>
                    <p>
                        Only one Half-Day Leave request is allowed per
                        calendar month .
                    </p>
                </div>
            </xpath>
        </field>
    </record>
</odoo>